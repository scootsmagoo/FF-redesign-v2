{
  "name": "@ff/db",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, D1 migrations and legacy-import tooling for FiltersFast.com v2.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "check": "tsc --noEmit",
    "seed:build": "tsx seed/build-seed.ts",
    "seed:local": "pnpm seed:build && pnpm seed:apply",
    "migrate:local": "pnpm --filter @ff/storefront db:migrate:local",
    "seed:apply": "tsx seed/apply-local.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@types/node": "^22.19.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
