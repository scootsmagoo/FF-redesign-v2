{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "filtersfast-storefront",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  // Local dev uses Miniflare-backed emulations of every binding below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "filtersfast",
      "database_id": "85cbb6ac-86af-4a19-bdd9-d5f3d2eab40f",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "SESSION", "id": "66a6cf9dcfb74385ad62d72ecfd47d76" },
    { "binding": "CACHE", "id": "45131b196b504f25b3d9c07d94eff576" }
  ],
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "filtersfast-images" }
  ],
  "images": {
    "binding": "IMAGES_API"
  },
  "vars": {
    "SITE_URL": "https://filtersfast-storefront.adam-021.workers.dev",
    "FREE_SHIPPING_THRESHOLD": "99",
    "FREE_SHIPPING_THRESHOLD_VIP": "75",
    "PAYMENT_PROVIDER": "stub",
    "TAX_PROVIDER": "stub",
    "SHIPPING_PROVIDER": "stub",
    "EMAIL_PROVIDER": "console",
    "EMAIL_FROM": "no-reply@filtersfast.com",
    "EMAIL_FROM_NAME": "FiltersFast.com",
    // Optional SendGrid dynamic template ids (d-…). Blank = the inline HTML in packages/domain/src/emails.ts.
    // The legacy site used d-11f9635bc7e94ca28709ffec5e3aaaff (confirmation) and d-b2c00c8ba8724b5d99fb48367ddf77d5 (shipped).
    "SENDGRID_TEMPLATE_ORDER_CONFIRMATION": "",
    "SENDGRID_TEMPLATE_SHIPMENT": "",
    "SENDGRID_TEMPLATE_PASSWORD_RESET": "",
    "ADDRESS_PROVIDER": "passthrough"
  }
}
