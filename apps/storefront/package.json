    "@ff/integrations": "workspace:*",
    "astro": "^7.3.2",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
