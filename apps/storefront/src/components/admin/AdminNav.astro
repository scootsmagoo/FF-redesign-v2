---
interface Props {
  current: string;
}
const { current } = Astro.props;
const items = [
  ['/admin', 'Dashboard'],
  ['/admin/orders', 'Orders'],
  ['/admin/customers', 'Customers'],
  ['/admin/settings', 'Settings'],
];
const active = (href: string) => (href === '/admin' ? current === href : current.startsWith(href));
---

<nav aria-label="Admin" class="rounded-card border border-border p-2">
  <p class="px-3 py-2 text-xs font-bold uppercase tracking-wide text-ink/60">Back Office</p>
  <ul class="space-y-1">
    {items.map(([href, label]) => (
      <li>
        <a href={href} class:list={['block rounded-btn px-3 py-2 text-sm font-semibold hover:bg-brand-blue-tint hover:no-underline', active(href) ? 'bg-brand-blue text-white hover:bg-brand-blue hover:text-white' : 'text-ink-strong']} aria-current={active(href) ? 'page' : undefined}>{label}</a>
      </li>
    ))}
    <li class="border-t border-border pt-1">
      <a href="/account" class="block rounded-btn px-3 py-2 text-sm font-semibold text-ink/70 hover:bg-surface-alt hover:no-underline">My Account</a>
    </li>
    <li>
      <form method="POST" action="/account/logout">
        <button class="block w-full rounded-btn px-3 py-2 text-left text-sm font-semibold text-ink/70 hover:bg-surface-alt">Sign Out</button>
      </form>
    </li>
  </ul>
</nav>
