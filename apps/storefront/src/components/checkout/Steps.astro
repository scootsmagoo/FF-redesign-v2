---
interface Props {
  current: 1 | 2 | 3 | 4;
}
const { current } = Astro.props;
const steps = ['Shipping Info', 'Shipping Method', 'Review', 'Payment'];
---

<ol class="flex flex-wrap gap-2 text-sm" aria-label="Checkout progress">
  {steps.map((label, i) => {
    const n = i + 1;
    return (
      <li
        class:list={[
          'flex items-center gap-2 rounded-full px-3 py-1',
          n === current ? 'bg-brand-blue text-white' : n < current ? 'bg-brand-blue-tint text-brand-blue' : 'bg-surface-alt text-ink/60',
        ]}
        aria-current={n === current ? 'step' : undefined}
      >
        <span class="font-bold">{n}</span> {label}
      </li>
    );
  })}
</ol>
