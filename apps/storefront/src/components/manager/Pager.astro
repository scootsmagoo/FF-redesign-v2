---
/** Previous / next pagination for manager lists; keeps the other query-string filters. */
interface Props {
  page: number;
  total: number;
  pageSize: number;
  /** current URL; the page param is rewritten */
  url: URL;
  noun?: string;
}
const { page, total, pageSize, url, noun = 'row' } = Astro.props;
const pages = Math.max(1, Math.ceil(total / pageSize));
const link = (p: number) => {
  const u = new URL(url);
  u.searchParams.set('page', String(p));
  return u.pathname + u.search;
};
const from = total === 0 ? 0 : (page - 1) * pageSize + 1;
const to = Math.min(total, page * pageSize);
---

<nav class="mt-4 flex flex-wrap items-center gap-3 text-sm" aria-label="Pagination">
  <span class="text-ink/70">{total === 0 ? `No ${noun}s` : `${from.toLocaleString('en-US')}–${to.toLocaleString('en-US')} of ${total.toLocaleString('en-US')} ${noun}${total === 1 ? '' : 's'}`}</span>
  {pages > 1 && (
    <>
      {page > 1 ? <a href={link(page - 1)}>← Previous</a> : <span class="text-ink/40">← Previous</span>}
      <span>Page {page} of {pages}</span>
      {page < pages ? <a href={link(page + 1)}>Next →</a> : <span class="text-ink/40">Next →</span>}
    </>
  )}
</nav>
