---
import { AIR_FAQS, MERV_GUIDE } from '~/lib/air-category';

/** Air Filters category: light-blue band with the MERV guide and the FAQ accordion (legacy .faqs.brandPLPContent). */
---

<section id="faq-section" class="bg-[#dfe7f0] py-12" aria-labelledby="faq-heading">
  <div class="site-container grid max-w-5xl gap-8 md:grid-cols-[2fr_3fr] md:items-start">
    <img src={MERV_GUIDE.image} alt="Air filter diagram showing MERV rating guide and filter efficiency standards" width="689" height="857" class="w-full object-cover md:max-h-[875px]" loading="lazy" />
    <div>
      <h2 class="text-2xl font-bold text-brand-blue md:text-[28px]">{MERV_GUIDE.heading}</h2>
      <p class="mt-4">{MERV_GUIDE.intro}</p>
      {MERV_GUIDE.levels.map(([level, text]) => <p class="mt-3"><strong>{level}:</strong> {text}</p>)}
      <h2 id="faq-heading" class="mt-10 text-2xl font-bold text-brand-blue md:text-[28px]">Frequently Asked Questions</h2>
      <div class="mt-4 divide-y divide-ink/20">
        {AIR_FAQS.map((f) => (
          <details class="group py-2">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3 text-lg font-semibold text-black"><span>{f.q}</span><span class="text-2xl text-brand-blue transition group-open:rotate-45" aria-hidden="true">+</span></summary>
            <div class="prose pb-3" set:html={f.a} />
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
