---
import { getCategoryBySlug } from '~/lib/catalog';
import { legacyCat, searchFor } from '~/lib/legacy-links';
import { POOL_BRANDS, POOL_DE, POOL_HERO } from '~/lib/pool-category';
import { getPoolDimensionOptions, getPoolDimensionRows, POOL_DIMENSIONS } from '~/lib/pool-sizes';

/**
 * Pool & Spa category top (legacy .ff-ps-hero): grey band with "Find Your Pool Filter", the
 * three-tab finder (By Brand / Part Number / Dimensions; radio-driven CSS tabs, so no script
 * needed) and the D.E. filters banner. Dimension options come from the pool compare specs.
 */
interface Props {
  crumbs: { name: string; slug: string }[];
}
const { crumbs } = Astro.props;
const [options, rows, deCategory] = await Promise.all([getPoolDimensionOptions(), getPoolDimensionRows(), getCategoryBySlug(legacyCat(POOL_DE.legacy).slice(3))]);
const deHref = deCategory ? `/c/${deCategory.slug}` : searchFor('diatomaceous earth pool filter');
const hasDimensions = POOL_DIMENSIONS.some(([key]) => options[key].length > 0);
const tabs = [
  { id: 'brand', label: 'By Brand', icon: POOL_HERO.icons.brand },
  { id: 'part', label: 'Part Number', icon: POOL_HERO.icons.part },
  { id: 'dimensions', label: 'Dimensions', icon: POOL_HERO.icons.dimensions },
];
---

<div class="bg-surface-alt">
  <nav aria-label="Breadcrumb" class="site-container px-4 pb-5 pt-6 text-[13px] md:px-12">
    <ol class="flex flex-wrap gap-1">
      <li><a href="/" class="text-ink underline">Home</a></li>
      {crumbs.map((c, i) => <><li aria-hidden="true">&gt;</li>{i === crumbs.length - 1 ? <li aria-current="page" class="underline">{c.name === 'Pool & Spa Filters' ? 'Pool Filters' : c.name}</li> : <li><a href={`/c/${c.slug}`} class="text-ink underline">{c.name}</a></li>}</>)}
    </ol>
  </nav>

  <section class="mx-auto max-w-[980px] px-5 pb-10 text-center" aria-labelledby="pool-hero-heading" id="finder">
    <h1 id="pool-hero-heading" class="text-3xl font-semibold leading-tight text-brand-blue md:text-[40px] md:leading-[46px]">{POOL_HERO.heading}</h1>
    <p class="mt-4 text-base text-black">{POOL_HERO.sub}</p>

    <div class="pool-finder mt-8 rounded-2xl border border-[#d0d9e2] bg-surface text-left shadow-sm md:mt-10">
      {tabs.map((t, i) => <input type="radio" name="pool-finder-tab" id={`pool-tab-${t.id}`} class="sr-only" checked={i === 0} />)}
      <div class="grid grid-cols-3 rounded-t-2xl bg-[#eef3f6]" role="tablist">
        {tabs.map((t) => (
          <label for={`pool-tab-${t.id}`} class="pool-tab flex min-h-[68px] cursor-pointer flex-col items-center justify-center gap-1.5 border-b-[3px] border-[#d0d9e2] px-1 py-3 text-center text-xs font-semibold uppercase tracking-wide text-black first:rounded-tl-2xl last:rounded-tr-2xl md:min-h-[98px] md:px-7 md:py-4 md:text-sm" data-tab={t.id}>
            <img src={t.icon} alt="" width="22" height="22" class="h-[22px] w-[22px] object-contain" />
            {t.label}
          </label>
        ))}
      </div>
      <div class="px-4 py-6 md:px-8">
        <div class="pool-panel" data-panel="brand">
          <p class="flex items-center gap-2.5 text-[15px] font-semibold text-brand-blue"><img src={POOL_HERO.icons.step} alt="Step 1" width="26" height="26" class="w-[26px]" />Choose your pool equipment brand</p>
          <ul class="mt-6 grid grid-cols-2 gap-2.5 md:grid-cols-4 md:gap-3.5">
            {POOL_BRANDS.map((b) => <li><a href={b.href} class="flex h-[65px] items-center justify-center rounded-xl border border-[#c6d5e4] bg-surface px-4 py-2 hover:border-brand-blue hover:no-underline md:h-[69px]" title={`${b.name} pool and spa filters`}><img src={b.logo} alt={b.name} class="max-h-7 max-w-full object-contain md:max-h-[52px]" loading="lazy" /></a></li>)}
          </ul>
        </div>
        <div class="pool-panel" data-panel="part">
          <p class="flex items-center gap-2.5 text-[15px] font-semibold text-brand-blue"><img src={POOL_HERO.icons.step} alt="Step 1" width="26" height="26" class="w-[26px]" />Enter your filter's part number</p>
          <form action="/search" method="get" class="mt-6 grid gap-2.5 md:grid-cols-[1fr_96px] md:gap-4">
            <label for="pool-part" class="sr-only">Part number</label>
            <input id="pool-part" name="q" type="search" required placeholder="Part #" class="h-[42px] w-full rounded-lg border border-[#5c6c80] bg-surface px-4" />
            <button class="h-[42px] rounded-lg bg-[#f15b22] font-bold text-white hover:bg-brand-orange-dark">Search</button>
          </form>
          <div class="mt-4 flex items-start gap-3 rounded-lg border border-brand-blue bg-[#eef6ff] px-4 py-4 text-[13.6px] font-semibold leading-[22px] text-brand-blue md:pr-10">
            <img src={POOL_HERO.icons.info} alt="" width="18" height="18" class="mt-0.5 h-[18px] w-[18px]" />
            <div>{POOL_HERO.partHelp.title}<p class="mt-1.5 font-normal text-black">{POOL_HERO.partHelp.text}</p></div>
          </div>
        </div>
        <div class="pool-panel" data-panel="dimensions">
          <p class="flex items-center gap-2.5 text-[15px] font-semibold text-brand-blue"><img src={POOL_HERO.icons.step} alt="Step 1" width="26" height="26" class="w-[26px]" />Enter your filter's measurements</p>
          <div class="mt-6 flex items-start gap-3 rounded-lg border border-brand-blue bg-[#eef6ff] px-4 py-4 text-[13.6px] font-semibold leading-[22px] text-brand-blue md:pr-10">
            <img src={POOL_HERO.icons.info} alt="" width="18" height="18" class="mt-0.5 h-[18px] w-[18px]" />
            <div>{POOL_HERO.measureHelp.title}<p class="mt-1.5 font-normal text-black">{POOL_HERO.measureHelp.text}</p></div>
          </div>
          <form action="/pool-filters/find" method="get" class="mt-5" data-pool-finder>
              <div class="grid gap-4 md:grid-cols-2">
                {POOL_DIMENSIONS.map(([key, param, label, placeholder]) => (
                  <label class="block text-sm font-bold text-[#00549f] md:last:col-span-2">{label}
                    <select name={param} class="mt-2 h-[42px] w-full rounded-lg border border-[#5c6c80] bg-surface px-4 font-normal text-ink" disabled={options[key].length === 0}>
                      <option value="">{placeholder}</option>
                      {options[key].map((v) => <option value={v}>{v}</option>)}
                    </select>
                  </label>
                ))}
              </div>
              <button class="mx-auto mt-6 block h-12 w-[120px] rounded-lg bg-[#f15b22] font-bold text-white hover:bg-brand-orange-dark" disabled={!hasDimensions}>Search</button>
              <p class="sr-only" aria-live="polite" data-pool-status></p>
              <script type="application/json" data-pool-rows set:html={JSON.stringify(rows)} />
              {!hasDimensions && <p class="mt-4 text-center text-sm text-ink/70">Sizes are being added. In the meantime, search by part number or <a href="/support">ask our filter experts</a>.</p>}
            </form>
        </div>
      </div>
    </div>
  </section>
</div>

<section class="bg-brand-blue/15 px-4 py-5 md:px-7" aria-label="D.E. pool filters">
  <div class="mx-auto flex max-w-[708px] flex-col items-center gap-5 md:flex-row md:justify-between md:gap-8">
    <div class="flex items-center gap-4">
      <img src={POOL_HERO.icons.de} alt="" width="28" height="35" class="h-[35px] w-7 shrink-0" />
      <div>
        <h2 class="text-[17px] font-semibold leading-tight text-brand-blue">{POOL_DE.heading}</h2>
        <p class="mt-1 text-[13px] leading-5 text-black/80">{POOL_DE.text}</p>
      </div>
    </div>
    <a href={deHref} class="w-full rounded-[7px] bg-brand-orange px-6 py-3 text-center text-sm font-semibold text-white hover:bg-brand-orange-dark hover:no-underline md:w-auto">{POOL_DE.cta}</a>
  </div>
</section>

<script>
  // Dimension cascade (as on the live page): each choice narrows the other lists to values that
  // still co-occur with it, and a list left with a single value fills itself in. Search stays manual.
  document.querySelectorAll<HTMLFormElement>('form[data-pool-finder]').forEach((form) => {
    const rows: string[][] = JSON.parse(form.querySelector('[data-pool-rows]')?.textContent || '[]');
    const selects = [...form.querySelectorAll('select')] as unknown as HTMLSelectElement[];
    const status = form.querySelector<HTMLElement>('[data-pool-status]');
    if (!rows.length || !selects.length) return;
    const allOptions = selects.map((s) => [...s.options].slice(1).map((o) => o.value));
    const labelOf = (s: HTMLSelectElement) => (s.closest('label')?.firstChild?.textContent ?? s.name).trim();
    const rebuild = () => {
      // Auto-filled values are recomputed from scratch so an earlier change can undo them.
      selects.forEach((s) => { if (s.dataset.auto) { s.value = ''; delete s.dataset.auto; } });
      const filled: string[] = [];
      for (let pass = 0; pass < selects.length; pass++) {
        const chosen = selects.map((s) => s.value);
        const compatible = rows.filter((r) => chosen.every((c, i) => !c || r[i] === c));
        let changed = false;
        selects.forEach((s, i) => {
          const keep = s.value;
          const others = chosen.some((c, j) => c && j !== i);
          const allowed = new Set(compatible.map((r) => r[i]).filter(Boolean));
          const list = others ? allOptions[i]!.filter((v) => allowed.has(v) || v === keep) : allOptions[i]!;
          s.replaceChildren(s.options[0]!.cloneNode(true), ...list.map((v) => Object.assign(document.createElement('option'), { value: v, textContent: v })));
          s.value = list.includes(keep) ? keep : '';
          if (!s.value && others && list.length === 1) { s.value = list[0]!; s.dataset.auto = '1'; filled.push(`${labelOf(s)}: ${list[0]}`); changed = true; }
        });
        if (!changed) break;
      }
      if (status) status.textContent = filled.length ? `Filled in ${filled.join(', ')}.` : '';
    };
    selects.forEach((s) => s.addEventListener('change', () => { delete s.dataset.auto; rebuild(); }));
  });
</script>

<style>
  /* Radio-driven tabs: the checked radio lights its label and shows its panel. */
  .pool-panel { display: none; }
  .pool-finder:has(#pool-tab-brand:checked) [data-panel='brand'],
  .pool-finder:has(#pool-tab-part:checked) [data-panel='part'],
  .pool-finder:has(#pool-tab-dimensions:checked) [data-panel='dimensions'] { display: block; }
  .pool-finder:has(#pool-tab-brand:checked) [data-tab='brand'],
  .pool-finder:has(#pool-tab-part:checked) [data-tab='part'],
  .pool-finder:has(#pool-tab-dimensions:checked) [data-tab='dimensions'] { background: var(--color-surface); border-bottom-color: var(--color-brand-blue); color: var(--color-brand-blue); }
  .pool-finder input:focus-visible + * .pool-tab { outline: 2px solid var(--color-brand-blue); }
</style>
