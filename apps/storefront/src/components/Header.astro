---
import { Search, ShoppingCart, User, Menu } from 'lucide-react';
import { env } from 'cloudflare:workers';
import Nav from '~/components/Nav.astro';
import { getCartCount } from '~/lib/cart';

const freeShip = env.FREE_SHIPPING_THRESHOLD ?? '99';
const cartCount = await getCartCount(Astro.session);
---

<header class="relative z-50 border-b border-border bg-white">
  <!-- Mobile drawer toggle; Nav.astro's drawer is a later sibling and reacts via peer-checked. -->
  <input type="checkbox" id="mobile-nav" class="peer sr-only" aria-label="Toggle menu" />

  <div class="bg-promo-cyan px-4 py-1.5 text-center text-sm font-semibold text-white">
    <a href="/shipping-policy" class="text-white hover:text-white">FREE Shipping on orders over ${freeShip}</a>
    <span aria-hidden="true" class="mx-2">|</span>
    <a href="/returns" class="text-white hover:text-white">FREE 365-Day Returns</a>
  </div>

  <div class="site-container flex items-center gap-4 py-3">
    <label for="mobile-nav" class="-ml-2 cursor-pointer p-2 lg:hidden" aria-label="Open menu">
      <Menu size={26} />
    </label>
    <a href="/" class="shrink-0" aria-label="FiltersFast.com home">
      <img src="/brand/FF-shield-logo-Full.png" alt="FiltersFast.com. Filter. Purify. Protect." width="250" height="54" class="h-10 w-auto md:h-[54px]" />
    </a>

    <form action="/search" method="get" role="search" class="mx-auto hidden max-w-xl flex-1 md:flex">
      <label for="q" class="sr-only">Search by model, part number, size, or brand</label>
      <input
        id="q"
        name="q"
        type="search"
        placeholder="Search by model, part #, size, or brand"
        class="w-full rounded-l-btn border border-r-0 border-gray-300 px-4 py-2.5 text-base focus:border-brand-blue focus:outline-none"
        autocomplete="off"
      />
      <button type="submit" class="rounded-r-btn bg-brand-orange px-4 text-white hover:bg-brand-orange-dark" aria-label="Search">
        <Search size={20} />
      </button>
    </form>

    <nav class="ml-auto flex items-center gap-1 text-sm font-semibold md:gap-3" aria-label="Account">
      <a href="/account" class="flex items-center gap-1.5 p-2 text-ink-strong hover:text-brand-blue hover:no-underline">
        <User size={22} /><span class="hidden md:inline">{Astro.locals.user ? `Hi, ${Astro.locals.user.name.split(' ')[0] || 'there'}` : 'My Account'}</span>
      </a>
      <a href="/cart" class="flex items-center gap-1.5 p-2 text-ink-strong hover:text-brand-blue hover:no-underline">
        <ShoppingCart size={22} /><span class="hidden md:inline">Cart</span>
        {cartCount > 0 && <span class="rounded-full bg-brand-orange px-2 py-0.5 text-xs font-bold text-white">{cartCount}</span>}
      </a>
    </nav>
  </div>

  <form action="/search" method="get" role="search" class="site-container flex pb-3 md:hidden">
    <label for="q-m" class="sr-only">Search</label>
    <input id="q-m" name="q" type="search" placeholder="Search by model, part #, size, or brand" class="w-full rounded-l-btn border border-r-0 border-gray-300 px-4 py-2.5" />
    <button type="submit" class="rounded-r-btn bg-brand-orange px-4 text-white" aria-label="Search"><Search size={20} /></button>
  </form>

  <Nav />
</header>
