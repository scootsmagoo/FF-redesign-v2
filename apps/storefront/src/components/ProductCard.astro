---
import { formatMoney, savingsPercent } from '@ff/domain/pricing';
import type { ProductCard as Card } from '~/lib/catalog';

interface Props {
  product: Card;
}
const { product: p } = Astro.props;
const inStock = p.stock > 0 || p.ignoreStock;
const save = p.listPriceCents ? savingsPercent(p.listPriceCents, p.priceCents) : null;
---

<article class="flex h-full flex-col rounded-card border border-border bg-white p-4">
  <a href={`/p/${p.slug}`} class="block overflow-hidden rounded-media bg-surface-alt aspect-square">
    {p.thumbUrl ? (
      <img src={p.thumbUrl} alt={p.name} loading="lazy" width="300" height="300" class="h-full w-full object-contain mix-blend-multiply" />
    ) : (
      <div class="flex h-full items-center justify-center text-sm text-gray-400">No image</div>
    )}
  </a>
  <h3 class="mt-3 line-clamp-3 min-h-[3.4em] text-sm font-semibold leading-snug">
    <a href={`/p/${p.slug}`} class="text-ink-strong hover:text-brand-blue">{p.name}</a>
  </h3>
  <div class="mt-2 flex items-baseline gap-2">
    <span class="text-lg font-semibold text-ink-strong">{formatMoney(p.priceCents)}</span>
    {p.listPriceCents && p.listPriceCents > p.priceCents && (
      <del class="text-xs text-black/50">{formatMoney(p.listPriceCents)}</del>
    )}
    {save && <span class="text-xs font-semibold text-brand-orange">Save {save}%</span>}
  </div>
  {p.asLowAsCents && p.asLowAsCents < p.priceCents && (
    <p class="text-xs text-brand-blue">As low as {formatMoney(p.asLowAsCents)} in bulk</p>
  )}
  <p class:list={['mt-1 text-xs font-semibold', inStock ? 'text-success' : 'text-danger']}>
    {inStock ? 'In Stock' : 'Out of Stock'}
  </p>
  <div class="mt-auto pt-3">
    <a href={`/p/${p.slug}`} class="btn-primary w-full text-sm">View Options</a>
  </div>
</article>
