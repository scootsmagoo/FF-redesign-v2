---
import { actions } from 'astro:actions';
import { formatMoney } from '@ff/domain/pricing';
import type { getOrderForGuest } from '~/lib/account';

interface Props {
  detail: NonNullable<Awaited<ReturnType<typeof getOrderForGuest>>>;
}
const { detail } = Astro.props;
const { order, items, shipments } = detail;
const ship = JSON.parse(order.shippingAddress) as Record<string, string>;
const reorderable = items.filter((i) => i.productId);
const label: Record<string, string> = { pending: 'Pending', paid: 'Paid', processing: 'Processing', shipped: 'Shipped', complete: 'Complete', cancelled: 'Cancelled', refunded: 'Refunded' };
---

<div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px]">
  <section>
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="text-lg font-bold">Items</h2>
      <span class="rounded-full bg-brand-blue-tint px-3 py-1 text-xs font-semibold text-brand-blue">{label[order.status] ?? order.status}</span>
    </div>
    <ul class="mt-2 divide-y divide-border rounded-card border border-border">
      {items.map((i) => (
        <li class="flex items-center justify-between gap-3 p-3 text-sm">
          <span>
            {i.qty} × {i.name}{i.optionLabel ? ` (${i.optionLabel})` : ''}{i.subscriptionMonths ? ` · Home Filter Club every ${i.subscriptionMonths} mo` : ''}
            <br /><span class="text-xs text-ink/70">Part #: {i.sku}</span>
          </span>
          <span class="flex items-center gap-3">
            <span>{formatMoney(i.unitPriceCents * i.qty)}</span>
            {i.productId && (
              <form method="POST" action={actions.cart.add}>
                <input type="hidden" name="productId" value={i.productId} />
                <input type="hidden" name="qty" value={i.qty} />
                <button class="btn-secondary !min-h-8 !px-3 !py-1 text-xs">Add to Cart</button>
              </form>
            )}
          </span>
        </li>
      ))}
    </ul>
    {reorderable.length > 1 && (
      <form method="POST" action={actions.cart.reorder} class="mt-3">
        <input type="hidden" name="orderId" value={order.id} />
        <button class="btn-primary">Re-Order Everything</button>
      </form>
    )}
    {shipments.length > 0 && (
      <>
        <h2 class="mt-6 text-lg font-bold">Shipments</h2>
        <ul class="mt-2 space-y-1 text-sm">
          {shipments.map((s) => <li>{s.carrier ?? 'Carrier'} · <strong>{s.trackingNumber}</strong>{s.shippedAt ? ` · shipped ${s.shippedAt.slice(0, 10)}` : ''}</li>)}
        </ul>
      </>
    )}
    <h2 class="mt-6 text-lg font-bold">Shipping to</h2>
    <p class="mt-1 text-sm">{ship.firstName} {ship.lastName}<br />{ship.line1}{ship.line2 ? `, ${ship.line2}` : ''}<br />{ship.city}, {ship.region} {ship.postalCode}</p>
    <p class="mt-1 text-sm text-ink/70">{order.shippingMethod}</p>
  </section>

  <aside class="h-fit rounded-card border border-border bg-surface-alt p-5 text-sm">
    <p class="font-semibold">Order {order.number}</p>
    <p class="text-ink/70">{order.placedAt.slice(0, 10)}</p>
    <dl class="mt-3 space-y-1">
      <div class="flex justify-between"><dt>Subtotal</dt><dd>{formatMoney(order.subtotalCents)}</dd></div>
      {order.discountCents > 0 && <div class="flex justify-between text-success"><dt>Discounts</dt><dd>-{formatMoney(order.discountCents)}</dd></div>}
      <div class="flex justify-between"><dt>Shipping</dt><dd>{order.shippingCents === 0 ? 'FREE' : formatMoney(order.shippingCents)}</dd></div>
      <div class="flex justify-between"><dt>Tax</dt><dd>{formatMoney(order.taxCents)}</dd></div>
      {order.donationCents > 0 && <div class="flex justify-between"><dt>Donation</dt><dd>{formatMoney(order.donationCents)}</dd></div>}
      <div class="flex justify-between border-t border-border pt-2 text-base font-bold"><dt>Total</dt><dd>{formatMoney(order.totalCents)}</dd></div>
    </dl>
    <p class="mt-4 text-xs text-ink/70">Need help with this order? <a href="/returns">Start a return</a> or call (866) 438-3458.</p>
  </aside>
</div>
