---
import Base from './Base.astro';

/**
 * Shell for content pages (about, legal, programs, charities): optional hero band, then a
 * constrained column. Pass `wide` for pages that lay out their own sections.
 */
interface Props {
  title: string;
  description?: string;
  /** H1 shown in the hero; defaults to title */
  heading?: string;
  intro?: string;
  heroImage?: string;
  wide?: boolean;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}
const { title, description, heading = title, intro, heroImage, wide = false, noindex = false, jsonLd } = Astro.props;
---

<Base title={title} description={description} noindex={noindex} jsonLd={jsonLd}>
  <section class:list={['relative bg-brand-blue text-white', heroImage && 'bg-cover bg-center']} style={heroImage ? `background-image:url('${heroImage}')` : undefined}>
    {heroImage && <div class="absolute inset-0 bg-blue-navy/70" aria-hidden="true"></div>}
    <div class="site-container relative py-10 md:py-14">
      <h1 class="text-3xl font-bold text-white md:text-4xl">{heading}</h1>
      {intro && <p class="mt-3 max-w-2xl text-lg text-white/90">{intro}</p>}
      <slot name="hero" />
    </div>
  </section>
  <div class:list={['site-container py-10', !wide && 'max-w-3xl']}>
    <slot />
  </div>
</Base>
