---
import '~/styles/global.css';
import ManagerNav from '~/components/manager/ManagerNav.astro';
import { THEME_COOKIE } from '~/lib/manager/theme';

interface Props {
  title: string;
  /** current nav path; omit for the sign-in page (no chrome) */
  current?: string;
}
const { title, current } = Astro.props;
const admin = Astro.locals.admin;
/** 'light' | 'dark' when the user chose one; otherwise the OS preference is applied before first paint. */
const theme = Astro.cookies.get(THEME_COOKIE)?.value;
const dark = theme === 'dark';
const returnTo = Astro.url.pathname + Astro.url.search;
---

<!doctype html>
<html lang="en-US" class:list={['manager', dark && 'dark']}>
  <head>
    <script is:inline>
      // No saved choice: follow the OS setting, applied before the page paints so it never flashes light.
      if (!/(^|; )ff_manager_theme=/.test(document.cookie) && matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.classList.add('dark');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · FiltersFast.com Manager</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="48x48" />
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/gvz2sfa.css" />
  </head>
  <body class="min-h-screen bg-surface-alt">
    <header class="bg-blue-navy text-white">
      <div class="site-container flex items-center justify-between gap-4 py-3">
        <a href="/manager" class="flex items-center gap-3 text-white hover:text-white hover:no-underline">
          <img src="/brand/FF-shield-logo-WHITE.png" alt="FiltersFast.com" width="140" height="30" class="h-8 w-auto" />
          <span class="rounded-btn bg-white/15 px-2 py-0.5 text-xs font-bold uppercase tracking-wide">Manager</span>
        </a>
        <div class="flex items-center gap-3 text-sm">
          {admin && <span class="hidden sm:inline text-white/80">{admin.email}</span>}
          <form method="POST" action="/manager/theme" data-theme-toggle>
            <input type="hidden" name="returnTo" value={returnTo} />
            <input type="hidden" name="theme" value={dark ? 'light' : 'dark'} />
            <button class="flex h-7 w-7 items-center justify-center rounded-btn border border-white/40 hover:bg-white/10" aria-label="Switch between light and dark theme" title="Light / dark theme">
              <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
              <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            </button>
          </form>
          {admin && (
            <form method="POST" action="/manager/logout">
              <button class="rounded-btn border border-white/40 px-3 py-1 text-xs font-semibold hover:bg-white/10">Sign Out</button>
            </form>
          )}
        </div>
      </div>
    </header>
    <main class="site-container py-6">
      {current ? (
        <div class="grid gap-6 lg:grid-cols-[220px_1fr]">
          <ManagerNav current={current} />
          <div class="min-w-0 rounded-card border border-border bg-surface p-6"><slot /></div>
        </div>
      ) : (
        <slot />
      )}
    </main>
    <script>
      // Flip the theme in place and remember it; the form POST behind it is the no-JavaScript path.
      const toggle = document.querySelector<HTMLFormElement>('[data-theme-toggle]');
      toggle?.addEventListener('submit', (e) => {
        e.preventDefault();
        const dark = document.documentElement.classList.toggle('dark');
        document.cookie = `ff_manager_theme=${dark ? 'dark' : 'light'}; path=/manager; max-age=31536000; SameSite=Lax${location.protocol === 'https:' ? '; Secure' : ''}`;
        (toggle.elements.namedItem('theme') as HTMLInputElement).value = dark ? 'light' : 'dark';
      });
    </script>
    <footer class="site-container py-6 text-xs text-ink/50">Back office for staff only. Customer accounts sign in at <a href="/account/login">/account/login</a>.</footer>
  </body>
</html>
