---
import Base from '~/layouts/Base.astro';
import AccountNav from '~/components/account/AccountNav.astro';
import { formatMoney } from '@ff/domain/pricing';
import { getCustomer, listOrders } from '~/lib/account';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/account/login?next=/account', 302);
const customer = user.customerId ? await getCustomer(user.customerId) : null;
const recent = await listOrders(user.customerId ?? 0, user.email, 3);
---

<Base title="My Account" noindex>
  <div class="site-container grid gap-8 py-8 lg:grid-cols-[240px_1fr]">
    <AccountNav current="/account" />
    <div>
      <h1 class="text-2xl font-bold text-brand-blue">Hi{customer?.firstName ? `, ${customer.firstName}` : ''}!</h1>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <section class="rounded-card border border-border p-4">
          <h2 class="font-bold">Recent Orders</h2>
          {recent.length === 0 ? (
            <p class="mt-2 text-sm">No orders yet. <a href="/">Start shopping</a>.</p>
          ) : (
            <ul class="mt-2 divide-y divide-border text-sm">
              {recent.map((o) => (
                <li class="flex items-center justify-between py-2">
                  <a href={`/account/orders/${encodeURIComponent(o.number)}`}>{o.number}</a>
                  <span class="text-ink/70">{o.placedAt.slice(0, 10)}</span>
                  <span>{formatMoney(o.totalCents)}</span>
                </li>
              ))}
            </ul>
          )}
          <a href="/account/orders" class="mt-3 inline-block text-sm">View all orders</a>
        </section>
        <section class="rounded-card border border-border bg-brand-blue-tint p-4">
          <h2 class="font-bold text-brand-blue">Reorder in seconds</h2>
          <p class="mt-2 text-sm">Open a past order and add the same filters to your cart.</p>
          <a href="/account/orders" class="btn-primary mt-3">Re-Order Now</a>
        </section>
        <section class="rounded-card border border-border p-4">
          <h2 class="font-bold">Home Filter Club</h2>
          <p class="mt-2 text-sm">Manage delivery frequency, skip a shipment, or update payment.</p>
          <a href="/account/subscriptions" class="mt-3 inline-block text-sm">Manage subscriptions</a>
        </section>
        <section class="rounded-card border border-border p-4">
          <h2 class="font-bold">Account Details</h2>
          <p class="mt-2 text-sm">{user.email}</p>
          <a href="/account/settings" class="mt-3 inline-block text-sm">Update details or password</a>
        </section>
      </div>
    </div>
  </div>
</Base>
