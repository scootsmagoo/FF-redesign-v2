---
import Base from '~/layouts/Base.astro';
import AccountNav from '~/components/account/AccountNav.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/account/login?next=/account/subscriptions', 302);
---

<Base title="Home Filter Club" noindex>
  <div class="site-container grid gap-8 py-8 lg:grid-cols-[240px_1fr]">
    <AccountNav current="/account/subscriptions" />
    <div>
      <h1 class="text-2xl font-bold text-brand-blue">Home Filter Club</h1>
      <p class="mt-3 max-w-2xl">Your subscription manager is being connected. Until then, manage deliveries, skip a shipment or update payment through the current site's <a href="https://www.filtersfast.com/MyAutoDelivery.asp">subscription page</a>, or call (866) 438-3458.</p>
      <p class="mt-3 text-sm text-ink/70">Home Filter Club orders placed here are stored with their delivery frequency and will appear in this list once the subscription service is linked.</p>
    </div>
  </div>
</Base>
