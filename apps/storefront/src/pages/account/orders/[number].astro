---
import { actions } from 'astro:actions';
import Base from '~/layouts/Base.astro';
import AccountNav from '~/components/account/AccountNav.astro';
import OrderDetail from '~/components/account/OrderDetail.astro';
import { getOrderForCustomer } from '~/lib/account';

const user = Astro.locals.user;
const number = Astro.params.number ?? '';
if (!user) return Astro.redirect(`/account/login?next=${encodeURIComponent(`/account/orders/${number}`)}`, 302);

const reorder = Astro.getActionResult(actions.cart.reorder) ?? Astro.getActionResult(actions.cart.add);
if (reorder && !reorder.error) return Astro.redirect('/cart', 303);

const detail = await getOrderForCustomer(number, user.customerId ?? 0, user.email);
if (!detail) return new Response(null, { status: 404 });
---

<Base title={`Order ${detail.order.number}`} noindex>
  <div class="site-container grid gap-8 py-8 lg:grid-cols-[240px_1fr]">
    <AccountNav current="/account/orders" />
    <div>
      <a href="/account/orders" class="text-sm">← Order History</a>
      <h1 class="mt-1 text-2xl font-bold text-brand-blue">Order {detail.order.number}</h1>
      {reorder?.error && <p class="mt-3 rounded-btn bg-red-50 p-3 text-sm text-danger">{reorder.error.message}</p>}
      <div class="mt-4"><OrderDetail detail={detail} /></div>
    </div>
  </div>
</Base>
