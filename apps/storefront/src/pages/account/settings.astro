---
import { actions } from 'astro:actions';
import Base from '~/layouts/Base.astro';
import AccountNav from '~/components/account/AccountNav.astro';
import { getCustomer } from '~/lib/account';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/account/login?next=/account/settings', 302);
const profile = Astro.getActionResult(actions.account.updateProfile);
const pw = Astro.getActionResult(actions.account.changePassword);
const customer = user.customerId ? await getCustomer(user.customerId) : null;
---

<Base title="Account Details" noindex>
  <div class="site-container grid gap-8 py-8 lg:grid-cols-[240px_1fr]">
    <AccountNav current="/account/settings" />
    <div class="space-y-8">
      <section>
        <h1 class="text-2xl font-bold text-brand-blue">Account Details</h1>
        {profile?.data && <p class="mt-3 rounded-btn bg-brand-blue-tint p-3 text-sm">Details saved.</p>}
        {profile?.error && <p class="mt-3 rounded-btn bg-red-50 p-3 text-sm text-danger">{profile.error.message}</p>}
        <form method="POST" action={actions.account.updateProfile} class="mt-4 max-w-lg space-y-3">
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="block text-sm">First name<input name="firstName" value={customer?.firstName ?? ''} class="mt-1 w-full rounded-btn border border-gray-300 px-3 py-2" /></label>
            <label class="block text-sm">Last name<input name="lastName" value={customer?.lastName ?? ''} class="mt-1 w-full rounded-btn border border-gray-300 px-3 py-2" /></label>
          </div>
          <label class="block text-sm">Phone<input name="phone" type="tel" value={customer?.phone ?? ''} class="mt-1 w-full rounded-btn border border-gray-300 px-3 py-2" /></label>
          <p class="text-sm">Email: <strong>{user.email}</strong></p>
          <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="newsletter" value="true" checked={customer?.newsletter ?? false} /> Email me deals and filter-change reminders</label>
          <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="smsOptIn" value="true" checked={customer?.smsOptIn ?? false} /> Text me order updates</label>
          <button class="btn-primary">Save Details</button>
        </form>
      </section>
      <section>
        <h2 class="text-xl font-bold">Change Password</h2>
        {pw?.data && <p class="mt-3 rounded-btn bg-brand-blue-tint p-3 text-sm">Password updated.</p>}
        {pw?.error && <p class="mt-3 rounded-btn bg-red-50 p-3 text-sm text-danger">{pw.error.message}</p>}
        <form method="POST" action={actions.account.changePassword} class="mt-4 max-w-lg space-y-3">
          <label class="block text-sm">Current password<input name="currentPassword" type="password" autocomplete="current-password" required class="mt-1 w-full rounded-btn border border-gray-300 px-3 py-2" /></label>
          <label class="block text-sm">New password<input name="newPassword" type="password" autocomplete="new-password" required minlength="7" class="mt-1 w-full rounded-btn border border-gray-300 px-3 py-2" /></label>
          <button class="btn-secondary">Update Password</button>
        </form>
      </section>
    </div>
  </div>
</Base>
