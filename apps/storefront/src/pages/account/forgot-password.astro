---
import Base from '~/layouts/Base.astro';
import { getAuth } from '~/lib/auth';

let sent = false;
let email = Astro.url.searchParams.get('email') ?? '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim().toLowerCase();
  try {
    await getAuth().api.requestPasswordReset({ body: { email, redirectTo: '/account/reset-password' }, headers: Astro.request.headers });
  } catch {
    /* never reveal whether the address exists */
  }
  sent = true;
}
---

<Base title="Reset Your Password" noindex>
  <div class="site-container max-w-lg py-10">
    <h1 class="text-2xl font-bold text-brand-blue">Reset Your Password</h1>
    {sent ? (
      <p class="mt-4 rounded-btn bg-brand-blue-tint p-4">If an account exists for <strong>{email}</strong>, a reset link is on its way. It expires in one hour.</p>
    ) : (
      <form method="POST" class="mt-4 space-y-3">
        <p class="text-sm">Enter your email address and we'll send you a link to choose a new password.</p>
        <label class="block text-sm">Email address
          <input name="email" type="email" value={email} autocomplete="email" required class="mt-1 w-full rounded-btn border border-gray-300 px-3 py-2" />
        </label>
        <button class="btn-primary">Send Reset Link</button>
      </form>
    )}
    <p class="mt-6 text-sm"><a href="/account/login">Back to sign in</a></p>
  </div>
</Base>
