---
import Base from '~/layouts/Base.astro';
import { getAuth } from '~/lib/auth';

const token = Astro.url.searchParams.get('token') ?? '';
const invalid = Astro.url.searchParams.get('error') === 'INVALID_TOKEN';
let error: string | undefined;
let done = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  const confirm = String(form.get('confirm') ?? '');
  const t = String(form.get('token') ?? '');
  if (password.length < 7) error = 'Password must be at least 7 characters.';
  else if (password !== confirm) error = 'Passwords do not match.';
  else {
    try {
      await getAuth().api.resetPassword({ body: { newPassword: password, token: t }, headers: Astro.request.headers });
      done = true;
    } catch {
      error = 'This reset link is invalid or has expired. Request a new one below.';
    }
  }
}
---

<Base title="Choose a New Password" noindex>
  <div class="site-container max-w-lg py-10">
    <h1 class="text-2xl font-bold text-brand-blue">Choose a New Password</h1>
    {done ? (
      <p class="mt-4 rounded-btn bg-brand-blue-tint p-4">Your password has been updated. <a href="/account/login">Sign in</a>.</p>
    ) : (
      <>
        {(error || invalid) && <p class="mt-3 rounded-btn bg-red-50 p-3 text-sm text-danger">{error ?? 'This reset link is invalid or has expired.'} <a href="/account/forgot-password">Request a new link</a>.</p>}
        {token && (
          <form method="POST" class="mt-4 space-y-3">
            <input type="hidden" name="token" value={token} />
            <label class="block text-sm">New password <span class="text-ink/60">(7+ characters)</span>
              <input name="password" type="password" autocomplete="new-password" required minlength="7" class="mt-1 w-full rounded-btn border border-gray-300 px-3 py-2" />
            </label>
            <label class="block text-sm">Confirm password
              <input name="confirm" type="password" autocomplete="new-password" required minlength="7" class="mt-1 w-full rounded-btn border border-gray-300 px-3 py-2" />
            </label>
            <button class="btn-primary">Save Password</button>
          </form>
        )}
      </>
    )}
  </div>
</Base>
