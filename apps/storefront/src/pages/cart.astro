---
import { actions } from 'astro:actions';
import Base from '~/layouts/Base.astro';
import { formatMoney } from '@ff/domain/pricing';
import { getCartView } from '~/lib/cart';

const addResult = Astro.getActionResult(actions.cart.add);
const promoResult = Astro.getActionResult(actions.cart.applyPromo);
const errorMessage = addResult?.error?.message ?? promoResult?.error?.message;
const promoNotice = promoResult?.data?.message ?? (Astro.url.searchParams.get('promo') === 'invalid' ? `Code "${Astro.url.searchParams.get('code')}" is not valid.` : undefined);

const { lines, totals, promo } = await getCartView(Astro.session);
const freq = [1, 2, 3, 4, 6, 12];
---

<Base title="Your Cart" noindex>
  <div class="site-container py-6">
    <h1 class="text-2xl font-bold text-brand-blue">{totals.itemCount} {totals.itemCount === 1 ? 'Item' : 'Items'} in your Cart</h1>
    {errorMessage && <p class="mt-3 rounded-btn bg-red-50 p-3 text-danger">{errorMessage}</p>}
    {promoNotice && !errorMessage && <p class="mt-3 rounded-btn bg-brand-blue-tint p-3 text-brand-blue">{promoNotice}</p>}

    {lines.length === 0 ? (
      <div class="mt-8">
        <p>Your cart is empty.</p>
        {promo.codes.length > 0 && <p class="mt-2 text-sm text-brand-blue">Code {promo.codes.join(', ')} is saved and will apply once you add eligible items.</p>}
        <a href="/" class="btn-primary mt-4">Continue Shopping</a>
      </div>
    ) : (
      <div class="mt-6 grid min-w-0 gap-8 lg:grid-cols-[minmax(0,1fr)_360px]">
        <ul class="min-w-0 divide-y divide-border rounded-card border border-border">
          {totals.lines.map((l) => {
            const row = lines.find((x) => x.id === l.id)!;
            return (
              <li class="flex gap-3 p-4 sm:gap-4">
                <a href={`/p/${row.slug}`} class="block h-20 w-20 shrink-0 overflow-hidden rounded-media bg-surface-alt sm:h-24 sm:w-24">
                  {row.thumbUrl && <img src={row.thumbUrl} alt="" width="96" height="96" class="h-full w-full object-contain mix-blend-multiply" />}
                </a>
                <div class="min-w-0 flex-1">
                  <div class="flex items-start justify-between gap-3">
                    <a href={`/p/${row.slug}`} class="min-w-0 font-semibold break-words text-ink-strong">{l.name}</a>
                    <div class="shrink-0 text-right">
                      <div class="font-semibold text-ink-strong">{formatMoney(l.effectiveUnitCents * l.qty)}</div>
                      {l.lineDiscountCents > 0 && <div class="text-xs text-ink/60"><del>{formatMoney(l.lineSubtotalCents)}</del></div>}
                      <div class="text-xs text-ink/70">{formatMoney(l.effectiveUnitCents)} each</div>
                    </div>
                  </div>
                  <p class="text-xs text-ink/70">Part #: {l.sku}{l.optionLabel && <span> · {l.optionLabel}</span>}</p>
                  {l.baseUnitCents && l.baseUnitCents > l.unitPriceCents && (
                    <p class="text-xs font-semibold text-brand-orange">Bulk price: {formatMoney(l.unitPriceCents)} ea. (was {formatMoney(l.baseUnitCents)})</p>
                  )}

                  <div class="mt-2 flex flex-wrap items-center gap-3 text-sm">
                    <form method="POST" action={actions.cart.updateQty} class="flex items-center gap-2">
                      <input type="hidden" name="itemId" value={l.id} />
                      <label class="flex items-center gap-1">
                        Qty
                        <input type="number" name="qty" value={l.qty} min="0" max="99" class="w-16 rounded-btn border border-gray-300 px-2 py-1" />
                      </label>
                      <button class="btn-secondary !min-h-8 !px-3 !py-1 text-xs">Update</button>
                    </form>
                    <form method="POST" action={actions.cart.remove}>
                      <input type="hidden" name="itemId" value={l.id} />
                      <button class="text-xs text-ink/70 underline">Remove</button>
                    </form>
                  </div>

                  <form method="POST" action={actions.cart.setSubscription} class="mt-2 flex min-w-0 flex-col gap-1.5 text-sm sm:flex-row sm:flex-wrap sm:items-center sm:gap-2">
                    <input type="hidden" name="itemId" value={l.id} />
                    <label class="flex min-w-0 flex-col gap-1 sm:flex-row sm:items-center sm:gap-2">
                      <span class="font-semibold text-brand-blue">Subscribe + Save</span>
                      <select name="months" class="w-full min-w-0 max-w-full rounded-btn border border-gray-300 px-2 py-1 sm:w-auto" onchange="this.form.requestSubmit()">
                        <option value="0" selected={!l.subscriptionMonths}>One-time purchase</option>
                        {freq.map((m) => (
                          <option value={m} selected={l.subscriptionMonths === m}>Every {m} {m === 1 ? 'month' : 'months'}</option>
                        ))}
                      </select>
                    </label>
                    <noscript><button class="text-xs underline">Apply</button></noscript>
                    {l.subscriptionMonths && <span class="text-xs text-success">Saving {l.subscriptionDiscountPercent}% + FREE shipping</span>}
                  </form>
                </div>
              </li>
            );
          })}
        </ul>

        <aside class="h-fit min-w-0 rounded-card border border-border bg-surface-alt p-5">
          <h2 class="text-lg font-bold">Order Summary</h2>
          <dl class="mt-3 space-y-2 text-sm">
            <div class="flex justify-between"><dt>Subtotal</dt><dd>{formatMoney(totals.subtotalCents)}</dd></div>
            {totals.discountCents - totals.promoDiscountCents > 0 && (
              <div class="flex justify-between text-success"><dt>Subscribe + Save</dt><dd>-{formatMoney(totals.discountCents - totals.promoDiscountCents)}</dd></div>
            )}
            {promo.applied.map((a) => (
              <div class="flex justify-between text-success">
                <dt>{a.label} <span class="text-xs text-ink/60">({a.code})</span></dt>
                <dd>{a.discountCents > 0 ? `-${formatMoney(a.discountCents)}` : 'FREE shipping'}</dd>
              </div>
            ))}
            <div class="flex justify-between">
              <dt>Shipping</dt>
              <dd class:list={[totals.freeShippingEligible && 'font-semibold text-success']}>
                {totals.freeShippingEligible ? 'FREE' : 'Calculated at checkout'}
              </dd>
            </div>
            <div class="flex justify-between border-t border-border pt-2 text-base font-bold">
              <dt>Estimated Total</dt><dd>{formatMoney(totals.totalCents)}</dd>
            </div>
          </dl>
          {!totals.freeShippingEligible && totals.freeShippingGapCents > 0 && (
            <p class="mt-3 text-sm text-brand-blue">Add {formatMoney(totals.freeShippingGapCents)} more for FREE economy shipping.</p>
          )}

          <form method="POST" action={actions.cart.applyPromo} class="mt-4">
            <label for="promo" class="block text-sm font-semibold">Promo code</label>
            <div class="mt-1 flex min-w-0">
              <input id="promo" name="code" maxlength="40" class="min-w-0 w-full rounded-l-btn border border-r-0 border-gray-300 px-3 py-2 text-sm uppercase" placeholder="Enter code" autocomplete="off" />
              <button class="shrink-0 rounded-r-btn bg-brand-blue px-4 text-sm font-semibold text-white hover:bg-brand-blue-dark">Apply</button>
            </div>
          </form>
          {promo.codes.length > 0 && (
            <ul class="mt-2 space-y-1 text-xs">
              {promo.codes.map((code) => {
                const hit = promo.applied.find((a) => a.code === code);
                const miss = promo.rejected.find((r) => r.code === code);
                return (
                  <li class="flex items-start justify-between gap-2">
                    <span class:list={[hit ? 'text-success' : 'text-ink/70']}>
                      <strong>{code}</strong>{hit ? ` — ${hit.label}` : miss ? ` — ${miss.message}` : ''}
                    </span>
                    <form method="POST" action={actions.cart.removePromo}>
                      <input type="hidden" name="code" value={code} />
                      <button class="underline" aria-label={`Remove code ${code}`}>remove</button>
                    </form>
                  </li>
                );
              })}
            </ul>
          )}
          <form method="get" action="/checkout" class="mt-4">
            <button class="btn-primary w-full text-lg">Checkout</button>
          </form>
          <p class="mt-3 text-center text-xs text-ink/70">FREE 365-Day Returns · Secure Checkout</p>
        </aside>
      </div>
    )}
  </div>
</Base>
