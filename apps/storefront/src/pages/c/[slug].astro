---
import Base from '~/layouts/Base.astro';
import ProductCard from '~/components/ProductCard.astro';
import SubcategoryNav from '~/components/SubcategoryNav.astro';
import AirFiltersHero from '~/components/category/AirFiltersHero.astro';
import AirFiltersFaq from '~/components/category/AirFiltersFaq.astro';
import { AIR_CATEGORY_SLUG, AIR_FAQS } from '~/lib/air-category';
import FridgeHero from '~/components/category/FridgeHero.astro';
import FridgeBrands from '~/components/category/FridgeBrands.astro';
import FridgeFaq from '~/components/category/FridgeFaq.astro';
import { FRIDGE_CATEGORY_SLUG, FRIDGE_FAQS } from '~/lib/fridge-category';
import PoolHero from '~/components/category/PoolHero.astro';
import PoolContent from '~/components/category/PoolContent.astro';
import { POOL_CATEGORY_SLUG, POOL_FAQS } from '~/lib/pool-category';
import { getCategoryAncestors, getCategoryBySlug, getCategoryChildren, getCategoryProducts } from '~/lib/catalog';
import { listFaqs } from '~/lib/support';

const { slug } = Astro.params;
const category = slug ? await getCategoryBySlug(slug) : undefined;
if (!category) return new Response(null, { status: 404 });

const page = Math.max(1, Number(Astro.url.searchParams.get('page') ?? '1') || 1);
const [{ rows, total, pageSize }, children, ancestors, faqList] = await Promise.all([
  getCategoryProducts(category.id, page),
  getCategoryChildren(category.id),
  getCategoryAncestors(category),
  listFaqs('category', category.id),
]);
const pages = Math.max(1, Math.ceil(total / pageSize));
if (page > pages) return Astro.redirect(`/c/${category.slug}`, 302);

const heading = category.h1 || category.name;
// Category templates with their own editorial layout (legacy per-category ASP includes).
const template = category.slug === AIR_CATEGORY_SLUG ? 'air' : category.slug === FRIDGE_CATEGORY_SLUG ? 'fridge' : category.slug === POOL_CATEGORY_SLUG ? 'pool' : null;
// The air page's hard-coded FAQ comes first; category FAQs from the Manager follow it.
const editorialFaqs = template === 'air' ? AIR_FAQS : template === 'fridge' ? FRIDGE_FAQS : template === 'pool' ? POOL_FAQS : [];
const pageFaqs = editorialFaqs.length ? [...editorialFaqs.map((f) => ({ question: f.q, answerHtml: f.a })), ...faqList.filter((f) => !editorialFaqs.some((a) => a.q === f.question))] : faqList;
const canonical = new URL(`/c/${category.slug}${page > 1 ? `?page=${page}` : ''}`, Astro.site).toString();
const crumbs = [...ancestors, { id: category.id, name: category.name, slug: category.slug }];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.filtersfast.com/' },
      ...crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 2, name: c.name, item: `https://www.filtersfast.com/c/${c.slug}` })),
    ],
  },
  ...(pageFaqs.length
    ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: pageFaqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answerHtml.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() } })) }]
    : []),
];
---

<Base title={category.metaTitle ?? heading} description={category.metaDescription ?? undefined} canonical={canonical} jsonLd={jsonLd}>
  {!template && (
    <nav aria-label="Breadcrumb" class="site-container py-3 text-sm">
      <ol class="flex flex-wrap gap-2 text-ink">
        <li><a href="/" class="text-ink">Home</a></li>
        {crumbs.map((c, i) => (
          <>
            <li aria-hidden="true">/</li>
            {i === crumbs.length - 1 ? <li aria-current="page">{c.name}</li> : <li><a href={`/c/${c.slug}`} class="text-ink">{c.name}</a></li>}
          </>
        ))}
      </ol>
    </nav>
  )}

  {template === 'pool' && <PoolHero crumbs={crumbs} />}

  {template === 'fridge' && (
    <>
      <FridgeHero />
      <FridgeBrands children={children} />
    </>
  )}

  {template === 'air' && (
    <>
      <AirFiltersHero />
      <!-- Legacy air page: breadcrumb sits under the brand logos, over a thick grey rule -->
      <nav aria-label="Breadcrumb" class="site-container mt-10">
        <ol class="flex flex-wrap gap-2 text-base text-ink">
          <li><a href="/" class="text-ink">Home</a></li>
          {crumbs.map((c, i) => (
            <>
              <li aria-hidden="true">&gt;</li>
              {i === crumbs.length - 1 ? <li aria-current="page">{c.name}</li> : <li><a href={`/c/${c.slug}`} class="text-ink">{c.name}</a></li>}
            </>
          ))}
        </ol>
        <div class="mt-4 h-2 bg-[#ebebeb]" aria-hidden="true"></div>
      </nav>
    </>
  )}

  {template !== 'fridge' && (
  <div class="site-container">
    {!template && (
      <>
        <h1 class="text-3xl font-semibold text-brand-blue">{heading}</h1>
        {category.shortHtml && category.shortHtml !== category.name && <p class="mt-2 text-ink" set:html={category.shortHtml} />}
        <SubcategoryNav parentName={category.name} children={children} />
      </>
    )}

    {template === 'air' ? (
      <h2 class="mt-12 text-center text-2xl font-semibold text-brand-blue md:text-[32px]">{category.name} Product List: <span class="text-base font-normal text-ink/60">({total} products)</span></h2>
    ) : template === 'pool' ? (
      <h2 class="my-10 text-center text-2xl font-semibold text-brand-blue md:text-[32px]">Popular Pool Filters</h2>
    ) : (
      <div class="mt-8 flex items-baseline justify-between">
        <h2 class="text-lg font-bold">{children.length > 0 ? `All ${category.name}` : 'Products'}</h2>
        <p class="text-sm text-ink">{total} products</p>
      </div>
    )}

    {rows.length === 0 ? (
      <p class="mt-8">No products in this category yet.</p>
    ) : (
      <ul class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-6 lg:grid-cols-4">
        {rows.map((p) => (
          <li><ProductCard product={p} /></li>
        ))}
      </ul>
    )}

    {pages > 1 && template === 'pool' && (
      <nav aria-label="Pagination" class="mt-11 bg-[#eeeeee] py-3 text-center text-sm text-ink">
        Page {Array.from({ length: pages }, (_, i) => i + 1).map((n) => n === page ? <span class="mx-1 font-bold">{n}</span> : <a href={`/c/${category.slug}${n > 1 ? `?page=${n}` : ''}`} class="mx-1 font-bold">{n}</a>)}
        <span class="ml-2">[ {page > 1 ? <a href={`/c/${category.slug}${page > 2 ? `?page=${page - 1}` : ''}`} class="font-bold">Back</a> : 'Back'} | {page < pages ? <a href={`/c/${category.slug}?page=${page + 1}`} class="font-bold">Next</a> : 'Next'} ]</span>
      </nav>
    )}
    {pages > 1 && template !== 'pool' && (
      <nav aria-label="Pagination" class="mt-10 flex items-center justify-center gap-3 text-sm">
        {page > 1 && <a href={`/c/${category.slug}${page > 2 ? `?page=${page - 1}` : ''}`} class="btn-secondary">Previous</a>}
        <span>Page {page} of {pages}</span>
        {page < pages && <a href={`/c/${category.slug}?page=${page + 1}`} class="btn-secondary">Next</a>}
      </nav>
    )}

    {category.descriptionHtml && template !== 'pool' && (
      <section class="prose mt-12 max-w-none border-t border-border pt-8" set:html={category.descriptionHtml} />
    )}

    {!template && faqList.length > 0 && (
      <section id="faq" class="mt-12 border-t border-border pt-8">
        <h2 class="text-xl font-bold text-brand-blue">Frequently Asked Questions</h2>
        <div class="mt-4 divide-y divide-border rounded-card border border-border">
          {faqList.map((f) => (
            <details class="p-4">
              <summary class="cursor-pointer list-none font-semibold text-ink-strong">{f.question}</summary>
              <div class="prose mt-2 text-sm" set:html={f.answerHtml} />
            </details>
          ))}
        </div>
      </section>
    )}
  </div>
  )}
  {template === 'air' && <div class="mt-12"><AirFiltersFaq /></div>}
  {template === 'fridge' && <FridgeFaq />}
  {template === 'pool' && <div class="mt-[60px]"><PoolContent /></div>}
</Base>
