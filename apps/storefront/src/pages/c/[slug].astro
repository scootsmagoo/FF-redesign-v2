---
import Base from '~/layouts/Base.astro';
import ProductCard from '~/components/ProductCard.astro';
import SubcategoryNav from '~/components/SubcategoryNav.astro';
import { getCategoryAncestors, getCategoryBySlug, getCategoryChildren, getCategoryProducts } from '~/lib/catalog';
import { listFaqs } from '~/lib/support';

const { slug } = Astro.params;
const category = slug ? await getCategoryBySlug(slug) : undefined;
if (!category) return new Response(null, { status: 404 });

const page = Math.max(1, Number(Astro.url.searchParams.get('page') ?? '1') || 1);
const [{ rows, total, pageSize }, children, ancestors, faqList] = await Promise.all([
  getCategoryProducts(category.id, page),
  getCategoryChildren(category.id),
  getCategoryAncestors(category),
  listFaqs('category', category.id),
]);
const pages = Math.max(1, Math.ceil(total / pageSize));
if (page > pages) return Astro.redirect(`/c/${category.slug}`, 302);

const heading = category.h1 || category.name;
const canonical = new URL(`/c/${category.slug}${page > 1 ? `?page=${page}` : ''}`, Astro.site).toString();
const crumbs = [...ancestors, { id: category.id, name: category.name, slug: category.slug }];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.filtersfast.com/' },
      ...crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 2, name: c.name, item: `https://www.filtersfast.com/c/${c.slug}` })),
    ],
  },
];
---

<Base title={category.metaTitle ?? heading} description={category.metaDescription ?? undefined} canonical={canonical} jsonLd={jsonLd}>
  <nav aria-label="Breadcrumb" class="site-container py-3 text-sm">
    <ol class="flex flex-wrap gap-2 text-ink">
      <li><a href="/" class="text-ink">Home</a></li>
      {crumbs.map((c, i) => (
        <>
          <li aria-hidden="true">/</li>
          {i === crumbs.length - 1 ? <li aria-current="page">{c.name}</li> : <li><a href={`/c/${c.slug}`} class="text-ink">{c.name}</a></li>}
        </>
      ))}
    </ol>
  </nav>

  <div class="site-container">
    <h1 class="text-3xl font-semibold text-brand-blue">{heading}</h1>
    {category.shortHtml && category.shortHtml !== category.name && <p class="mt-2 text-ink" set:html={category.shortHtml} />}

    <SubcategoryNav parentName={category.name} children={children} />

    <div class="mt-8 flex items-baseline justify-between">
      <h2 class="text-lg font-bold">{children.length > 0 ? `All ${category.name}` : 'Products'}</h2>
      <p class="text-sm text-ink">{total} products</p>
    </div>

    {rows.length === 0 ? (
      <p class="mt-8">No products in this category yet.</p>
    ) : (
      <ul class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-6 lg:grid-cols-4">
        {rows.map((p) => (
          <li><ProductCard product={p} /></li>
        ))}
      </ul>
    )}

    {pages > 1 && (
      <nav aria-label="Pagination" class="mt-10 flex items-center justify-center gap-3 text-sm">
        {page > 1 && <a href={`/c/${category.slug}${page > 2 ? `?page=${page - 1}` : ''}`} class="btn-secondary">Previous</a>}
        <span>Page {page} of {pages}</span>
        {page < pages && <a href={`/c/${category.slug}?page=${page + 1}`} class="btn-secondary">Next</a>}
      </nav>
    )}

    {category.descriptionHtml && (
      <section class="prose mt-12 max-w-none border-t border-border pt-8" set:html={category.descriptionHtml} />
    )}

    {faqList.length > 0 && (
      <section id="faq" class="mt-12 border-t border-border pt-8">
        <h2 class="text-xl font-bold text-brand-blue">Frequently Asked Questions</h2>
        <div class="mt-4 divide-y divide-border rounded-card border border-border">
          {faqList.map((f) => (
            <details class="p-4">
              <summary class="cursor-pointer list-none font-semibold text-ink-strong">{f.question}</summary>
              <div class="prose mt-2 text-sm" set:html={f.answerHtml} />
            </details>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>
