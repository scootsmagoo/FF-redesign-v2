---
import Base from '~/layouts/Base.astro';
import { looksLikeAirFilterSize, parseAirFilterSize } from '@ff/domain/air-filter-size';
import { modelPath } from '@ff/domain/urls';
import { and, eq, like, or, sql } from 'drizzle-orm';
import { applianceModels, compatibleSkus, products, searchRedirects } from '@ff/db';
import { getDb } from '~/lib/db';
import { productCard } from '~/lib/catalog';
import ProductCard from '~/components/ProductCard.astro';

/**
 * Phase 0 search: the legacy pre-search redirect rules (SKU match → PDP,
 * model match → model page, size → size listing) followed by a simple
 * LIKE query. HawkSearch takes over the fallthrough in Phase 1.
 */
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const db = getDb();

if (q) {
  // 0. Keyword redirects (legacy redirectHub): an exact keyword sends the shopper straight to a product or page.
  const kwNorm = q.toUpperCase().replace(/[^A-Z0-9]/g, '');
  if (kwNorm.length >= 2) {
    const hit = await db
      .select({ slug: products.slug, toPath: searchRedirects.toPath })
      .from(searchRedirects)
      .leftJoin(products, and(eq(products.id, searchRedirects.productId), eq(products.active, true), sql`coalesce(${products.blockedReason}, '') = ''`, sql`${products.stock} <> -250`))
      .where(eq(searchRedirects.normalized, kwNorm))
      .orderBy(searchRedirects.kind)
      .limit(1);
    if (hit[0]?.slug) return Astro.redirect(`/p/${hit[0].slug}`, 302);
    if (hit[0]?.toPath) return Astro.redirect(hit[0].toPath, 302);
  }

  // 1. Exact SKU match (with and without hyphens).
  const bare = q.replace(/-/g, '');
  const sku = await db
    .select({ slug: products.slug })
    .from(products)
    .where(or(sql`upper(${products.sku}) = upper(${q})`, sql`upper(replace(${products.sku}, '-', '')) = upper(${bare})`))
    .limit(1);
  if (sku[0]) return Astro.redirect(`/p/${sku[0].slug}`, 302);

  // 1b. Cross-reference part number (legacy productCompSkuList): one match → that product.
  const norm = bare.toUpperCase().replace(/[^A-Z0-9]/g, '');
  if (norm.length >= 3) {
    const xref = await db
      .select({ slug: products.slug })
      .from(compatibleSkus)
      .innerJoin(products, eq(products.id, compatibleSkus.productId))
      .where(and(eq(compatibleSkus.skuNormalized, norm), eq(products.active, true), sql`coalesce(${products.blockedReason}, '') = ''`, sql`${products.stock} <> -250`))
      .limit(2);
    if (xref.length === 1) return Astro.redirect(`/p/${xref[0]!.slug}`, 302);
  }

  // 2. Air filter size.
  if (looksLikeAirFilterSize(q)) {
    const parsed = parseAirFilterSize(q);
    if (parsed.ok) return Astro.redirect(`/air-filters/size/${parsed.size.key}`, 302);
  }

  // 3. Appliance model number.
  if (q.length > 4 && /^[a-z0-9\-\/. ]+$/i.test(q)) {
    const model = await db
      .select({ modelNumber: applianceModels.modelNumber })
      .from(applianceModels)
      .where(sql`upper(${applianceModels.modelNumber}) = upper(${q})`)
      .limit(1);
    if (model[0]) return Astro.redirect(modelPath(model[0].modelNumber), 301);
  }
}

const results = q
  ? await db
      .select(productCard)
      .from(products)
      .where(or(like(products.name, `%${q}%`), like(products.sku, `%${q}%`)))
      .orderBy(products.popRank)
      .limit(48)
  : [];
---

<Base title={q ? `Search results for "${q}"` : 'Search'} noindex>
  <div class="site-container py-6">
    <h1 class="text-2xl font-semibold text-brand-blue">{q ? `Results for “${q}”` : 'Search'}</h1>
    {q && <p class="mt-1 text-sm">{results.length} products</p>}
    {results.length > 0 && (
      <ul class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-6 lg:grid-cols-4">
        {results.map((p) => (
          <li><ProductCard product={p} /></li>
        ))}
      </ul>
    )}
  </div>
</Base>
