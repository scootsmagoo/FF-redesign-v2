---
import StaticPage from '~/layouts/StaticPage.astro';
import { articlePath, listFaqArticles, listSupportCategories } from '~/lib/support';

const [categories, faqArticles] = await Promise.all([listSupportCategories(), listFaqArticles()]);
const quick = [
  ['Track an order', '/track-order'],
  ['Start a return', '/returns'],
  ['Find your refrigerator filter', '/tools/refrigerator-finder'],
  ['Look up an appliance model', '/models'],
];
---

<StaticPage title="Support" heading="How can we help?" intro="Search the help center, browse by topic, or reach a real person in Charlotte, North Carolina." wide description="FiltersFast.com support: order help, shipping, returns, Home Filter Club, product help, and how to reach us.">
  <form slot="hero" action="/support/search" method="get" role="search" class="mt-6 flex max-w-xl">
    <label for="support-q" class="sr-only">Search help articles</label>
    <input id="support-q" name="q" type="search" placeholder="Type your question here" class="w-full rounded-l-btn border-0 px-4 py-3 text-base text-ink-strong focus:outline-none" />
    <button type="submit" class="rounded-r-btn bg-brand-orange px-5 font-semibold text-white hover:bg-brand-orange-dark">Search</button>
  </form>

  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="min-w-0">
      <h2 class="text-xl font-bold">Browse by topic</h2>
      <ul class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((c) => (
          <li>
            <a href={`/support/${c.slug}`} class="block h-full rounded-card border border-border bg-white p-4 hover:border-brand-blue hover:no-underline">
              <span class="block font-semibold text-ink-strong">{c.name}</span>
              <span class="block text-xs text-ink/60">{c.articleCount} article{c.articleCount === 1 ? '' : 's'}</span>
            </a>
          </li>
        ))}
      </ul>

      {faqArticles.length > 0 && (
        <section class="mt-10">
          <h2 class="text-xl font-bold">Frequently asked questions</h2>
          <ul class="mt-3 divide-y divide-border rounded-card border border-border bg-white">
            {faqArticles.map((a) => <li><a href={articlePath(a)} class="block px-4 py-3 text-ink-strong hover:bg-surface-alt hover:no-underline">{a.title}</a></li>)}
          </ul>
        </section>
      )}
    </div>

    <aside class="space-y-4">
      <section class="rounded-card border border-border bg-white p-5 text-sm">
        <h2 class="text-lg font-bold">Talk to us</h2>
        <p class="mt-2">Call <a href="tel:8664383458" class="font-semibold">(866) 438-3458</a></p>
        <p>Text <a href="sms:7042289166" class="font-semibold">(704) 228-9166</a></p>
        <p>Email <a href="mailto:support@filtersfast.com" class="font-semibold">support@filtersfast.com</a></p>
        <p class="mt-3 text-xs text-ink/70">Monday to Thursday 9:00 am to 12:30 pm and 1:30 pm to 5:30 pm ET · Friday 9:00 am to 1:30 pm ET</p>
      </section>
      <section class="rounded-card bg-surface-alt p-5 text-sm">
        <h2 class="text-lg font-bold">Quick links</h2>
        <ul class="mt-2 space-y-1.5">
          {quick.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
          <li><a href="https://blog.filtersfast.com/blog/" rel="noopener">Filtration guides on the blog</a></li>
          <li><a href="/terms">Terms, privacy, and accessibility</a></li>
        </ul>
      </section>
    </aside>
  </div>
</StaticPage>
