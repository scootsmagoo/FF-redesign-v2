---
import { actions } from 'astro:actions';
import Manager from '~/layouts/Manager.astro';
import { getFacilitatorStates, listCountries, listShipZones, MARKETPLACES } from '~/lib/manager/config';
import { can } from '~/lib/manager/permissions';

const writable = can(Astro.locals.admin, 'Locations', 1);
const sp = Astro.url.searchParams;
const created = Astro.getActionResult(actions.manager.saveCountry);
if (created && !created.error) return Astro.redirect(`/manager/locations/${created.data.country}?saved=1`, 303);
const fac = Astro.getActionResult(actions.manager.saveFacilitators);
if (fac && !fac.error) return Astro.redirect('/manager/locations?saved=facilitators#facilitators', 303);
const filter = { start: sp.get('start') ?? '', tax: (sp.get('tax') ?? '') as 'yes' | 'no' | '', zone: sp.get('zone') ? Number(sp.get('zone')) : null };
const [countries, zones, facilitators] = await Promise.all([listCountries(filter), listShipZones(), getFacilitatorStates()]);
const error = created?.error?.message ?? fac?.error?.message;
---

<Manager title="Locations & Tax" current="/manager/locations">
  <h1 class="text-2xl font-bold text-brand-blue">Locations & Tax</h1>
  <p class="mt-1 text-sm text-ink/70">Countries and their states with a tax rate and a shipping zone. A state's rate and zone override its country's; a zone with no rates hides the location at checkout. Live tax (TaxJar) replaces these rates once configured.</p>
  {sp.get('saved') && <p class="mt-3 rounded-btn bg-brand-blue-tint p-3 text-sm">Saved.</p>}
  {error && <p class="mt-3 rounded-btn bg-danger-tint p-3 text-sm text-danger">{error}</p>}

  <form method="get" class="mt-3 flex flex-wrap items-end gap-2 text-sm">
    <label class="block">Starts with<select name="start" class="mt-1 rounded-btn border border-input px-3 py-2"><option value="">All</option>{'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').map((l) => <option value={l} selected={filter.start === l}>{l}</option>)}</select></label>
    <label class="block">Tax<select name="tax" class="mt-1 rounded-btn border border-input px-3 py-2"><option value="">Any</option><option value="yes" selected={filter.tax === 'yes'}>Taxed</option><option value="no" selected={filter.tax === 'no'}>Not taxed</option></select></label>
    <label class="block">Zone<select name="zone" class="mt-1 rounded-btn border border-input px-3 py-2"><option value="">Any</option>{zones.map((z) => <option value={z} selected={filter.zone === z}>{z}</option>)}</select></label>
    <button class="btn-secondary !min-h-10 !py-2">Filter</button>
    <span class="text-ink/60">{countries.length} countries</span>
  </form>

  <div class="mt-4 overflow-x-auto rounded-card border border-border">
    <table class="w-full text-sm">
      <thead class="bg-surface-alt text-left"><tr><th class="p-2">Code</th><th class="p-2">Country</th><th class="p-2">Tax %</th><th class="p-2">Zone</th><th class="p-2">States</th><th class="p-2">Active</th></tr></thead>
      <tbody class="divide-y divide-border">
        {countries.length === 0 && <tr><td class="p-2" colspan="6">No countries match.</td></tr>}
        {countries.map((c) => <tr class={c.active ? '' : 'text-ink/50'}><td class="p-2 font-mono">{c.country}</td><td class="p-2 font-semibold"><a href={`/manager/locations/${c.country}`}>{c.name}</a></td><td class="p-2">{c.taxRate}</td><td class="p-2">{c.shipZone ?? '—'}</td><td class="p-2">{c.states}</td><td class="p-2">{c.active ? 'Y' : 'N'}</td></tr>)}
      </tbody>
    </table>
  </div>

  {writable && (
    <form method="POST" action={actions.manager.saveCountry} class="mt-4 flex flex-wrap items-end gap-2 rounded-card border border-border bg-surface-alt p-3 text-sm">
      <input type="hidden" name="locationId" value="0" />
      <label class="block">Code<input name="country" required maxlength="2" class="mt-1 w-16 rounded-btn border border-input px-2 py-1 uppercase" /></label>
      <label class="block">Name<input name="name" required class="mt-1 w-56 rounded-btn border border-input px-2 py-1" /></label>
      <label class="block">Tax %<input name="taxRate" type="number" step="0.001" min="0" value="0" class="mt-1 w-20 rounded-btn border border-input px-2 py-1" /></label>
      <label class="block">Zone<input name="shipZone" type="number" step="1" min="0" class="mt-1 w-16 rounded-btn border border-input px-2 py-1" /></label>
      <label class="flex items-center gap-1 pb-2"><input type="checkbox" name="active" value="true" checked /> Active</label>
      <button class="btn-primary !min-h-9 !py-1.5">Add Country</button>
    </form>
  )}

  <section id="facilitators" class="mt-8">
    <h2 class="text-lg font-bold">Marketplace tax facilitators</h2>
    <p class="text-xs text-ink/70">States where each marketplace collects sales tax on our behalf, so orders from there are not taxed by us (legacy marketplace_state_tax_facilitators).</p>
    <form method="POST" action={actions.manager.saveFacilitators} class="mt-2 grid gap-3 md:grid-cols-2">
      {MARKETPLACES.map((m) => <label class="block text-sm capitalize">{m}<textarea name={m} rows={3} class="mt-1 w-full rounded-btn border border-input px-2 py-1 font-mono text-xs" readonly={!writable}>{(facilitators[m] ?? []).join(' ')}</textarea></label>)}
      {writable && <div class="md:col-span-2"><button class="btn-secondary !min-h-9 !py-1.5">Save Facilitator States</button></div>}
    </form>
  </section>
</Manager>
