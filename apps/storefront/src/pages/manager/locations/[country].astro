---
import { actions } from 'astro:actions';
import Manager from '~/layouts/Manager.astro';
import { getCountryAdmin } from '~/lib/manager/config';
import { can } from '~/lib/manager/permissions';

const writable = can(Astro.locals.admin, 'Locations', 1);
const code = (Astro.params.country ?? '').toUpperCase();
const rs = [actions.manager.saveCountry, actions.manager.saveState].map((a) => Astro.getActionResult(a));
const del = Astro.getActionResult(actions.manager.deleteLocation);
if (rs.some((r) => r && !r.error)) return Astro.redirect(`/manager/locations/${rs.find((r) => r && !r.error)!.data.country}?saved=1`, 303);
if (del && !del.error) return Astro.redirect(del.data.country && (await getCountryAdmin(del.data.country)) ? `/manager/locations/${del.data.country}?saved=1` : '/manager/locations?saved=1', 303);
const error = rs.find((r) => r?.error)?.error?.message ?? del?.error?.message;
const detail = await getCountryAdmin(code);
if (!detail) return new Response(null, { status: 404 });
const { country, states } = detail;
const editId = Number(Astro.url.searchParams.get('edit') ?? 0);
const editState = states.find((s) => s.id === editId) ?? null;
---

<Manager title={`${country.name} · locations`} current="/manager/locations">
  <a href="/manager/locations" class="text-sm">← Locations & Tax</a>
  <h1 class="mt-1 text-2xl font-bold text-brand-blue">{country.name} <span class="font-mono text-base font-normal text-ink/60">{country.country}</span></h1>
  {Astro.url.searchParams.get('saved') && <p class="mt-3 rounded-btn bg-brand-blue-tint p-3 text-sm">Saved.</p>}
  {error && <p class="mt-3 rounded-btn bg-danger-tint p-3 text-sm text-danger">{error}</p>}

  <form method="POST" action={actions.manager.saveCountry} class="mt-4 flex flex-wrap items-end gap-2 rounded-card border border-border p-3 text-sm">
    <input type="hidden" name="locationId" value={country.id} />
    <label class="block">Code<input name="country" value={country.country} required maxlength="2" class="mt-1 w-16 rounded-btn border border-input px-2 py-1 uppercase" readonly={!writable} /></label>
    <label class="block">Name<input name="name" value={country.name} required class="mt-1 w-56 rounded-btn border border-input px-2 py-1" readonly={!writable} /></label>
    <label class="block">Tax %<input name="taxRate" type="number" step="0.001" min="0" value={country.taxRate} class="mt-1 w-20 rounded-btn border border-input px-2 py-1" readonly={!writable} /></label>
    <label class="block">Zone<input name="shipZone" type="number" step="1" min="0" value={country.shipZone ?? ''} class="mt-1 w-16 rounded-btn border border-input px-2 py-1" readonly={!writable} /></label>
    <label class="flex items-center gap-1 pb-2"><input type="checkbox" name="active" value="true" checked={country.active} disabled={!writable} /> Active</label>
    {writable && <button class="btn-primary !min-h-9 !py-1.5">Save Country</button>}
    {writable && <form method="POST" action={actions.manager.deleteLocation} class="ml-auto" onsubmit="return confirm('Delete this country and every state under it?')"><input type="hidden" name="locationId" value={country.id} /><button class="text-xs text-danger">delete country</button></form>}
  </form>
  <p class="mt-1 text-xs text-ink/60">Renaming the code moves every state with it. States override the country's tax rate and zone.</p>

  <h2 class="mt-6 text-lg font-bold">States / provinces ({states.length})</h2>
  {writable && (
    <form method="POST" action={actions.manager.saveState} class="mt-2 flex flex-wrap items-end gap-2 rounded-card border border-border bg-surface-alt p-3 text-sm">
      <input type="hidden" name="locationId" value={editState?.id ?? 0} />
      <input type="hidden" name="country" value={country.country} />
      <label class="block">Code<input name="region" value={editState?.region ?? ''} required maxlength="3" class="mt-1 w-16 rounded-btn border border-input px-2 py-1 uppercase" /></label>
      <label class="block">Name<input name="name" value={editState?.name ?? ''} required class="mt-1 w-56 rounded-btn border border-input px-2 py-1" /></label>
      <label class="block">Tax %<input name="taxRate" type="number" step="0.001" min="0" value={editState?.taxRate ?? 0} class="mt-1 w-20 rounded-btn border border-input px-2 py-1" /></label>
      <label class="block">Zone<input name="shipZone" type="number" step="1" min="0" value={editState?.shipZone ?? ''} class="mt-1 w-16 rounded-btn border border-input px-2 py-1" /></label>
      <label class="flex items-center gap-1 pb-2"><input type="checkbox" name="active" value="true" checked={editState ? editState.active : true} /> Active</label>
      <button class="btn-primary !min-h-9 !py-1.5">{editState ? 'Save State' : 'Add State'}</button>
      {editState && <a href={`/manager/locations/${country.country}`} class="text-sm">cancel</a>}
    </form>
  )}
  <div class="mt-3 overflow-x-auto rounded-card border border-border">
    <table class="w-full text-sm">
      <thead class="bg-surface-alt text-left"><tr><th class="p-2">Code</th><th class="p-2">Name</th><th class="p-2">Tax %</th><th class="p-2">Zone</th><th class="p-2">Active</th><th class="p-2"></th></tr></thead>
      <tbody class="divide-y divide-border">
        {states.length === 0 && <tr><td class="p-2" colspan="6">No states.</td></tr>}
        {states.map((s) => <tr class={s.active ? '' : 'text-ink/50'}><td class="p-2 font-mono">{s.region}</td><td class="p-2">{s.name}</td><td class="p-2">{s.taxRate}</td><td class="p-2">{s.shipZone ?? '—'}</td><td class="p-2">{s.active ? 'Y' : 'N'}</td><td class="p-2 whitespace-nowrap text-right text-xs">{writable && <><a href={`/manager/locations/${country.country}?edit=${s.id}`}>edit</a> <form method="POST" action={actions.manager.deleteLocation} class="inline"><input type="hidden" name="locationId" value={s.id} /><input type="hidden" name="country" value={country.country} /><button class="ml-2 text-danger">delete</button></form></>}</td></tr>)}
      </tbody>
    </table>
  </div>
</Manager>
