---
import Manager from '~/layouts/Manager.astro';
import { searchCustomers } from '~/lib/admin';

const q = Astro.url.searchParams.get('q') ?? '';
const page = Number(Astro.url.searchParams.get('page') ?? '1') || 1;
const result = await searchCustomers(q, page);
const pages = Math.max(1, Math.ceil(result.total / result.pageSize));
const link = (p: number) => `/manager/customers?${new URLSearchParams({ q, page: String(p) })}`;
---

<Manager title="Customers" current="/manager/customers">
  <h1 class="text-2xl font-bold text-brand-blue">Customers</h1>
  <form method="get" class="mt-4 flex flex-wrap items-end gap-3">
    <label class="block text-sm">Search
      <input name="q" value={q} placeholder="Email, name, or customer #" class="mt-1 w-72 rounded-btn border border-gray-300 px-3 py-2" />
    </label>
    <button class="btn-secondary !min-h-10 !py-2">Search</button>
    <span class="text-sm text-ink/70">{result.total.toLocaleString('en-US')} customer{result.total === 1 ? '' : 's'}</span>
  </form>

  <div class="mt-4 overflow-x-auto rounded-card border border-border">
    <table class="w-full text-sm">
      <thead class="bg-surface-alt text-left"><tr><th class="p-3">#</th><th class="p-3">Email</th><th class="p-3">Name</th><th class="p-3">Sign-in</th><th class="p-3">Orders</th><th class="p-3">Since</th></tr></thead>
      <tbody class="divide-y divide-border">
        {result.rows.length === 0 && <tr><td class="p-3" colspan="6">No customers match.</td></tr>}
        {result.rows.map((c) => (
          <tr>
            <td class="p-3"><a href={`/manager/customers/${c.id}`}>{c.id}</a></td>
            <td class="p-3 font-semibold"><a href={`/manager/customers/${c.id}`}>{c.email}</a></td>
            <td class="p-3">{[c.firstName, c.lastName].filter(Boolean).join(' ')}</td>
            <td class="p-3">{c.userId ? 'yes' : c.guest ? 'guest' : 'no login'}</td>
            <td class="p-3">{c.orderCount}</td>
            <td class="p-3 whitespace-nowrap">{c.createdAt.slice(0, 10)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {pages > 1 && (
    <nav class="mt-4 flex items-center gap-3 text-sm" aria-label="Pagination">
      {page > 1 && <a href={link(page - 1)}>← Previous</a>}
      <span>Page {page} of {pages}</span>
      {page < pages && <a href={link(page + 1)}>Next →</a>}
    </nav>
  )}
</Manager>
