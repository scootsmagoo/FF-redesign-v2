---
import Manager from '~/layouts/Manager.astro';
import Pager from '~/components/manager/Pager.astro';
import { listCustomersManager, type CustomerFilter } from '~/lib/manager/customers';
import { fmtDate, pageParam } from '~/lib/manager/util';

const sp = Astro.url.searchParams;
const f: CustomerFilter = {
  q: sp.get('q') ?? '',
  field: (['any', 'id', 'email', 'name', 'phone', 'company', 'address'].includes(sp.get('field') ?? '') ? sp.get('field') : 'any') as CustomerFilter['field'],
  status: (sp.get('status') === 'active' || sp.get('status') === 'inactive' ? sp.get('status') : '') as CustomerFilter['status'],
  hasLogin: sp.get('login') === '1' ? true : sp.get('login') === '0' ? false : null,
  page: pageParam(Astro.url),
};
// Legacy auto-jump: an id goes straight to the customer.
if (f.q && f.field === 'id' && /^\d+$/.test(f.q.trim())) return Astro.redirect(`/manager/customers/${f.q.trim()}`, 302);
const result = await listCustomersManager(f);
const fields: [string, string][] = [['any', 'Anything'], ['id', 'Customer id'], ['email', 'Email'], ['name', 'Name'], ['phone', 'Phone'], ['company', 'Company'], ['address', 'Address']];
---

<Manager title="Customers" current="/manager/customers">
  <h1 class="text-2xl font-bold text-brand-blue">Customers</h1>
  <form method="get" class="mt-4 flex flex-wrap items-end gap-2 rounded-card border border-border bg-surface-alt p-3 text-sm">
    <label class="block">Search<input name="q" value={f.q} class="mt-1 w-64 rounded-btn border border-input px-3 py-2" placeholder="email, name, phone, company, id" /></label>
    <label class="block">In<select name="field" class="mt-1 rounded-btn border border-input px-3 py-2">{fields.map(([v, l]) => <option value={v} selected={f.field === v}>{l}</option>)}</select></label>
    <label class="block">Status<select name="status" class="mt-1 rounded-btn border border-input px-3 py-2"><option value="">Any</option><option value="active" selected={f.status === 'active'}>Active</option><option value="inactive" selected={f.status === 'inactive'}>Inactive</option></select></label>
    <label class="block">Sign-in<select name="login" class="mt-1 rounded-btn border border-input px-3 py-2"><option value="">Any</option><option value="1" selected={f.hasLogin === true}>Has a login</option><option value="0" selected={f.hasLogin === false}>No login</option></select></label>
    <button class="btn-secondary !min-h-10 !py-2">Search</button>
    <span class="ml-auto text-ink/70">{result.total.toLocaleString('en-US')} customer{result.total === 1 ? '' : 's'}</span>
  </form>

  <div class="mt-4 overflow-x-auto rounded-card border border-border">
    <table class="w-full text-sm">
      <thead class="bg-surface-alt text-left"><tr><th class="p-2">Id</th><th class="p-2">Email</th><th class="p-2">Name</th><th class="p-2">Phone</th><th class="p-2">Company</th><th class="p-2">Status</th><th class="p-2">Sign-in</th><th class="p-2">Orders</th><th class="p-2">Last order</th><th class="p-2">Since</th></tr></thead>
      <tbody class="divide-y divide-border">
        {result.rows.length === 0 && <tr><td class="p-2" colspan="10">No customers match.</td></tr>}
        {result.rows.map((c) => (
          <tr class={c.status === 'inactive' ? 'text-ink/50' : ''}>
            <td class="p-2"><a href={`/manager/customers/${c.id}`}>{c.id}</a></td>
            <td class="p-2 font-semibold"><a href={`/manager/customers/${c.id}`}>{c.email}</a></td>
            <td class="p-2">{[c.lastName, c.firstName].filter(Boolean).join(', ')}</td>
            <td class="p-2 text-xs">{c.phone ?? ''}</td>
            <td class="p-2 text-xs">{c.company ?? ''}</td>
            <td class="p-2 capitalize">{c.status}</td>
            <td class="p-2 text-xs">{c.userId ? 'yes' : c.guest ? 'guest' : 'none'}</td>
            <td class="p-2">{c.orderCount}</td>
            <td class="p-2 whitespace-nowrap text-xs">{c.lastOrderAt ? fmtDate(c.lastOrderAt) : ''}</td>
            <td class="p-2 whitespace-nowrap text-xs">{c.createdAt.slice(0, 10)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <Pager page={result.page} total={result.total} pageSize={result.pageSize} url={Astro.url} noun="customer" />
</Manager>
