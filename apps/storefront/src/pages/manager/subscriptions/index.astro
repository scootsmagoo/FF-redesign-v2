---
import Manager from '~/layouts/Manager.astro';
import { formatMoney } from '@ff/domain/pricing';
import { listSubscriptionOrders, STATUS_LABELS } from '~/lib/manager/orders';
import { fmtDate } from '~/lib/manager/util';

const sp = Astro.url.searchParams;
const to = sp.get('to') ?? new Date().toISOString().slice(0, 10);
const from = sp.get('from') ?? new Date(Date.now() - 7 * 86_400_000).toISOString().slice(0, 10);
const { days, rows } = await listSubscriptionOrders(from, to);
const byDay = new Map<string, { n: number; paid: number; failed: number; totalCents: number }>();
for (const d of days) {
  const cur = byDay.get(d.day) ?? { n: 0, paid: 0, failed: 0, totalCents: 0 };
  cur.n += d.n;
  if (['paid', 'processing', 'shipped', 'complete'].includes(d.status)) cur.paid += d.n;
  if (['pending', 'cancelled'].includes(d.status)) cur.failed += d.n;
  cur.totalCents += d.totalCents;
  byDay.set(d.day, cur);
}
const totals = [...byDay.values()].reduce((a, b) => ({ n: a.n + b.n, paid: a.paid + b.paid, failed: a.failed + b.failed, totalCents: a.totalCents + b.totalCents }), { n: 0, paid: 0, failed: 0, totalCents: 0 });
---

<Manager title="Subscriptions" current="/manager/subscriptions">
  <h1 class="text-2xl font-bold text-brand-blue">Home Filter Club Orders</h1>
  <p class="mt-1 text-sm text-ink/70">Orders inserted by Ordergroove through <code>/api/ordergroove/orders</code> (legacy sa_subscriptions). Failed insertions are listed under <a href="/manager/inbound?source=ordergroove">Inbound Calls</a>. Managing a customer's subscription itself happens in Ordergroove.</p>
  <form method="get" class="mt-3 flex flex-wrap items-end gap-2 text-sm">
    <label class="block">From<input name="from" type="date" value={from} class="mt-1 rounded-btn border border-input px-3 py-2" /></label>
    <label class="block">To<input name="to" type="date" value={to} class="mt-1 rounded-btn border border-input px-3 py-2" /></label>
    <button class="btn-secondary !min-h-10 !py-2">Show</button>
  </form>
  <div class="mt-4 grid gap-6 lg:grid-cols-[360px_minmax(0,1fr)]">
    <div class="h-fit overflow-x-auto rounded-card border border-border">
      <table class="w-full text-sm">
        <thead class="bg-surface-alt text-left"><tr><th class="p-2">Day</th><th class="p-2">Orders</th><th class="p-2">Paid</th><th class="p-2">Failed</th><th class="p-2 text-right">Dollars</th></tr></thead>
        <tbody class="divide-y divide-border">
          {byDay.size === 0 && <tr><td class="p-2" colspan="5">No subscription orders in this range.</td></tr>}
          {[...byDay.entries()].map(([day, v]) => <tr><td class="p-2">{day}</td><td class="p-2">{v.n}</td><td class="p-2 text-success">{v.paid}</td><td class="p-2 text-danger">{v.failed || ''}</td><td class="p-2 text-right">{formatMoney(v.totalCents)}</td></tr>)}
          {byDay.size > 0 && <tr class="bg-surface-alt font-semibold"><td class="p-2">Total</td><td class="p-2">{totals.n}</td><td class="p-2">{totals.paid}</td><td class="p-2">{totals.failed || ''}</td><td class="p-2 text-right">{formatMoney(totals.totalCents)}</td></tr>}
        </tbody>
      </table>
    </div>
    <div class="overflow-x-auto rounded-card border border-border">
      <table class="w-full text-sm">
        <thead class="bg-surface-alt text-left"><tr><th class="p-2">Order</th><th class="p-2">Customer</th><th class="p-2">Ordergroove id</th><th class="p-2">Placed</th><th class="p-2">Status</th><th class="p-2 text-right">Total</th></tr></thead>
        <tbody class="divide-y divide-border">
          {rows.length === 0 && <tr><td class="p-2" colspan="6">None.</td></tr>}
          {rows.map((o) => <tr><td class="p-2 font-semibold"><a href={`/manager/orders/${encodeURIComponent(o.number)}`}>{o.number}</a></td><td class="p-2 text-xs">{o.customerId ? <a href={`/manager/customers/${o.customerId}`}>{o.email}</a> : o.email}</td><td class="p-2 text-xs">{(o.attribution ?? '').split(':')[1] ?? ''}</td><td class="p-2 whitespace-nowrap text-xs">{fmtDate(o.placedAt)}</td><td class="p-2 capitalize">{STATUS_LABELS[o.status] ?? o.status}</td><td class="p-2 text-right">{formatMoney(o.totalCents)}</td></tr>)}
        </tbody>
      </table>
    </div>
  </div>
</Manager>
