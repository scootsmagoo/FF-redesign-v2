---
import Manager from '~/layouts/Manager.astro';
import Pager from '~/components/manager/Pager.astro';
import { formatMoney } from '@ff/domain/pricing';
import { listCredits } from '~/lib/manager/orders';
import { fmtDate, pageParam } from '~/lib/manager/util';

const sp = Astro.url.searchParams;
const orderId = Number(sp.get('order')) || null;
const customerId = Number(sp.get('customer')) || null;
const result = await listCredits({ orderId, customerId, page: pageParam(Astro.url) });
const symbol: Record<string, string> = { USD: '$', CAD: 'C$', EUR: '€', GBP: '£', AUD: 'A$' };
---

<Manager title="Order Credits" current="/manager/credits">
  <h1 class="text-2xl font-bold text-brand-blue">Order Credits</h1>
  <p class="mt-1 text-sm text-ink/70">Every credit and refund issued from an order (legacy SA_order_credits). Issue new ones from the order's Credits tab.</p>
  <form method="get" class="mt-3 flex flex-wrap items-end gap-2 text-sm">
    <label class="block">Order id<input name="order" type="number" value={orderId ?? ''} class="mt-1 w-28 rounded-btn border border-gray-300 px-3 py-2" /></label>
    <label class="block">Customer id<input name="customer" type="number" value={customerId ?? ''} class="mt-1 w-28 rounded-btn border border-gray-300 px-3 py-2" /></label>
    <button class="btn-secondary !min-h-10 !py-2">Filter</button>
    <a href="/manager/credits" class="text-sm">Clear</a>
  </form>
  <div class="mt-4 overflow-x-auto rounded-card border border-border">
    <table class="w-full text-sm">
      <thead class="bg-surface-alt text-left"><tr><th class="p-2">When</th><th class="p-2">Order</th><th class="p-2">Customer</th><th class="p-2">Method</th><th class="p-2">Reason</th><th class="p-2">Note</th><th class="p-2">By</th><th class="p-2">Status</th><th class="p-2 text-right">Amount</th></tr></thead>
      <tbody class="divide-y divide-border">
        {result.rows.length === 0 && <tr><td class="p-2" colspan="9">No credits.</td></tr>}
        {result.rows.map((c) => (
          <tr class={c.status === 'failed' ? 'text-ink/50' : ''}>
            <td class="p-2 whitespace-nowrap text-xs">{fmtDate(c.createdAt)}</td>
            <td class="p-2"><a href={`/manager/orders/${encodeURIComponent(c.number)}?tab=credits`}>{c.number}</a></td>
            <td class="p-2">{c.customerId ? <a href={`/manager/customers/${c.customerId}`}>#{c.customerId}</a> : 'guest'}</td>
            <td class="p-2">{c.method} <span class="text-xs text-ink/50">#{c.id}</span>{c.providerRef ? <span class="block text-[11px] text-ink/50">{c.providerRef}</span> : null}</td>
            <td class="p-2">{c.reason}</td>
            <td class="p-2 text-xs">{c.note ?? ''}</td>
            <td class="p-2 text-xs">{c.adminEmail ?? ''}</td>
            <td class:list={['p-2 capitalize', c.status === 'failed' ? 'text-danger' : c.status === 'pending' ? 'text-brand-orange' : 'text-success']}>{c.status}</td>
            <td class="p-2 text-right font-semibold">{symbol[c.currency] ?? ''}{(c.amountCents / 100).toFixed(2)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <Pager page={result.page} total={result.total} pageSize={result.pageSize} url={Astro.url} noun="credit" />
</Manager>
