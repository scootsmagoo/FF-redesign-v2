---
import Manager from '~/layouts/Manager.astro';
import { EXPORT_COLUMNS, exportCell, exportProducts, type ExportColumn } from '~/lib/manager/bulk';

const sp = Astro.url.searchParams;
const q = sp.get('q') ?? '';
const searchDetails = sp.get('details') === '1';
const includeInactive = sp.get('inactive') === '1';
const chosen = sp.getAll('col') as ExportColumn[];
const cols = EXPORT_COLUMNS.filter(([k]) => (chosen.length ? chosen.includes(k) : !['manufacturerSku', 'brandName', 'upc', 'weightOz', 'cost'].includes(k)));
const ran = sp.get('run') === '1';
const rows = ran ? await exportProducts({ q, searchDetails, includeInactive, limit: 500 }) : [];
const query = `q=${encodeURIComponent(q)}${searchDetails ? '&details=1' : ''}${includeInactive ? '&inactive=1' : ''}${cols.map(([k]) => `&col=${k}`).join('')}`;
---

<Manager title="Product export" current="/manager/products">
  <a href="/manager/products" class="text-sm">← Products</a>
  <h1 class="mt-1 text-2xl font-bold text-brand-blue">Product Export</h1>
  <p class="mt-1 text-sm text-ink/70">Search, pick columns, preview the first 500 rows and download everything (up to 5,000) as CSV (legacy sa_prod_export).</p>
  <form method="get" class="mt-4 space-y-3 rounded-card border border-border bg-white p-4 text-sm">
    <input type="hidden" name="run" value="1" />
    <div class="flex flex-wrap items-end gap-2">
      <label class="block">Search<input name="q" value={q} placeholder="title, SKU, id, description" class="mt-1 block w-72 rounded-btn border border-gray-300 px-3 py-2" /></label>
      <label class="flex items-center gap-1 pb-2"><input type="checkbox" name="details" value="1" checked={searchDetails} /> also search details HTML</label>
      <label class="flex items-center gap-1 pb-2"><input type="checkbox" name="inactive" value="1" checked={includeInactive} /> include inactive</label>
    </div>
    <details open={chosen.length > 0}><summary class="cursor-pointer text-xs text-ink/70">Columns</summary><div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs">{EXPORT_COLUMNS.map(([k, l]) => <label class="flex items-center gap-1"><input type="checkbox" name="col" value={k} checked={cols.some(([c]) => c === k)} /> {l}</label>)}</div></details>
    <div class="flex flex-wrap items-center gap-2">
      <button class="btn-secondary !min-h-10 !py-2">Preview</button>
      {ran && <a href={`/manager/products/export.csv?${query}`} class="btn-primary !min-h-10 !py-2">Download CSV</a>}
      {ran && <span class="text-ink/60">{rows.length === 500 ? 'first 500 rows shown' : `${rows.length} rows`}</span>}
    </div>
  </form>
  {ran && (
    <div class="mt-4 overflow-x-auto rounded-card border border-border bg-white">
      <table class="w-full text-xs whitespace-nowrap">
        <thead class="bg-surface-alt text-left"><tr>{cols.map(([, l]) => <th class="p-2">{l}</th>)}</tr></thead>
        <tbody class="divide-y divide-border">
          {rows.length === 0 && <tr><td class="p-2" colspan={cols.length}>No products match.</td></tr>}
          {rows.map((r) => <tr class={r.active ? '' : 'text-ink/50'}>{cols.map(([k]) => <td class="p-2">{k === 'id' ? <a href={`/manager/products/${r.id}`}>{r.id}</a> : k === 'url' ? <a href={r.url} target="_blank" rel="noopener">{r.slug}</a> : exportCell(r, k)}</td>)}</tr>)}
        </tbody>
      </table>
    </div>
  )}
</Manager>
