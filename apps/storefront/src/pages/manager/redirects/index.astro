---
import { actions } from 'astro:actions';
import Manager from '~/layouts/Manager.astro';
import Pager from '~/components/manager/Pager.astro';
import { can } from '~/lib/manager/permissions';
import { listRedirects, listSearchRedirects } from '~/lib/manager/catalog';
import { pageParam } from '~/lib/manager/util';

const writable = can(Astro.locals.admin, 'Redirects', 1);
const sp = Astro.url.searchParams;
const view = sp.get('view') === 'search' ? 'search' : 'url';
const q = sp.get('q') ?? '';
const kind = sp.get('kind') ?? '';
const self = `/manager/redirects?view=${view}${q ? `&q=${encodeURIComponent(q)}` : ''}${kind ? `&kind=${kind}` : ''}`;
const results = [actions.manager.saveRedirect, actions.manager.deleteRedirect, actions.manager.saveSearchRedirect, actions.manager.deleteSearchRedirect].map((a) => Astro.getActionResult(a));
if (results.some((r) => r && !r.error)) return Astro.redirect(`${self}&saved=1`, 303);
const error = results.find((r) => r?.error)?.error?.message;
const page = pageParam(Astro.url);
const urls = view === 'url' ? await listRedirects({ q, kind, page }) : null;
const searches = view === 'search' ? await listSearchRedirects(q, page) : null;
const editId = Number(sp.get('edit') ?? 0);
const editRow = urls?.rows.find((r) => r.id === editId) ?? null;
const editSearch = searches?.rows.find((r) => r.id === editId) ?? null;
---

<Manager title="Redirects" current="/manager/redirects">
  <h1 class="text-2xl font-bold text-brand-blue">Redirects</h1>
  <p class="mt-1 text-sm text-ink/70">URL redirects send an old path (legacy .asp, renamed slug) to a new one with a 301. Search redirects send an exact search phrase straight to a product or page.</p>
  <nav class="mt-3 flex gap-2 text-sm">
    <a href="/manager/redirects?view=url" class:list={['rounded-btn px-3 py-1', view === 'url' ? 'bg-brand-blue text-white hover:text-white' : 'bg-surface-alt']}>URL redirects</a>
    <a href="/manager/redirects?view=search" class:list={['rounded-btn px-3 py-1', view === 'search' ? 'bg-brand-blue text-white hover:text-white' : 'bg-surface-alt']}>Search redirects</a>
  </nav>
  {sp.get('saved') && <p class="mt-3 rounded-btn bg-brand-blue-tint p-3 text-sm">Saved.</p>}
  {error && <p class="mt-3 rounded-btn bg-danger-tint p-3 text-sm text-danger">{error}</p>}

  <form method="get" class="mt-4 flex flex-wrap items-end gap-2 text-sm">
    <input type="hidden" name="view" value={view} />
    <label class="block">Find<input name="q" value={q} class="mt-1 w-72 rounded-btn border border-input px-3 py-2" placeholder={view === 'url' ? 'old or new path' : 'keyword or path'} /></label>
    {view === 'url' && (
      <label class="block">Kind<select name="kind" class="mt-1 rounded-btn border border-input px-3 py-2"><option value="">Any</option>{['product', 'category', 'keyword', 'manual'].map((k) => <option value={k} selected={kind === k}>{k}</option>)}</select></label>
    )}
    <button class="btn-secondary !min-h-10 !py-2">Search</button>
  </form>

  {urls && (
    <>
      {writable && (
        <form method="POST" action={actions.manager.saveRedirect} class="mt-4 flex flex-wrap items-end gap-2 rounded-card border border-border bg-surface-alt p-3 text-sm">
          <input type="hidden" name="redirectId" value={editRow?.id ?? 0} />
          <label class="block">Old path<input name="fromPath" value={editRow?.fromPath ?? ''} required placeholder="/old-page.asp" class="mt-1 w-72 rounded-btn border border-input px-3 py-2" /></label>
          <label class="block">New path or URL<input name="toPath" value={editRow?.toPath ?? ''} required placeholder="/p/new-slug" class="mt-1 w-72 rounded-btn border border-input px-3 py-2" /></label>
          <label class="block">Status<select name="status" class="mt-1 rounded-btn border border-input px-3 py-2"><option value="301" selected={editRow?.status !== 302}>301 permanent</option><option value="302" selected={editRow?.status === 302}>302 temporary</option></select></label>
          <label class="block">Kind<select name="kind" class="mt-1 rounded-btn border border-input px-3 py-2">{['manual', 'product', 'category', 'keyword'].map((k) => <option value={k} selected={(editRow?.kind ?? 'manual') === k}>{k}</option>)}</select></label>
          <button class="btn-primary !min-h-10 !py-2">{editRow ? 'Save' : 'Add Redirect'}</button>
          {editRow && <a href={self} class="text-sm">cancel</a>}
        </form>
      )}
      <div class="mt-4 overflow-x-auto rounded-card border border-border">
        <table class="w-full text-sm">
          <thead class="bg-surface-alt text-left"><tr><th class="p-2">Old path</th><th class="p-2">New path</th><th class="p-2">Status</th><th class="p-2">Kind</th><th class="p-2">Hits</th><th class="p-2">Created</th><th class="p-2"></th></tr></thead>
          <tbody class="divide-y divide-border">
            {urls.rows.length === 0 && <tr><td class="p-2" colspan="7">No redirects match.</td></tr>}
            {urls.rows.map((r) => (
              <tr>
                <td class="p-2 font-mono text-xs"><a href={r.fromPath} target="_blank" rel="noopener">{r.fromPath}</a></td>
                <td class="p-2 font-mono text-xs">{r.toPath}</td>
                <td class="p-2">{r.status}</td>
                <td class="p-2">{r.kind}</td>
                <td class="p-2">{r.hits}</td>
                <td class="p-2 whitespace-nowrap text-xs">{r.createdAt.slice(0, 10)}</td>
                <td class="p-2 whitespace-nowrap text-right text-xs">{writable && <><a href={`${self}&edit=${r.id}`}>edit</a> <form method="POST" action={actions.manager.deleteRedirect} class="inline"><input type="hidden" name="redirectId" value={r.id} /><button class="ml-2 text-danger">delete</button></form></>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <Pager page={urls.page} total={urls.total} pageSize={urls.pageSize} url={Astro.url} noun="redirect" />
    </>
  )}

  {searches && (
    <>
      {writable && (
        <form method="POST" action={actions.manager.saveSearchRedirect} class="mt-4 flex flex-wrap items-end gap-2 rounded-card border border-border bg-surface-alt p-3 text-sm">
          <input type="hidden" name="redirectId" value={editSearch?.id ?? 0} />
          <label class="block">Search phrase<input name="keyword" value={editSearch?.keyword ?? ''} required class="mt-1 w-64 rounded-btn border border-input px-3 py-2" /></label>
          <label class="block">Product id<input name="productId" type="number" value={editSearch?.productId ?? ''} class="mt-1 w-28 rounded-btn border border-input px-3 py-2" /></label>
          <span class="pb-3 text-ink/60">or</span>
          <label class="block">Path<input name="toPath" value={editSearch?.toPath ?? ''} placeholder="/c/refrigerator-water-filters" class="mt-1 w-72 rounded-btn border border-input px-3 py-2" /></label>
          <button class="btn-primary !min-h-10 !py-2">{editSearch ? 'Save' : 'Add Search Redirect'}</button>
          {editSearch && <a href={self} class="text-sm">cancel</a>}
        </form>
      )}
      <div class="mt-4 overflow-x-auto rounded-card border border-border">
        <table class="w-full text-sm">
          <thead class="bg-surface-alt text-left"><tr><th class="p-2">Phrase</th><th class="p-2">Sends to</th><th class="p-2"></th></tr></thead>
          <tbody class="divide-y divide-border">
            {searches.rows.length === 0 && <tr><td class="p-2" colspan="3">No search redirects match.</td></tr>}
            {searches.rows.map((r) => (
              <tr>
                <td class="p-2 font-semibold">{r.keyword}</td>
                <td class="p-2">{r.productId ? <a href={`/manager/products/${r.productId}`}>product {r.sku ?? `#${r.productId}`}</a> : <span class="font-mono text-xs">{r.toPath}</span>}</td>
                <td class="p-2 whitespace-nowrap text-right text-xs">{writable && <><a href={`${self}&edit=${r.id}`}>edit</a> <form method="POST" action={actions.manager.deleteSearchRedirect} class="inline"><input type="hidden" name="redirectId" value={r.id} /><button class="ml-2 text-danger">delete</button></form></>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <Pager page={searches.page} total={searches.total} pageSize={searches.pageSize} url={Astro.url} noun="search redirect" />
    </>
  )}
</Manager>
