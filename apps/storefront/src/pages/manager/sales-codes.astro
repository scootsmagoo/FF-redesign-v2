---
import { actions } from 'astro:actions';
import Manager from '~/layouts/Manager.astro';
import { denyUnless } from '~/lib/manager/permissions';
import { listSalesCodes } from '~/lib/manager/staff';

const denied = denyUnless(Astro.locals, 'Setup', 1);
if (denied) return denied;
const saved = Astro.getActionResult(actions.manager.saveSalesCode);
const removed = Astro.getActionResult(actions.manager.deactivateSalesCode);
if ((saved && !saved.error) || (removed && !removed.error)) return Astro.redirect('/manager/sales-codes', 303);
const showInactive = Astro.url.searchParams.get('inactive') === '1';
const rows = await listSalesCodes(showInactive);
const error = saved?.error?.message ?? removed?.error?.message;
---

<Manager title="Sales Codes" current="/manager/sales-codes">
  <h1 class="text-2xl font-bold text-brand-blue">Sales Person Codes</h1>
  <p class="mt-1 text-sm text-ink/70">Codes stamped on orders taken by staff (legacy custom_sales_code). Define the code in NAV before adding it here. Removing a code deactivates it; past orders keep it.</p>
  {error && <p class="mt-3 rounded-btn bg-danger-tint p-3 text-sm text-danger">{error}</p>}

  <form method="POST" action={actions.manager.saveSalesCode} class="mt-4 flex flex-wrap items-end gap-2">
    <label class="block text-sm">Employee<input name="name" required class="mt-1 w-64 rounded-btn border border-input px-3 py-2" /></label>
    <label class="block text-sm">Sales code<input name="code" required maxlength="20" class="mt-1 w-40 rounded-btn border border-input px-3 py-2 uppercase" placeholder="ABC12" /></label>
    <button class="btn-primary !min-h-10 !py-2">Add Code</button>
    <a href={showInactive ? '/manager/sales-codes' : '/manager/sales-codes?inactive=1'} class="ml-auto text-sm">{showInactive ? 'Hide inactive' : 'Show inactive'}</a>
  </form>

  <div class="mt-4 overflow-x-auto rounded-card border border-border">
    <table class="w-full text-sm">
      <thead class="bg-surface-alt text-left"><tr><th class="p-3">Employee</th><th class="p-3">Code</th><th class="p-3">Status</th><th class="p-3"></th></tr></thead>
      <tbody class="divide-y divide-border">
        {rows.length === 0 && <tr><td class="p-3" colspan="4">No sales codes yet.</td></tr>}
        {rows.map((r) => (
          <tr class={r.active ? '' : 'text-ink/50'}>
            <td class="p-3">{r.name}</td>
            <td class="p-3 font-mono font-semibold">{r.code}</td>
            <td class="p-3">{r.active ? 'Active' : 'Inactive'}</td>
            <td class="p-3 text-right">
              {r.active ? (
                <form method="POST" action={actions.manager.deactivateSalesCode}><input type="hidden" name="id" value={r.id} /><button class="btn-secondary !min-h-8 !px-3 !py-1 text-xs">Remove</button></form>
              ) : (
                <form method="POST" action={actions.manager.saveSalesCode}><input type="hidden" name="id" value={r.id} /><input type="hidden" name="name" value={r.name} /><input type="hidden" name="code" value={r.code} /><button class="btn-secondary !min-h-8 !px-3 !py-1 text-xs">Reactivate</button></form>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Manager>
