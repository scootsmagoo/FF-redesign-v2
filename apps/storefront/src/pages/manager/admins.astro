---
import { actions } from 'astro:actions';
import Manager from '~/layouts/Manager.astro';
import { can, denyUnless, isSiteAdmin } from '~/lib/manager/permissions';
import { listSalesCodes } from '~/lib/manager/staff';
import { listAdmins, listRoles, passwordDaysLeft } from '~/lib/manager-auth';

const denied = denyUnless(Astro.locals, 'Admins', 0);
if (denied) return denied;
const me = Astro.locals.admin!;
const writable = can(me, 'Admins', 1);

const created = Astro.getActionResult(actions.manager.createAdmin);
const toggled = Astro.getActionResult(actions.manager.setAdminActive);
if (toggled && !toggled.error) return Astro.redirect('/manager/admins', 303);
const [list, roles, codes] = await Promise.all([listAdmins(), listRoles(), listSalesCodes()]);
// Legacy scoping: non-site-admins only see accounts in their own role.
const rows = (isSiteAdmin(me) ? list : list.filter((a) => a.roleId === me.roleId)).map((a) => {
  const days = passwordDaysLeft(a);
  const expired = a.passwordChangedAt !== null && days < 1;
  const pwLabel = a.mustChangePassword ? 'temporary' : !a.passwordChangedAt ? 'no rotation date' : expired ? 'expired' : `${days} d left`;
  return { ...a, expired, pwLabel };
});
const error = created?.error?.message ?? toggled?.error?.message;
const now = new Date().toISOString();
---

<Manager title="Staff Accounts" current="/manager/admins">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-2xl font-bold text-brand-blue">Staff Accounts</h1>
    <div class="flex gap-3 text-sm"><a href="/manager/roles">Roles</a><a href="/manager/admins/failed-logins">Failed sign-ins</a></div>
  </div>
  <p class="mt-1 text-sm text-ink/70">Manager sign-ins, separate from customer accounts. Passwords rotate every 90 days. Adding an existing address resets its password.</p>
  {error && <p class="mt-3 rounded-btn bg-red-50 p-3 text-sm text-danger">{error}</p>}
  {created?.data && (
    <div class="mt-3 rounded-btn border border-brand-orange bg-brand-orange-light p-4 text-sm">
      <p class="font-semibold">{created.data.created ? 'Account created' : 'Password reset'} for {created.data.email}.</p>
      <p class="mt-1">Temporary password (shown once): <code class="rounded bg-white px-2 py-0.5 text-base font-bold">{created.data.tempPassword}</code></p>
      <p class="mt-1 text-xs">They sign in at <code>/manager/login</code> and must choose a new password immediately. <a href={`/manager/admins/${created.data.id}`}>Set their role and permissions</a>.</p>
    </div>
  )}

  <div class="mt-4 overflow-x-auto rounded-card border border-border">
    <table class="w-full text-sm">
      <thead class="bg-surface-alt text-left"><tr><th class="p-3">Email</th><th class="p-3">Name</th><th class="p-3">Role</th><th class="p-3">Sales code</th><th class="p-3">Status</th><th class="p-3">Password</th><th class="p-3">Last sign-in</th><th class="p-3"></th></tr></thead>
      <tbody class="divide-y divide-border">
        {rows.map((a) => (
            <tr class={a.active ? '' : 'text-ink/50'}>
              <td class="p-3 font-semibold"><a href={`/manager/admins/${a.id}`}>{a.email}</a>{a.id === me.id ? <span class="ml-2 text-xs font-normal text-ink/60">(you)</span> : null}</td>
              <td class="p-3">{a.name ?? '—'}</td>
              <td class="p-3">{a.roleName ?? (a.overrides ? 'Custom' : 'Site Administrator (no role)')}{a.overrides && a.roleName ? <span class="ml-1 text-xs text-ink/60">+ overrides</span> : null}</td>
              <td class="p-3">{a.salesCode ?? '—'}</td>
              <td class="p-3">{!a.active ? 'Deactivated' : a.lockedUntil && a.lockedUntil > now ? 'Locked (failed sign-ins)' : a.mustChangePassword ? 'Temporary password' : 'Active'}</td>
              <td class="p-3 whitespace-nowrap"><span class={a.expired ? 'text-danger' : ''}>{a.pwLabel}</span></td>
              <td class="p-3 whitespace-nowrap">{a.lastLoginAt ? a.lastLoginAt.slice(0, 16).replace('T', ' ') : 'never'}</td>
              <td class="p-3 text-right">
                {writable && a.id !== me.id && (
                  <div class="flex justify-end gap-2">
                    <form method="POST" action={actions.manager.createAdmin}>
                      <input type="hidden" name="email" value={a.email} />
                      <button class="btn-secondary !min-h-8 !px-3 !py-1 text-xs">Reset Password</button>
                    </form>
                    <form method="POST" action={actions.manager.setAdminActive}>
                      <input type="hidden" name="adminId" value={a.id} />
                      <input type="hidden" name="active" value={a.active ? 'false' : 'true'} />
                      <button class="btn-secondary !min-h-8 !px-3 !py-1 text-xs">{a.active ? 'Deactivate' : 'Reactivate'}</button>
                    </form>
                  </div>
                )}
              </td>
            </tr>
        ))}
      </tbody>
    </table>
  </div>

  {writable && (
    <section class="mt-8">
      <h2 class="text-lg font-bold">Add a staff account</h2>
      <form method="POST" action={actions.manager.createAdmin} class="mt-2 flex flex-wrap items-end gap-2">
        <label class="block text-sm">Work email<input name="email" type="email" required class="mt-1 w-72 rounded-btn border border-gray-300 px-3 py-2" placeholder="name@filtersfast.com" /></label>
        <label class="block text-sm">Name<input name="name" class="mt-1 w-56 rounded-btn border border-gray-300 px-3 py-2" /></label>
        <label class="block text-sm">Role
          <select name="roleId" class="mt-1 rounded-btn border border-gray-300 px-3 py-2">
            <option value="">Choose a role…</option>
            {roles.filter((r) => isSiteAdmin(me) || r.id === me.roleId).map((r) => <option value={r.id}>{r.name}</option>)}
          </select>
        </label>
        <label class="block text-sm">Sales code
          <select name="salesCode" class="mt-1 rounded-btn border border-gray-300 px-3 py-2">
            <option value="">None</option>
            {codes.map((c) => <option value={c.code}>{c.code} · {c.name}</option>)}
          </select>
        </label>
        <button class="btn-primary !min-h-10 !py-2">Create Account</button>
      </form>
      <p class="mt-1 text-xs text-ink/60">An account with no role and no overrides is treated as a Site Administrator. Assign a role to limit access.</p>
    </section>
  )}
</Manager>
