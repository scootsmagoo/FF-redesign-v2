---
import Manager from '~/layouts/Manager.astro';
import { formatMoney } from '@ff/domain/pricing';
import { promoStats } from '~/lib/manager/marketing';
import { fmtDate } from '~/lib/manager/util';

const sp = Astro.url.searchParams;
const to = sp.get('to') ?? new Date().toISOString().slice(0, 10);
const from = sp.get('from') ?? new Date(Date.now() - 30 * 86_400_000).toISOString().slice(0, 10);
const code = (sp.get('code') ?? '').toUpperCase();
const { summary, detail } = await promoStats(from, to);
const rows = code ? detail.filter((d) => d.code === code) : [];
const max = Math.max(1, ...summary.map((s) => s.orders));
---

<Manager title="Promotion stats" current="/manager/promotions">
  <a href="/manager/promotions" class="text-sm">← Promotions</a>
  <h1 class="mt-1 text-2xl font-bold text-brand-blue">Promotion Stats</h1>
  <p class="mt-1 text-sm text-ink/70">Paid orders that used each code in the period, with the dollars discounted (legacy sa_discount_stat). Click a code for its orders.</p>
  <form method="get" class="mt-3 flex flex-wrap items-end gap-2 text-sm">
    <label class="block">From<input name="from" type="date" value={from} class="mt-1 rounded-btn border border-input px-3 py-2" /></label>
    <label class="block">To<input name="to" type="date" value={to} class="mt-1 rounded-btn border border-input px-3 py-2" /></label>
    {code && <input type="hidden" name="code" value={code} />}
    <button class="btn-secondary !min-h-10 !py-2">Show</button>
    {code && <a href={`/manager/promotions/stats?from=${from}&to=${to}`}>all codes</a>}
  </form>
  <div class="mt-4 overflow-x-auto rounded-card border border-border">
    <table class="w-full text-sm">
      <thead class="bg-surface-alt text-left"><tr><th class="p-2">Code</th><th class="p-2">Orders</th><th class="p-2"></th><th class="p-2 text-right">Order subtotals</th><th class="p-2 text-right">Discounted</th><th class="p-2 text-right">Avg discount</th></tr></thead>
      <tbody class="divide-y divide-border">
        {summary.length === 0 && <tr><td class="p-2" colspan="6">No promo codes were used in this period.</td></tr>}
        {summary.map((s) => (
          <tr class={code === s.code ? 'bg-brand-blue-tint' : ''}>
            <td class="p-2 font-semibold"><a href={`/manager/promotions/stats?from=${from}&to=${to}&code=${encodeURIComponent(s.code)}`}>{s.code}</a></td>
            <td class="p-2">{s.orders}</td>
            <td class="p-2 w-48"><div class="h-3 rounded bg-brand-orange" style={`width:${Math.round((s.orders / max) * 100)}%`}></div></td>
            <td class="p-2 text-right">{formatMoney(s.subtotalCents)}</td>
            <td class="p-2 text-right">{formatMoney(s.discountCents)}</td>
            <td class="p-2 text-right">{s.subtotalCents ? `${((s.discountCents / s.subtotalCents) * 100).toFixed(1)}%` : '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {code && (
    <div class="mt-6">
      <h2 class="text-lg font-bold">Orders using {code} ({rows.length})</h2>
      <div class="mt-2 overflow-x-auto rounded-card border border-border">
        <table class="w-full text-sm">
          <thead class="bg-surface-alt text-left"><tr><th class="p-2">Order</th><th class="p-2">Customer</th><th class="p-2">Placed</th><th class="p-2 text-right">Subtotal</th><th class="p-2 text-right">Discount</th><th class="p-2 text-right">Total</th><th class="p-2 text-right">Rate</th></tr></thead>
          <tbody class="divide-y divide-border">
            {rows.map((r) => <tr><td class="p-2"><a href={`/manager/orders/${encodeURIComponent(r.number)}`}>{r.number}</a></td><td class="p-2">{r.customerId ? <a href={`/manager/customers/${r.customerId}`}>#{r.customerId}</a> : 'guest'}</td><td class="p-2 whitespace-nowrap text-xs">{fmtDate(r.placedAt)}</td><td class="p-2 text-right">{formatMoney(r.subtotalCents)}</td><td class="p-2 text-right">({formatMoney(r.discountCents)})</td><td class="p-2 text-right">{formatMoney(r.totalCents)}</td><td class="p-2 text-right">{r.subtotalCents ? `${((r.discountCents / r.subtotalCents) * 100).toFixed(1)}%` : '—'}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  )}
</Manager>
