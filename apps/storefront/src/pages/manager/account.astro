---
import { actions } from 'astro:actions';
import Manager from '~/layouts/Manager.astro';
import { AREAS, AREA_GROUPS, LEVEL_LABELS } from '~/lib/manager/permissions';
import { MIN_ADMIN_PASSWORD, PASSWORD_MAX_AGE_DAYS, passwordDaysLeft } from '~/lib/manager-auth';

const me = Astro.locals.admin!;
const result = Astro.getActionResult(actions.manager.changePassword);
if (result && !result.error) return Astro.redirect('/manager?pw=updated', 303);
const mustParam = Astro.url.searchParams.get('must');
const must = mustParam === '1' || me.mustChangePassword;
const expired = mustParam === 'expired';
const days = passwordDaysLeft(me);
const groups = AREA_GROUPS.map((g) => ({ title: g, areas: AREAS.filter((a) => a.group === g).map((a) => ({ name: a.name, level: me.siteAdmin ? 1 : (me.permissions[a.name] ?? -1) })) }));
---

<Manager title="My Account" current="/manager/account">
  <h1 class="text-2xl font-bold text-brand-blue">My Account</h1>
  <p class="mt-1 text-sm text-ink/70">Signed in as <strong>{me.email}</strong>{me.name ? ` (${me.name})` : ''} · {me.siteAdmin ? 'Site Administrator' : (me.roleName ?? 'custom permissions')}{me.salesCode ? ` · sales code ${me.salesCode}` : ''}.</p>
  {must && <p class="mt-3 rounded-btn border border-brand-orange bg-brand-orange-light p-3 text-sm">You are using a temporary password. Choose a new one to continue.</p>}
  {expired && <p class="mt-3 rounded-btn border border-brand-orange bg-brand-orange-light p-3 text-sm">Your password is older than {PASSWORD_MAX_AGE_DAYS} days. Choose a new one to continue.</p>}
  {!must && !expired && me.passwordChangedAt && <p class="mt-3 text-sm text-ink/70">Password rotates in <strong>{days}</strong> days.</p>}
  {result?.error && <p class="mt-3 rounded-btn bg-danger-tint p-3 text-sm text-danger">{result.error.message}</p>}

  <div class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,420px)_1fr]">
    <form method="POST" action={actions.manager.changePassword} class="space-y-3">
      <h2 class="text-lg font-bold">Change password</h2>
      <label class="block text-sm">Current password<input name="currentPassword" type="password" autocomplete="current-password" required class="mt-1 w-full rounded-btn border border-input px-3 py-2" /></label>
      <label class="block text-sm">New password <span class="text-ink/60">({MIN_ADMIN_PASSWORD}+ characters with upper, lower and a number; not one of your last 5)</span><input name="newPassword" type="password" autocomplete="new-password" required minlength={MIN_ADMIN_PASSWORD} class="mt-1 w-full rounded-btn border border-input px-3 py-2" /></label>
      <label class="block text-sm">Confirm new password<input name="confirm" type="password" autocomplete="new-password" required minlength={MIN_ADMIN_PASSWORD} class="mt-1 w-full rounded-btn border border-input px-3 py-2" /></label>
      <button class="btn-primary">Save Password</button>
    </form>

    <section>
      <h2 class="text-lg font-bold">My permissions</h2>
      <div class="mt-2 grid gap-4 sm:grid-cols-2">
        {groups.map((g) => (
          <div class="rounded-card border border-border p-3 text-sm">
            <h3 class="font-semibold">{g.title}</h3>
            <ul class="mt-1 space-y-0.5">
              {g.areas.map((a) => <li class={a.level === -1 ? 'text-ink/40' : ''}>{a.name}: {LEVEL_LABELS[a.level as -1 | 0 | 1 | 2]}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </div>
</Manager>
