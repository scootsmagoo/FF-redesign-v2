---
import { actions } from 'astro:actions';
import Manager from '~/layouts/Manager.astro';
import { MIN_ADMIN_PASSWORD } from '~/lib/manager-auth';

const me = Astro.locals.admin!;
const result = Astro.getActionResult(actions.manager.changePassword);
if (result && !result.error) return Astro.redirect('/manager?pw=updated', 303);
const must = Astro.url.searchParams.get('must') === '1' || me.mustChangePassword;
---

<Manager title="My Password" current="/manager/account">
  <h1 class="text-2xl font-bold text-brand-blue">My Password</h1>
  <p class="mt-1 text-sm text-ink/70">Signed in as <strong>{me.email}</strong>.</p>
  {must && <p class="mt-3 rounded-btn border border-brand-orange bg-brand-orange-light p-3 text-sm">You are using a temporary password. Choose a new one to continue.</p>}
  {result?.error && <p class="mt-3 rounded-btn bg-red-50 p-3 text-sm text-danger">{result.error.message}</p>}
  <form method="POST" action={actions.manager.changePassword} class="mt-4 max-w-md space-y-3">
    <label class="block text-sm">Current password<input name="currentPassword" type="password" autocomplete="current-password" required class="mt-1 w-full rounded-btn border border-gray-300 px-3 py-2" /></label>
    <label class="block text-sm">New password <span class="text-ink/60">({MIN_ADMIN_PASSWORD}+ characters, letters and numbers)</span><input name="newPassword" type="password" autocomplete="new-password" required minlength={MIN_ADMIN_PASSWORD} class="mt-1 w-full rounded-btn border border-gray-300 px-3 py-2" /></label>
    <label class="block text-sm">Confirm new password<input name="confirm" type="password" autocomplete="new-password" required minlength={MIN_ADMIN_PASSWORD} class="mt-1 w-full rounded-btn border border-gray-300 px-3 py-2" /></label>
    <button class="btn-primary">Save Password</button>
  </form>
</Manager>
