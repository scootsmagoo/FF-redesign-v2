---
import { actions } from 'astro:actions';
import Manager from '~/layouts/Manager.astro';
import Field from '~/components/manager/Field.astro';
import { formatMoney } from '@ff/domain/pricing';
import { can } from '~/lib/manager/permissions';
import { getOptionGroupAdmin } from '~/lib/manager/catalog';
import { centsToDollars } from '~/lib/manager/util';

const writable = can(Astro.locals.admin, 'ProductOptions', 1);
const id = Number(Astro.params.id);
const saved = Astro.getActionResult(actions.manager.saveOptionGroup);
const opt = Astro.getActionResult(actions.manager.saveOption);
const del = Astro.getActionResult(actions.manager.deleteOption);
if ((saved && !saved.error) || (opt && !opt.error) || (del && !del.error)) return Astro.redirect(`/manager/options/groups/${id}?saved=1`, 303);
const detail = await getOptionGroupAdmin(id);
if (!detail) return new Response(null, { status: 404 });
const { group, options, products } = detail;
const error = saved?.error?.message ?? opt?.error?.message ?? del?.error?.message;
---

<Manager title={`Option group · ${group.name}`} current="/manager/options">
  <a href="/manager/options" class="text-sm">← Option Groups</a>
  <h1 class="mt-1 text-2xl font-bold text-brand-blue">{group.name} <span class="text-sm font-normal text-ink/60">#{group.id}</span></h1>
  {Astro.url.searchParams.get('saved') && <p class="mt-3 rounded-btn bg-brand-blue-tint p-3 text-sm">Saved.</p>}
  {error && <p class="mt-3 rounded-btn bg-danger-tint p-3 text-sm text-danger">{error}</p>}

  <form method="POST" action={actions.manager.saveOptionGroup} class="mt-4 flex flex-wrap items-end gap-3 text-sm">
    <input type="hidden" name="groupId" value={group.id} />
    <Field name="name" label="Group name" value={group.name} required readonly={!writable} width="w-56" />
    <Field name="displayType" label="Display" type="select" options={[{ value: 'select', label: 'Drop-down' }, { value: 'radio', label: 'Radio buttons' }, { value: 'text', label: 'Text input' }]} value={group.displayType} readonly={!writable} width="w-40" />
    <Field name="sizingLink" label="Sizing guide link" value={group.sizingLink} readonly={!writable} width="w-72" />
    <Field name="required" label="Required" type="checkbox" value={group.required} readonly={!writable} class="pb-2" />
    {writable && <button class="btn-primary !min-h-10 !py-2">Save Group</button>}
  </form>

  <h2 class="mt-8 text-lg font-bold">Options ({options.length})</h2>
  {options.map((o) => <form method="POST" action={actions.manager.saveOption} id={`o-${o.id}`}></form>)}
  {options.map((o) => <form method="POST" action={actions.manager.deleteOption} id={`d-${o.id}`}><input type="hidden" name="optionId" value={o.id} /></form>)}
  <div class="mt-2 overflow-x-auto rounded-card border border-border">
    <table class="w-full text-sm">
      <thead class="bg-surface-alt text-left"><tr><th class="p-2">Id</th><th class="p-2">Label</th><th class="p-2">Price add</th><th class="p-2">% add</th><th class="p-2">Sort</th><th class="p-2">Products</th><th class="p-2"></th></tr></thead>
      <tbody class="divide-y divide-border">
        {options.map((o) => (
          <tr>
            <td class="p-2">{o.id} <a href={`/manager/options/${o.id}`} class="text-xs">detail</a></td>
            <td class="p-2"><input form={`o-${o.id}`} type="hidden" name="optionId" value={o.id} /><input form={`o-${o.id}`} type="hidden" name="groupId" value={group.id} /><input form={`o-${o.id}`} name="label" value={o.label} class="w-56 rounded-btn border border-input px-2 py-1" readonly={!writable} /></td>
            <td class="p-2"><input form={`o-${o.id}`} name="priceAdd" type="number" step="0.01" value={centsToDollars(o.priceAddCents)} class="w-24 rounded-btn border border-input px-2 py-1" readonly={!writable} /></td>
            <td class="p-2"><input form={`o-${o.id}`} name="percentAdd" type="number" step="0.01" value={o.percentAdd || ''} class="w-20 rounded-btn border border-input px-2 py-1" readonly={!writable} /></td>
            <td class="p-2"><input form={`o-${o.id}`} name="sortOrder" type="number" step="1" value={o.sortOrder} class="w-16 rounded-btn border border-input px-2 py-1" readonly={!writable} /></td>
            <td class="p-2">{o.productCount}</td>
            <td class="p-2 whitespace-nowrap text-right">{writable && <><button form={`o-${o.id}`} class="btn-secondary !min-h-8 !px-3 !py-1 text-xs">Save</button> <button form={`d-${o.id}`} class="ml-1 text-xs text-danger" onclick="return confirm('Delete this option? Products using it lose it.')">delete</button></>}</td>
          </tr>
        ))}
        {writable && (
          <tr class="bg-surface-alt">
            <td class="p-2 text-ink/50">new</td>
            <td class="p-2"><input form="new-opt" type="hidden" name="optionId" value="0" /><input form="new-opt" type="hidden" name="groupId" value={group.id} /><input form="new-opt" name="label" required placeholder="Option label" class="w-56 rounded-btn border border-input px-2 py-1" /></td>
            <td class="p-2"><input form="new-opt" name="priceAdd" type="number" step="0.01" placeholder="0.00" class="w-24 rounded-btn border border-input px-2 py-1" /></td>
            <td class="p-2"><input form="new-opt" name="percentAdd" type="number" step="0.01" placeholder="0" class="w-20 rounded-btn border border-input px-2 py-1" /></td>
            <td class="p-2"><input form="new-opt" name="sortOrder" type="number" step="1" value={options.length + 1} class="w-16 rounded-btn border border-input px-2 py-1" /></td>
            <td class="p-2"></td>
            <td class="p-2 text-right"><button form="new-opt" class="btn-primary !min-h-8 !px-3 !py-1 text-xs">Add Option</button></td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
  {writable && <form method="POST" action={actions.manager.saveOption} id="new-opt"></form>}
  <p class="mt-1 text-xs text-ink/60">Price add is per unit on top of the product price; percent add scales the price. Per-product overrides, stock, images and exclusions live on each product's Options tab.</p>

  <h2 class="mt-8 text-lg font-bold">Products using this group ({products.length})</h2>
  <ul class="mt-2 grid gap-x-6 text-sm sm:grid-cols-2 lg:grid-cols-3">
    {products.length === 0 && <li class="text-ink/60">None.</li>}
    {products.map((p) => <li><a href={`/manager/products/${p.id}?tab=options`}>{p.sku}</a> <span class="text-ink/60">{p.name}</span></li>)}
  </ul>
  {products.length >= 500 && <p class="text-xs text-ink/60">Showing the first 500.</p>}
</Manager>
