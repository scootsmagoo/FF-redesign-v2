---
import Manager from '~/layouts/Manager.astro';
import Pager from '~/components/manager/Pager.astro';
import { listSearchLog, topMissedSearches } from '~/lib/manager/catalog';
import { pageParam } from '~/lib/manager/util';

const sp = Astro.url.searchParams;
const q = sp.get('q') ?? '';
const outcome = sp.get('outcome') ?? '';
const [result, missed] = await Promise.all([listSearchLog({ q, outcome, page: pageParam(Astro.url) }), topMissedSearches(30, 40)]);
---

<Manager title="Search Log" current="/manager/search-log">
  <h1 class="text-2xl font-bold text-brand-blue">Search Log</h1>
  <p class="mt-1 text-sm text-ink/70">Every site search and how it was resolved: a SKU, model or size short-circuit, a keyword redirect, or the search engine. Zero-result phrases are candidates for a <a href="/manager/redirects?view=search">search redirect</a>.</p>

  <div class="mt-4 grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div>
      <form method="get" class="flex flex-wrap items-end gap-2 text-sm">
        <label class="block">Phrase<input name="q" value={q} class="mt-1 w-64 rounded-btn border border-gray-300 px-3 py-2" /></label>
        <label class="block">Outcome<select name="outcome" class="mt-1 rounded-btn border border-gray-300 px-3 py-2"><option value="">Any</option>{result.outcomes.map((o) => <option value={o.outcome} selected={outcome === o.outcome}>{o.outcome} ({o.n.toLocaleString('en-US')})</option>)}</select></label>
        <button class="btn-secondary !min-h-10 !py-2">Filter</button>
      </form>
      <div class="mt-3 overflow-x-auto rounded-card border border-border">
        <table class="w-full text-sm">
          <thead class="bg-surface-alt text-left"><tr><th class="p-2">When</th><th class="p-2">Search</th><th class="p-2">Outcome</th><th class="p-2">Redirect</th><th class="p-2">Results</th><th class="p-2">Country</th></tr></thead>
          <tbody class="divide-y divide-border">
            {result.rows.length === 0 && <tr><td class="p-2" colspan="6">Nothing logged yet.</td></tr>}
            {result.rows.map((r) => (
              <tr>
                <td class="p-2 whitespace-nowrap text-xs">{r.createdAt.slice(0, 16).replace('T', ' ')}</td>
                <td class="p-2"><a href={`/search?q=${encodeURIComponent(r.query)}`} target="_blank" rel="noopener">{r.query}</a>{r.normalized && r.normalized !== r.query ? <span class="ml-1 text-xs text-ink/50">→ {r.normalized}</span> : null}</td>
                <td class="p-2">{r.outcome}</td>
                <td class="p-2 font-mono text-xs">{r.redirectTo ?? ''}</td>
                <td class:list={['p-2', r.resultCount === 0 ? 'text-danger' : '']}>{r.resultCount ?? ''}</td>
                <td class="p-2 text-xs">{r.country ?? ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <Pager page={result.page} total={result.total} pageSize={result.pageSize} url={Astro.url} noun="search" />
    </div>
    <aside class="h-fit rounded-card border border-border p-3 text-sm">
      <h2 class="font-bold">Most missed, last 30 days</h2>
      <ul class="mt-2 space-y-1">
        {missed.length === 0 && <li class="text-ink/60">No zero-result searches.</li>}
        {missed.map((m) => <li class="flex justify-between gap-2"><a href={`/manager/search-log?q=${encodeURIComponent(m.query)}`}>{m.query}</a><span class="text-ink/50">{m.n}</span></li>)}
      </ul>
    </aside>
  </div>
</Manager>
