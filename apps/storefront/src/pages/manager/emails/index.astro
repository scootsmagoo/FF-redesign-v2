---
import Manager from '~/layouts/Manager.astro';
import { getProviders } from '~/lib/providers';
import { templateIdFor, type EmailKind } from '~/lib/emails';

const provider = getProviders().email.name;
const templates: { kind: EmailKind; label: string; when: string }[] = [
  { kind: 'order-confirmation', label: 'Order confirmation', when: 'Sent when an order is placed; "Resend Confirmation" on an order' },
  { kind: 'shipment', label: 'Shipment notice', when: 'Sent when a shipment is added with "Email tracking" ticked; "Resend Tracking" on an order' },
  { kind: 'password-reset', label: 'Password reset', when: 'Sent from the customer forgot-password form' },
];
const order = Astro.url.searchParams.get('order')?.trim() ?? '';
const view = Astro.url.searchParams.get('view') ?? 'html';
const qs = (kind: EmailKind) => `/manager/emails/${kind}?view=${view}${order ? `&order=${encodeURIComponent(order)}` : ''}`;
---

<Manager title="Emails" current="/manager/emails">
  <h1 class="text-2xl font-bold text-brand-blue">Customer Emails</h1>
  <p class="mt-1 text-sm text-ink/70">
    Provider: <strong>{provider}</strong>{provider === 'console' ? ' (nothing is delivered; messages go to the Worker log)' : ''}.
    Each template is rendered inline unless a SendGrid dynamic template id is configured for it in <code>wrangler.jsonc</code>.
  </p>

  <form method="get" class="mt-4 flex flex-wrap items-end gap-3 text-sm">
    <label class="block">Preview with order number
      <input name="order" value={order} placeholder="FF… (blank = sample data)" class="mt-1 w-56 rounded-btn border border-input px-3 py-2" />
    </label>
    <label class="block">Show
      <select name="view" class="mt-1 rounded-btn border border-input px-3 py-2">
        <option value="html" selected={view === 'html'}>HTML</option>
        <option value="text" selected={view === 'text'}>Plain text</option>
        <option value="data" selected={view === 'data'}>SendGrid template data</option>
      </select>
    </label>
    <button class="btn-secondary !min-h-10 !py-2">Refresh</button>
  </form>

  <div class="mt-6 space-y-8">
    {templates.map((t) => (
      <section>
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="text-lg font-bold">{t.label}</h2>
          <span class="text-xs text-ink/60">template id: <code>{templateIdFor(t.kind)}</code>{templateIdFor(t.kind) === t.kind ? ' (inline HTML)' : ' (SendGrid dynamic template)'}</span>
        </div>
        <p class="text-xs text-ink/70">{t.when}. <a href={qs(t.kind)} target="_blank" rel="noopener">Open in a new tab</a></p>
        <iframe src={qs(t.kind)} title={`${t.label} preview`} class="mt-2 h-[720px] w-full rounded-card border border-border bg-surface" loading="lazy"></iframe>
      </section>
    ))}
  </div>
</Manager>
