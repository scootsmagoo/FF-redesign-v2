---
import { actions } from 'astro:actions';
import Manager from '~/layouts/Manager.astro';
import Field from '~/components/manager/Field.astro';
import RichText from '~/components/manager/RichText.astro';
import { getAffiliate } from '~/lib/manager/marketing';
import { can } from '~/lib/manager/permissions';

const writable = can(Astro.locals.admin, 'Affiliates', 1);
const isNew = Astro.params.id === 'new';
const id = isNew ? 0 : Number(Astro.params.id);
if (isNew && !writable) return Astro.redirect('/manager/affiliates', 302);
const saved = Astro.getActionResult(actions.manager.saveAffiliate);
if (saved && !saved.error) return Astro.redirect(`/manager/affiliates/${saved.data.id}?saved=1`, 303);
const detail = isNew ? null : await getAffiliate(id);
if (!isNew && !detail) return new Response(null, { status: 404 });
const a = detail?.affiliate ?? null;
---

<Manager title={a ? `Affiliate · ${a.name}` : 'New Affiliate'} current="/manager/affiliates">
  <a href="/manager/affiliates" class="text-sm">← Affiliates</a>
  <h1 class="mt-1 text-2xl font-bold text-brand-blue">{a ? a.name : 'New Affiliate'}</h1>
  {a && <p class="mt-1 text-sm text-ink/70"><a href={`/aff/${a.slug}`} target="_blank" rel="noopener">/aff/{a.slug}</a> · the slug is fixed once created; add a redirect to rename.</p>}
  {Astro.url.searchParams.get('saved') && <p class="mt-3 rounded-btn bg-brand-blue-tint p-3 text-sm">Saved.</p>}
  {saved?.error && <p class="mt-3 rounded-btn bg-red-50 p-3 text-sm text-danger">{saved.error.message}</p>}
  <form method="POST" action={actions.manager.saveAffiliate} class="mt-4 max-w-4xl space-y-4">
    <input type="hidden" name="affiliateId" value={id} />
    <div class="grid gap-4 md:grid-cols-3">
      <Field name="name" label="Name" value={a?.name} required readonly={!writable} />
      <Field name="slug" label="Page slug (/aff/…)" value={a?.slug} readonly={!writable || Boolean(a)} help={a ? 'Fixed' : 'Blank = from the name'} />
      <Field name="discountPercent" label="Discount %" type="number" step="0.01" min="0" max="100" value={a?.discountPercent ?? 0} readonly={!writable} />
      <Field name="imageUrl" label="Banner image URL" value={a?.imageUrl} readonly={!writable} class="md:col-span-2" />
      <Field name="active" label="Active" type="checkbox" value={a ? a.active : true} readonly={!writable} class="pt-6" />
    </div>
    <RichText name="contentHtml" label="Page content" value={a?.contentHtml} rows={8} />
    <div class="grid gap-4 md:grid-cols-2">
      <Field name="productIds" label="Featured product ids (comma separated)" value={detail?.products.map((p) => p.id).join(', ') ?? ''} readonly={!writable} help={detail?.products.map((p) => p.sku).join(', ')} />
      <Field name="categoryIds" label="Featured category ids (comma separated)" value={detail?.categories.map((c) => c.id).join(', ') ?? ''} readonly={!writable} help={detail?.categories.map((c) => c.name).join(', ')} />
    </div>
    {writable && <button class="btn-primary">{isNew ? 'Create Affiliate' : 'Save Affiliate'}</button>}
  </form>
</Manager>
