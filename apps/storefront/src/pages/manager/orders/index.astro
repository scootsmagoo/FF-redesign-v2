---
import Manager from '~/layouts/Manager.astro';
import { formatMoney } from '@ff/domain/pricing';
import { listOrdersAdmin, ORDER_STATUSES } from '~/lib/admin';

const q = Astro.url.searchParams.get('q') ?? '';
const status = Astro.url.searchParams.get('status') ?? '';
const page = Number(Astro.url.searchParams.get('page') ?? '1') || 1;
const result = await listOrdersAdmin({ q, status, page });
const pages = Math.max(1, Math.ceil(result.total / result.pageSize));
const link = (p: number) => `/manager/orders?${new URLSearchParams({ q, status, page: String(p) })}`;
---

<Manager title="Orders" current="/manager/orders">
  <h1 class="text-2xl font-bold text-brand-blue">Orders</h1>
  <form method="get" class="mt-4 flex flex-wrap items-end gap-3">
    <label class="block text-sm">Search
      <input name="q" value={q} placeholder="Order number or email" class="mt-1 w-64 rounded-btn border border-gray-300 px-3 py-2" />
    </label>
    <label class="block text-sm">Status
      <select name="status" class="mt-1 rounded-btn border border-gray-300 px-3 py-2">
        <option value="">Any</option>
        {ORDER_STATUSES.map((s) => <option value={s} selected={s === status} class="capitalize">{s}</option>)}
      </select>
    </label>
    <button class="btn-secondary !min-h-10 !py-2">Filter</button>
    <span class="text-sm text-ink/70">{result.total.toLocaleString('en-US')} order{result.total === 1 ? '' : 's'}</span>
  </form>

  <div class="mt-4 overflow-x-auto rounded-card border border-border">
    <table class="w-full text-sm">
      <thead class="bg-surface-alt text-left"><tr><th class="p-3">Order</th><th class="p-3">Placed</th><th class="p-3">Email</th><th class="p-3">Status</th><th class="p-3">Items</th><th class="p-3 text-right">Total</th></tr></thead>
      <tbody class="divide-y divide-border">
        {result.rows.length === 0 && <tr><td class="p-3" colspan="6">No orders match.</td></tr>}
        {result.rows.map((o) => (
          <tr>
            <td class="p-3 font-semibold"><a href={`/manager/orders/${encodeURIComponent(o.number)}`}>{o.number}</a></td>
            <td class="p-3 whitespace-nowrap">{o.placedAt.slice(0, 16).replace('T', ' ')}</td>
            <td class="p-3">{o.customerId ? <a href={`/manager/customers/${o.customerId}`}>{o.email}</a> : o.email}</td>
            <td class="p-3 capitalize">{o.status}</td>
            <td class="p-3">{o.itemCount}</td>
            <td class="p-3 text-right">{formatMoney(o.totalCents)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {pages > 1 && (
    <nav class="mt-4 flex items-center gap-3 text-sm" aria-label="Pagination">
      {page > 1 && <a href={link(page - 1)}>← Newer</a>}
      <span>Page {page} of {pages}</span>
      {page < pages && <a href={link(page + 1)}>Older →</a>}
    </nav>
  )}
</Manager>
