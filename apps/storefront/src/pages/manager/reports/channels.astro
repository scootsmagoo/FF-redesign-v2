---
import Manager from '~/layouts/Manager.astro';
import { formatMoney } from '@ff/domain/pricing';
import { channelProfit } from '~/lib/manager/reports';

const days = [7, 14, 21, 30, 90].includes(Number(Astro.url.searchParams.get('days'))) ? Number(Astro.url.searchParams.get('days')) : 21;
const rows = await channelProfit(days);
const label: Record<string, string> = { filtersfast: 'FiltersFast.com', ordergroove: 'Subscriptions (Ordergroove)', amazon: 'Amazon', walmart: 'Walmart', ebay: 'eBay' };
const sum = rows.reduce((a, r) => ({ qty: a.qty + r.qty, revenueCents: a.revenueCents + r.revenueCents, costCents: a.costCents + r.costCents, orders: a.orders + r.orders }), { qty: 0, revenueCents: 0, costCents: 0, orders: 0 });
const margin = (rev: number, cost: number) => (rev ? `${(((rev - cost) / rev) * 100).toFixed(1)}%` : '—');
---

<Manager title="Channel profit" current="/manager/reports">
  <a href="/manager/reports" class="text-sm">← Reports</a>
  <h1 class="mt-1 text-2xl font-bold text-brand-blue">Channel Profit · last {days} days</h1>
  <p class="mt-1 text-sm text-ink/70">Units, item revenue after discounts, cost of goods (the product's cost, else its paired parent's) and margin per order source (legacy SA_stats_google, generalised). Products without a cost count as zero cost.</p>
  <form method="get" class="mt-3 flex flex-wrap items-end gap-2 text-sm">
    <label class="block">Days<select name="days" class="mt-1 block rounded-btn border border-input px-3 py-2">{[7, 14, 21, 30, 90].map((d) => <option value={d} selected={d === days}>{d}</option>)}</select></label>
    <button class="btn-secondary !min-h-10 !py-2">Show</button>
  </form>
  <div class="mt-4 overflow-x-auto rounded-card border border-border bg-surface">
    <table class="w-full text-sm">
      <thead class="bg-surface-alt text-left"><tr><th class="p-2">Source</th><th class="p-2 text-right">Orders</th><th class="p-2 text-right">Units</th><th class="p-2 text-right">Revenue</th><th class="p-2 text-right">Cost of goods</th><th class="p-2 text-right">Profit</th><th class="p-2 text-right">Margin</th></tr></thead>
      <tbody class="divide-y divide-border">
        {rows.length === 0 && <tr><td class="p-2" colspan="7">No paid orders in this period.</td></tr>}
        {rows.map((r) => <tr><td class="p-2 font-semibold">{label[r.source] ?? r.source}</td><td class="p-2 text-right">{r.orders}</td><td class="p-2 text-right">{r.qty}</td><td class="p-2 text-right">{formatMoney(r.revenueCents)}</td><td class="p-2 text-right">{formatMoney(r.costCents)}</td><td class="p-2 text-right">{formatMoney(r.revenueCents - r.costCents)}</td><td class="p-2 text-right">{margin(r.revenueCents, r.costCents)}</td></tr>)}
        {rows.length > 0 && <tr class="bg-surface-alt font-semibold"><td class="p-2">Total</td><td class="p-2 text-right">{sum.orders}</td><td class="p-2 text-right">{sum.qty}</td><td class="p-2 text-right">{formatMoney(sum.revenueCents)}</td><td class="p-2 text-right">{formatMoney(sum.costCents)}</td><td class="p-2 text-right">{formatMoney(sum.revenueCents - sum.costCents)}</td><td class="p-2 text-right">{margin(sum.revenueCents, sum.costCents)}</td></tr>}
      </tbody>
    </table>
  </div>
</Manager>
