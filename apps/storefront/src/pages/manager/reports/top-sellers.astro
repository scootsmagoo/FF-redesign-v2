---
import Manager from '~/layouts/Manager.astro';
import { topSellers } from '~/lib/manager/reports';

const days = [7, 14, 30].includes(Number(Astro.url.searchParams.get('days'))) ? Number(Astro.url.searchParams.get('days')) : 7;
const rows = (await topSellers(days)).map((r) => ({ ...r, oos: r.stock !== null && r.stock !== undefined && r.stock < 1 && !r.ignoreStock }));
const out = rows.filter((r) => r.oos).length;
---

<Manager title="Top sellers" current="/manager/reports">
  <a href="/manager/reports" class="text-sm">← Reports</a>
  <h1 class="mt-1 text-2xl font-bold text-brand-blue">Top Sellers · last {days} days</h1>
  <p class="mt-1 text-sm text-ink/70">Up to 350 SKU / option combinations by units sold, with current stock so buyers can see what is running out (legacy top300).</p>
  <form method="get" class="mt-3 flex flex-wrap items-end gap-2 text-sm">
    <label class="block">Days<select name="days" class="mt-1 block rounded-btn border border-input px-3 py-2">{[7, 14, 30].map((d) => <option value={d} selected={d === days}>{d}</option>)}</select></label>
    <button class="btn-secondary !min-h-10 !py-2">Show</button>
    <span class="text-ink/60">{rows.length} rows · {out} out of stock</span>
  </form>
  <div class="mt-4 overflow-x-auto rounded-card border border-border bg-surface">
    <table class="w-full text-sm">
      <thead class="bg-surface-alt text-left"><tr><th class="p-2">#</th><th class="p-2">SKU</th><th class="p-2">Option</th><th class="p-2">Product</th><th class="p-2 text-right">Units</th><th class="p-2 text-right">Orders</th><th class="p-2 text-right">Stock</th><th class="p-2">Flag</th></tr></thead>
      <tbody class="divide-y divide-border">
        {rows.length === 0 && <tr><td class="p-2" colspan="8">Nothing sold.</td></tr>}
        {rows.map((r, i) => (
          <tr class={r.oos ? 'bg-danger-tint' : ''}><td class="p-2 text-ink/50">{i + 1}</td><td class="p-2 font-mono text-xs">{r.productId ? <a href={`/manager/products/${r.productId}`}>{r.sku}</a> : r.sku}</td><td class="p-2">{r.optionLabel ?? ''}</td><td class="p-2">{r.name}</td><td class="p-2 text-right font-semibold">{r.qty}</td><td class="p-2 text-right">{r.orders}</td><td class="p-2 text-right">{r.stock ?? '—'}{r.ignoreStock ? '*' : ''}</td><td class="p-2 text-xs">{r.active === false ? 'inactive' : r.oos ? 'OUT OF STOCK' : ''}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-2 text-xs text-ink/60">* stock ignored (always sellable)</p>
</Manager>
