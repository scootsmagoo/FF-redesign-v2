---
import Manager from '~/layouts/Manager.astro';
import { can } from '~/lib/manager/permissions';
import { PURCHASER_STATUSES, purchasers } from '~/lib/manager/reports';
import { fmtDate } from '~/lib/manager/util';

const admin = Astro.locals.admin;
if (!can(admin, 'Products') || !can(admin, 'Promotions')) return Astro.redirect('/manager?denied=Purchaser export (Products and Promotions)', 302);
const sp = Astro.url.searchParams;
const skus = (sp.get('skus') ?? '').split(/[\s,;]+/).filter(Boolean);
const chosen = sp.getAll('status');
const statuses = chosen.length ? chosen : ['paid', 'processing', 'shipped', 'complete'];
const since = [30, 365, 1460].includes(Number(sp.get('since'))) ? Number(sp.get('since')) : null;
const rows = skus.length ? await purchasers(skus, statuses, since) : [];
const query = `skus=${encodeURIComponent(skus.join(','))}${statuses.map((s) => `&status=${s}`).join('')}${since ? `&since=${since}` : ''}`;
---

<Manager title="Purchaser export" current="/manager/reports">
  <a href="/manager/reports" class="text-sm">← Reports</a>
  <h1 class="mt-1 text-2xl font-bold text-brand-blue">Purchaser Export</h1>
  <p class="mt-1 text-sm text-ink/70">Distinct customers who bought the given SKUs, for recall notices and targeted mailings (legacy sa_purchaser_export). Staff addresses are excluded.</p>
  <form method="get" class="mt-3 space-y-2 text-sm">
    <label class="block">SKUs (comma or line separated)<textarea name="skus" rows="2" class="mt-1 block w-full max-w-xl rounded-btn border border-input px-3 py-2">{skus.join(', ')}</textarea></label>
    <div class="flex flex-wrap gap-x-4 gap-y-1">{PURCHASER_STATUSES.map((s) => <label class="flex items-center gap-1"><input type="checkbox" name="status" value={s} checked={statuses.includes(s)} /> {s}</label>)}</div>
    <div class="flex flex-wrap items-end gap-2">
      <label class="block">Timeframe<select name="since" class="mt-1 block rounded-btn border border-input px-3 py-2"><option value="" selected={!since}>All time</option><option value="1460" selected={since === 1460}>Last 4 years</option><option value="365" selected={since === 365}>Last year</option><option value="30" selected={since === 30}>Last month</option></select></label>
      <button class="btn-secondary !min-h-10 !py-2">Search</button>
      {rows.length > 0 && <a href={`/manager/reports/purchasers.csv?${query}`} class="btn-secondary !min-h-10 !py-2">Download CSV</a>}
      {skus.length > 0 && <span class="text-ink/60">{rows.length} purchasers</span>}
    </div>
  </form>
  <div class="mt-4 overflow-x-auto rounded-card border border-border bg-surface">
    <table class="w-full text-sm">
      <thead class="bg-surface-alt text-left"><tr><th class="p-2">Customer</th><th class="p-2">First</th><th class="p-2">Last</th><th class="p-2">Email</th><th class="p-2">SKU</th><th class="p-2 text-right">Orders</th><th class="p-2">Last order</th></tr></thead>
      <tbody class="divide-y divide-border">
        {skus.length === 0 && <tr><td class="p-2" colspan="7">Enter one or more SKUs.</td></tr>}
        {skus.length > 0 && rows.length === 0 && <tr><td class="p-2" colspan="7">No purchasers match.</td></tr>}
        {rows.map((r) => <tr><td class="p-2">{r.customerId ? <a href={`/manager/customers/${r.customerId}`}>CID-{r.customerId}</a> : 'guest'}</td><td class="p-2">{r.firstName}</td><td class="p-2">{r.lastName}</td><td class="p-2">{r.email}</td><td class="p-2 font-mono text-xs">{r.sku}</td><td class="p-2 text-right">{r.orders}</td><td class="p-2">{fmtDate(r.lastOrder)}</td></tr>)}
      </tbody>
    </table>
  </div>
</Manager>
