---
import Manager from '~/layouts/Manager.astro';
import { formatMoney } from '@ff/domain/pricing';
import { denyUnless } from '~/lib/manager/permissions';
import { totalSalesByMonth } from '~/lib/manager/reports';

const denied = denyUnless(Astro.locals, 'Statistics', 1);
if (denied) return denied;
const sp = Astro.url.searchParams;
const subscriptionOnly = sp.get('subscription') === '1';
const years = [1, 2, 3, 5, 10].includes(Number(sp.get('years'))) ? Number(sp.get('years')) : 3;
const rows = await totalSalesByMonth({ subscriptionOnly, years });
const byYear = new Map<string, { orders: number; netCents: number; grossCents: number }>();
for (const r of rows) {
  const y = r.month.slice(0, 4);
  const t = byYear.get(y) ?? { orders: 0, netCents: 0, grossCents: 0 };
  byYear.set(y, { orders: t.orders + r.orders, netCents: t.netCents + r.netCents, grossCents: t.grossCents + r.grossCents });
}
---

<Manager title="Total sales" current="/manager/reports">
  <a href="/manager/reports" class="text-sm">← Reports</a>
  <h1 class="mt-1 text-2xl font-bold text-brand-blue">Total Sales by Month</h1>
  <p class="mt-1 text-sm text-ink/70">Paid, shipped, complete and refunded orders; net = total minus collected tax (legacy SA_totalsales / SA_totalsubscription).</p>
  <form method="get" class="mt-3 flex flex-wrap items-end gap-2 text-sm">
    <label class="block">Years<select name="years" class="mt-1 block rounded-btn border border-input px-3 py-2">{[1, 2, 3, 5, 10].map((y) => <option value={y} selected={y === years}>{y}</option>)}</select></label>
    <label class="flex items-center gap-2 pb-2"><input type="checkbox" name="subscription" value="1" checked={subscriptionOnly} /> Subscription (Ordergroove) orders only</label>
    <button class="btn-secondary !min-h-10 !py-2">Show</button>
  </form>
  <div class="mt-4 grid gap-6 lg:grid-cols-[1fr_320px]">
    <div class="overflow-x-auto rounded-card border border-border bg-surface">
      <table class="w-full text-sm">
        <thead class="bg-surface-alt text-left"><tr><th class="p-2">Month</th><th class="p-2 text-right">Orders</th><th class="p-2 text-right">Net of tax</th><th class="p-2 text-right">Tax</th><th class="p-2 text-right">Shipping</th><th class="p-2 text-right">Discounts</th><th class="p-2 text-right">Gross</th><th class="p-2 text-right">AOV</th></tr></thead>
        <tbody class="divide-y divide-border">
          {rows.length === 0 && <tr><td class="p-2" colspan="8">No orders.</td></tr>}
          {rows.map((r) => <tr><td class="p-2 font-mono text-xs">{r.month}</td><td class="p-2 text-right">{r.orders}</td><td class="p-2 text-right font-semibold">{formatMoney(r.netCents)}</td><td class="p-2 text-right">{formatMoney(r.taxCents)}</td><td class="p-2 text-right">{formatMoney(r.shippingCents)}</td><td class="p-2 text-right">{formatMoney(r.discountCents)}</td><td class="p-2 text-right">{formatMoney(r.grossCents)}</td><td class="p-2 text-right">{formatMoney(r.orders ? Math.round(r.grossCents / r.orders) : 0)}</td></tr>)}
        </tbody>
      </table>
    </div>
    <div class="overflow-x-auto rounded-card border border-border bg-surface self-start">
      <table class="w-full text-sm">
        <thead class="bg-surface-alt text-left"><tr><th class="p-2">Year</th><th class="p-2 text-right">Orders</th><th class="p-2 text-right">Net</th></tr></thead>
        <tbody class="divide-y divide-border">{[...byYear.entries()].map(([y, t]) => <tr><td class="p-2 font-mono text-xs">{y}</td><td class="p-2 text-right">{t.orders}</td><td class="p-2 text-right font-semibold">{formatMoney(t.netCents)}</td></tr>)}</tbody>
      </table>
    </div>
  </div>
</Manager>
