---
import { actions } from 'astro:actions';
import Manager from '~/layouts/Manager.astro';
import { AREA_NAMES, denyUnless, isSiteAdmin } from '~/lib/manager/permissions';
import { ensureSiteAdminRole, listRoles } from '~/lib/manager-auth';

const denied = denyUnless(Astro.locals, 'Admins', 0);
if (denied) return denied;
const me = Astro.locals.admin!;
const deleted = Astro.getActionResult(actions.manager.deleteRole);
if (deleted && !deleted.error) return Astro.redirect('/manager/roles', 303);
await ensureSiteAdminRole();
const roles = await listRoles();
const summary = (p: Record<string, number>) => {
  const full = Object.values(p).filter((l) => l === 1).length;
  const ro = Object.values(p).filter((l) => l === 0).length;
  const r = Object.values(p).filter((l) => l === 2).length;
  return `${full} full · ${ro} read-only · ${r} restricted of ${AREA_NAMES.length}`;
};
---

<Manager title="Roles" current="/manager/roles">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-2xl font-bold text-brand-blue">Roles</h1>
    {isSiteAdmin(me) && <a href="/manager/roles/new" class="btn-primary !min-h-10 !py-2 text-sm">Add Role</a>}
  </div>
  <p class="mt-1 text-sm text-ink/70">A role sets the default level for every area (no access, read-only, full control, restricted). Only Site Administrators can change roles.</p>
  {deleted?.error && <p class="mt-3 rounded-btn bg-red-50 p-3 text-sm text-danger">{deleted.error.message}</p>}
  <div class="mt-4 overflow-x-auto rounded-card border border-border">
    <table class="w-full text-sm">
      <thead class="bg-surface-alt text-left"><tr><th class="p-3">Role</th><th class="p-3">Access</th><th class="p-3">Members</th><th class="p-3"></th></tr></thead>
      <tbody class="divide-y divide-border">
        {roles.map((r) => (
          <tr>
            <td class="p-3 font-semibold"><a href={`/manager/roles/${r.id}`}>{r.name}</a></td>
            <td class="p-3">{summary(r.permissions)}</td>
            <td class="p-3">{r.members}</td>
            <td class="p-3 text-right">
              {isSiteAdmin(me) && r.members === 0 && r.name !== 'Site Administrator' && (
                <form method="POST" action={actions.manager.deleteRole}><input type="hidden" name="roleId" value={r.id} /><button class="btn-secondary !min-h-8 !px-3 !py-1 text-xs">Delete</button></form>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Manager>
