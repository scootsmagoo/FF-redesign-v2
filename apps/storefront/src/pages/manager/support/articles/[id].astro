---
import { actions } from 'astro:actions';
import Manager from '~/layouts/Manager.astro';
import Field from '~/components/manager/Field.astro';
import RichText from '~/components/manager/RichText.astro';
import { getSupportArticleAdmin, listSupportCategoriesAdmin } from '~/lib/manager/support';
import { can } from '~/lib/manager/permissions';

const writable = can(Astro.locals.admin, 'Support', 1);
const isNew = Astro.params.id === 'new';
const id = isNew ? 0 : Number(Astro.params.id);
if (isNew && !writable) return Astro.redirect('/manager/support?view=articles', 302);
const saved = Astro.getActionResult(actions.manager.saveSupportArticle);
if (saved && !saved.error) return Astro.redirect(`/manager/support/articles/${saved.data.id}?saved=1`, 303);
const [detail, cats] = await Promise.all([isNew ? null : getSupportArticleAdmin(id), listSupportCategoriesAdmin()]);
if (!isNew && !detail) return new Response(null, { status: 404 });
const a = detail?.article ?? null;
const chosen = new Set(detail?.categoryIds ?? []);
const primary = cats.find((c) => chosen.has(c.id));
const primarySlug = primary?.slug ?? 'articles';
---

<Manager title={a ? `Article · ${a.title}` : 'New Support Article'} current="/manager/support">
  <a href="/manager/support?view=articles" class="text-sm">← Articles</a>
  <h1 class="mt-1 text-2xl font-bold text-brand-blue">{a ? a.title : 'New Support Article'}</h1>
  {a && <p class="mt-1 text-sm text-ink/70"><a href={`/support/${primarySlug}/${a.slug}`} target="_blank" rel="noopener">/support/{primarySlug}/{a.slug}</a></p>}
  {Astro.url.searchParams.get('saved') && <p class="mt-3 rounded-btn bg-brand-blue-tint p-3 text-sm">Saved.</p>}
  {saved?.error && <p class="mt-3 rounded-btn bg-red-50 p-3 text-sm text-danger">{saved.error.message}</p>}

  <form method="POST" action={actions.manager.saveSupportArticle} class="mt-4 max-w-4xl space-y-4">
    <input type="hidden" name="articleId" value={id} />
    <div class="grid gap-4 md:grid-cols-2">
      <Field name="title" label="Title" value={a?.title} required readonly={!writable} />
      <Field name="slug" label="URL slug" value={a?.slug} readonly={!writable} help={a ? 'Blank keeps the current slug (legacy regenerated it on every save and broke links)' : 'Blank = from the title'} />
    </div>
    <RichText name="contentHtml" label="Content" value={a?.contentHtml} rows={14} />
    <Field name="keywords" label="Search keywords" type="textarea" rows={2} value={a?.keywords} readonly={!writable} help="Lower-cased, space separated; used by portal search and chat suggestions." />
    <fieldset class="rounded-card border border-border p-3 text-sm">
      <legend class="px-1 font-medium">Categories</legend>
      <input type="hidden" name="categoryIds" id="cat-ids" value={[...chosen].join(',')} />
      <div class="grid gap-1 sm:grid-cols-2 md:grid-cols-3">
        {cats.map((c) => <label class="flex items-center gap-2"><input type="checkbox" class="cat-pick" value={c.id} checked={chosen.has(c.id)} disabled={!writable} /> {c.name}{!c.active ? <span class="text-xs text-ink/50">(inactive)</span> : null}</label>)}
      </div>
      <script>
        const picks = document.querySelectorAll<HTMLInputElement>('.cat-pick');
        const out = document.getElementById('cat-ids') as HTMLInputElement;
        picks.forEach((p) => p.addEventListener('change', () => (out.value = [...picks].filter((x) => x.checked).map((x) => x.value).join(','))));
      </script>
    </fieldset>
    <div class="grid gap-4 md:grid-cols-3">
      <Field name="isFaq" label="Promote as FAQ on the support home page" type="checkbox" value={a?.isFaq ?? false} readonly={!writable} class="pt-6" />
      <Field name="faqOrder" label="FAQ position" type="number" min="1" value={a?.faqOrder} readonly={!writable} help="Only used when promoted" />
    </div>
    {writable && <button class="btn-primary">{isNew ? 'Create Article' : 'Save Article'}</button>}
  </form>
  {writable && a && <form method="POST" action={actions.manager.deleteSupportArticle} class="mt-6" onsubmit="return confirm('Delete this article?')"><input type="hidden" name="articleId" value={a.id} /><button class="text-sm text-danger">Delete article</button></form>}
</Manager>
