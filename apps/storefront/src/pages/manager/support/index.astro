---
import { actions } from 'astro:actions';
import Manager from '~/layouts/Manager.astro';
import { listSupportArticlesAdmin, listSupportCategoriesAdmin } from '~/lib/manager/support';
import { can } from '~/lib/manager/permissions';

const writable = can(Astro.locals.admin, 'Support', 1);
const sp = Astro.url.searchParams;
const view = sp.get('view') === 'articles' ? 'articles' : sp.get('view') === 'faqs' ? 'faqs' : 'categories';
const q = sp.get('q') ?? '';
const rs = [actions.manager.reorderSupportCategories, actions.manager.deleteSupportCategory, actions.manager.deleteSupportArticle, actions.manager.setArticleFaq].map((a) => Astro.getActionResult(a));
if (rs.some((r) => r && !r.error)) return Astro.redirect(`/manager/support?view=${view}&saved=1`, 303);
const error = rs.find((r) => r?.error)?.error?.message;
const [cats, articles] = await Promise.all([listSupportCategoriesAdmin(), listSupportArticlesAdmin(q)]);
const faqArticles = articles.filter((a) => a.isFaq).sort((a, b) => (a.faqOrder ?? 999) - (b.faqOrder ?? 999));
---

<Manager title="Support Center" current="/manager/support">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-2xl font-bold text-brand-blue">Support Center</h1>
    <div class="flex gap-3 text-sm">{writable && <a href="/manager/support/categories/new">Add category</a>}{writable && <a href="/manager/support/articles/new" class="btn-primary !min-h-9 !px-4 !py-1.5 text-sm">New Article</a>}<a href="/support" target="_blank" rel="noopener">View portal</a></div>
  </div>
  <nav class="mt-3 flex gap-2 text-sm">
    {[['categories', 'Categories'], ['articles', 'Articles'], ['faqs', 'Promoted FAQs']].map(([v, l]) => <a href={`/manager/support?view=${v}`} class:list={['rounded-btn px-3 py-1', view === v ? 'bg-brand-blue text-white hover:text-white' : 'bg-surface-alt']}>{l}</a>)}
  </nav>
  {sp.get('saved') && <p class="mt-3 rounded-btn bg-brand-blue-tint p-3 text-sm">Saved.</p>}
  {error && <p class="mt-3 rounded-btn bg-danger-tint p-3 text-sm text-danger">{error}</p>}

  {view === 'categories' && (
    <div class="mt-4">
      <form method="POST" action={actions.manager.reorderSupportCategories} id="cat-order"><input type="hidden" name="order" id="cat-order-field" /></form>
      <ol class="divide-y divide-border rounded-card border border-border text-sm" id="cat-list">
        {cats.map((c) => (
          <li class="flex flex-wrap items-center gap-3 p-3" data-id={c.id} draggable={writable}>
            {writable && <span class="cursor-grab text-ink/40" title="drag to reorder">⋮⋮</span>}
            <a href={`/manager/support/categories/${c.id}`} class={c.active ? 'font-semibold' : 'text-ink/50'}>{c.name}</a>
            <span class="text-xs text-ink/60">/support/{c.slug} · {c.articleCount} articles{!c.active ? ' · inactive' : !c.visible ? ' · hidden' : ''}{c.includeInChat ? '' : ' · excluded from chat'}</span>
            {writable && c.articleCount === 0 && <form method="POST" action={actions.manager.deleteSupportCategory} class="ml-auto"><input type="hidden" name="categoryId" value={c.id} /><button class="text-xs text-danger">delete</button></form>}
          </li>
        ))}
      </ol>
      {writable && cats.length > 1 && <p class="mt-2 text-xs text-ink/60">Drag rows to reorder, then <button form="cat-order" class="underline" id="save-order">save the order</button>.</p>}
      <script>
        const list = document.getElementById('cat-list');
        let dragging: HTMLElement | null = null;
        list?.querySelectorAll<HTMLElement>('li[draggable="true"]').forEach((li) => {
          li.addEventListener('dragstart', () => (dragging = li));
          li.addEventListener('dragover', (e) => {
            e.preventDefault();
            if (dragging && dragging !== li) li.parentElement!.insertBefore(dragging, li);
          });
        });
        document.getElementById('save-order')?.addEventListener('click', () => {
          (document.getElementById('cat-order-field') as HTMLInputElement).value = [...list!.querySelectorAll<HTMLElement>('li')].map((l) => l.dataset.id).join(',');
        });
      </script>
    </div>
  )}

  {view === 'articles' && (
    <div class="mt-4">
      <form method="get" class="flex gap-2 text-sm"><input type="hidden" name="view" value="articles" /><input name="q" value={q} placeholder="title, keywords or content" class="w-72 rounded-btn border border-input px-3 py-2" /><button class="btn-secondary !min-h-10 !py-2">Search</button><span class="self-center text-ink/60">{articles.length} articles</span></form>
      <div class="mt-3 overflow-x-auto rounded-card border border-border">
        <table class="w-full text-sm">
          <thead class="bg-surface-alt text-left"><tr><th class="p-2">Title</th><th class="p-2">Category</th><th class="p-2">URL</th><th class="p-2">FAQ</th><th class="p-2"></th></tr></thead>
          <tbody class="divide-y divide-border">
            {articles.length === 0 && <tr><td class="p-2" colspan="5">No articles.</td></tr>}
            {articles.map((a) => (
              <tr>
                <td class="p-2 font-semibold"><a href={`/manager/support/articles/${a.id}`}>{a.title}</a></td>
                <td class="p-2">{a.categoryName ?? <span class="text-ink/50">[unassigned]</span>}</td>
                <td class="p-2 font-mono text-xs"><a href={`/support/${a.categorySlug ?? 'articles'}/${a.slug}`} target="_blank" rel="noopener">{a.slug}</a></td>
                <td class="p-2">{a.isFaq ? `#${a.faqOrder ?? ''}` : ''}</td>
                <td class="p-2 text-right text-xs whitespace-nowrap">{writable && <><form method="POST" action={actions.manager.setArticleFaq} class="inline"><input type="hidden" name="articleId" value={a.id} /><input type="hidden" name="isFaq" value={a.isFaq ? 'false' : 'true'} /><button>{a.isFaq ? 'remove FAQ' : 'add FAQ'}</button></form> <form method="POST" action={actions.manager.deleteSupportArticle} class="inline" onsubmit="return confirm('Delete this article?')"><input type="hidden" name="articleId" value={a.id} /><button class="ml-2 text-danger">delete</button></form></>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  {view === 'faqs' && (
    <div class="mt-4">
      <p class="text-sm text-ink/70">Articles promoted onto the support home page, in order.</p>
      <ol class="mt-2 divide-y divide-border rounded-card border border-border text-sm">
        {faqArticles.length === 0 && <li class="p-2 text-ink/60">None promoted.</li>}
        {faqArticles.map((a) => <li class="flex items-center gap-3 p-2"><span class="w-6 text-ink/50">{a.faqOrder}</span><a href={`/manager/support/articles/${a.id}`}>{a.title}</a>{writable && <form method="POST" action={actions.manager.setArticleFaq} class="ml-auto"><input type="hidden" name="articleId" value={a.id} /><input type="hidden" name="isFaq" value="false" /><button class="text-xs text-danger">remove</button></form>}</li>)}
      </ol>
    </div>
  )}
</Manager>
