---
import { actions } from 'astro:actions';
import Base from '~/layouts/Base.astro';
import { formatMoney, savingsPercent } from '@ff/domain/pricing';
import { getCompareView } from '~/lib/compare';

/** Side-by-side comparison of an OEM filter and its Filters Fast® compatible (legacy SxS pages). */
const addResult = Astro.getActionResult(actions.cart.add);
if (addResult && !addResult.error) return Astro.redirect('/cart', 303);

const view = await getCompareView(Astro.params.slug ?? '');
if (!view) return new Response(null, { status: 404 });
const { first, second, rows } = view;
const sides = [first, second];
const listable = (p: (typeof first)['product']) => p.active && !p.hidden && p.stock !== -250 && !p.blockedReason;
const cards = sides.map((s) => {
  const p = s.product;
  const inStock = p.stock > 0 || p.ignoreStock;
  const required = s.options.filter((g) => g.required);
  const defaultOption = p.compareDefaultOptionId && required.some((g) => g.options.some((o) => o.id === p.compareDefaultOptionId)) ? p.compareDefaultOptionId : null;
  const canAdd = listable(p) && inStock && (required.length === 0 || defaultOption !== null);
  const save = p.listPriceCents ? savingsPercent(p.listPriceCents, p.priceCents) : null;
  return { p, inStock, defaultOption, canAdd, save, reviews: s.detail.reviewCount, avg: s.detail.reviewAvg, needsPdp: listable(p) && inStock && !canAdd, frequency: p.recommendedFrequencyMonths };
});
const title = `${view.oem.name} vs ${view.compatible.name}`;
const description = `Compare the ${view.oem.brandName ?? ''} ${view.oem.sku} with the Filters Fast® compatible ${view.compatible.sku}: price, filter life, certifications and what each removes.`;
---

<Base title={title} description={description}>
  <div class="site-container py-8">
    <nav class="text-xs text-ink/60"><a href="/">Home</a> › <a href={`/p/${view.oem.slug}`}>{view.oem.name}</a> › Compare</nav>
    <h1 class="mt-2 text-2xl font-bold text-brand-blue md:text-3xl">Compare: {view.oem.name} vs. {view.compatible.name}</h1>
    <p class="mt-2 max-w-3xl text-sm text-ink/80">Both filters fit the same appliance. Here is how the original and the compatible replacement stack up{view.typeLabel ? ` (${view.typeLabel.toLowerCase()})` : ''}.</p>

    <div class="mt-6 overflow-x-auto rounded-card border border-border bg-white">
      <table class="w-full text-sm">
        <thead>
          <tr class="align-top">
            <th class="w-40 p-3 text-left text-xs uppercase tracking-wide text-ink/60"></th>
            {cards.map((c) => (
              <th class="p-3 text-left font-normal">
                <a href={`/p/${c.p.slug}`} class="block">
                  {(c.p.imageUrl ?? c.p.thumbUrl) && <img src={c.p.imageUrl ?? c.p.thumbUrl} alt={c.p.name} width="220" height="220" class="mx-auto h-40 w-40 object-contain" loading="lazy" />}
                  <span class="mt-2 block text-base font-bold text-ink-strong">{c.p.name}</span>
                </a>
                <span class="block text-xs text-ink/60">{c.p.brandName} · {c.p.sku}{c.p.privateLabel ? ' · Filters Fast® brand' : ''}</span>
                {c.reviews > 0 && c.avg && <span class="block text-xs text-ink/70">★ {c.avg.toFixed(1)} ({c.reviews} reviews)</span>}
              </th>
            ))}
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <tr>
            <th class="p-3 text-left font-medium">Price</th>
            {cards.map((c) => <td class="p-3">{c.p.hidePrice ? <a href={`/p/${c.p.slug}`}>See price</a> : <><span class="text-xl font-bold text-ink-strong">{formatMoney(c.p.priceCents)}</span>{c.p.listPriceCents && c.p.listPriceCents > c.p.priceCents ? <span class="ml-2 text-xs text-ink/60"><s>{formatMoney(c.p.listPriceCents)}</s>{c.save ? ` save ${c.save}%` : ''}</span> : null}{c.p.packQty > 1 ? <span class="block text-xs text-ink/60">{c.p.packQty}-pack · {formatMoney(Math.round(c.p.priceCents / c.p.packQty))} each</span> : null}</>}</td>)}
          </tr>
          <tr>
            <th class="p-3 text-left font-medium">Availability</th>
            {cards.map((c) => <td class="p-3">{!listable(c.p) ? <span class="text-ink/60">No longer available</span> : c.inStock ? <span class="font-semibold text-success">In stock</span> : <span class="text-danger">Out of stock</span>}{c.p.freeShipping ? <span class="block text-xs text-ink/60">Free shipping</span> : null}</td>)}
          </tr>
          {rows.map((r) => (
            <tr>
              <th class="p-3 text-left font-medium">{r.label}</th>
              {r.values.map((v) => <td class="p-3">{r.kind === 'bool' ? (v === 'yes' ? <span class="font-semibold text-success">✓ Yes</span> : <span class="text-ink/50">— No</span>) : v}</td>)}
            </tr>
          ))}
          {cards.some((c) => c.frequency) && (
            <tr><th class="p-3 text-left font-medium">Replace every</th>{cards.map((c) => <td class="p-3">{c.frequency ? `${c.frequency} months` : '—'}</td>)}</tr>
          )}
          <tr><th class="p-3 text-left font-medium">Made in the USA</th>{cards.map((c) => <td class="p-3">{c.p.madeInUsa ? <span class="font-semibold text-success">✓ Yes</span> : <span class="text-ink/50">—</span>}</td>)}</tr>
          <tr><th class="p-3 text-left font-medium">Returns</th>{cards.map((c) => <td class="p-3">{c.p.returnPolicyCode === 0 ? 'Free 365-day returns' : 'Final sale'}</td>)}</tr>
          <tr>
            <th class="p-3"></th>
            {cards.map((c) => (
              <td class="p-3">
                {c.canAdd ? (
                  <form method="POST" action={actions.cart.add}><input type="hidden" name="productId" value={c.p.id} /><input type="hidden" name="qty" value="1" />{c.defaultOption && <input type="hidden" name="optionId" value={c.defaultOption} />}<button class="btn-primary">Add to Cart</button></form>
                ) : (
                  <a href={`/p/${c.p.slug}`} class="btn-secondary">{c.needsPdp ? 'Choose options' : 'View product'}</a>
                )}
              </td>
            ))}
          </tr>
        </tbody>
      </table>
    </div>
    {addResult?.error && <p class="mt-3 rounded-btn bg-red-50 p-3 text-sm text-danger">{addResult.error.message}</p>}
    <p class="mt-6 text-xs text-ink/60">Filters Fast® compatible filters are made to fit and perform like the original; brand names are used for compatibility reference only and do not imply affiliation.</p>
  </div>
</Base>
