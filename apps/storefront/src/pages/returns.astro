---
import StaticPage from '~/layouts/StaticPage.astro';

const steps = [
  ['Sign in to My Account', 'Open the order you want to return.'],
  ['Click Return', 'Choose the items and the reason.'],
  ['Fill out the online form', 'Takes about a minute.'],
  ['Receive a prepaid label and ship', 'Prepaid labels are available within the contiguous US.'],
  ['Receive your refund', 'Refunds go back to the original payment method.'],
];
---

<StaticPage title="Returns" heading="Need to return an order?" intro="FiltersFast.com is happy to accept returns on items within 365 days of the original ship date. Follow these simple steps to start your return." description="FREE 365-day returns at FiltersFast.com. Sign in, click Return on your order, and ship it back with a prepaid label.">
  <ol class="grid gap-4 sm:grid-cols-2">
    {steps.map(([title, body], i) => (
      <li class="flex gap-4 rounded-card border border-border bg-white p-4">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-orange text-lg font-bold text-white" aria-hidden="true">{i + 1}</span>
        <div><p class="font-semibold text-ink-strong">{title}</p><p class="text-sm text-ink">{body}</p></div>
      </li>
    ))}
  </ol>
  <div class="mt-8 flex flex-wrap gap-3">
    <a href="/account/orders" class="btn-primary">Sign In to Return an Order</a>
    <a href="/track-order" class="btn-secondary">Look Up a Guest Order</a>
  </div>

  <h2 class="mt-12 text-2xl font-bold">Terms and conditions</h2>
  <ul class="mt-3 list-disc space-y-2 pl-6 text-ink">
    <li>FiltersFast.com will not issue refunds on products that were damaged during installation or because of incorrect installation.</li>
    <li>Original shipping costs are not refunded.</li>
    <li>Returns and refunds on custom air filters are not accepted.</li>
    <li>Prepaid return shipping labels are available for addresses within the contiguous US.</li>
  </ul>
  <p class="mt-6 text-sm text-ink">Read the complete <a href="/terms#returns-ref-policy">return and refund policy</a> in our Terms of Use. Questions? Email <a href="mailto:support@filtersfast.com">support@filtersfast.com</a> or call <a href="tel:8664383458">(866) 438-3458</a>.</p>
</StaticPage>
