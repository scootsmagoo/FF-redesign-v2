---
import { actions } from 'astro:actions';
import Base from '~/layouts/Base.astro';
import OrderDetail from '~/components/account/OrderDetail.astro';
import { getOrderForGuest } from '~/lib/account';

const reorder = Astro.getActionResult(actions.cart.reorder) ?? Astro.getActionResult(actions.cart.add);
if (reorder && !reorder.error) return Astro.redirect('/cart', 303);

const number = (Astro.url.searchParams.get('number') ?? '').trim();
const email = (Astro.url.searchParams.get('email') ?? '').trim();
const detail = number && email ? await getOrderForGuest(number, email) : null;
const notFound = Boolean(number && email && !detail);
---

<Base title="Track Your Order" noindex>
  <div class="site-container py-8">
    <h1 class="text-2xl font-bold text-brand-blue">Track Your Order</h1>
    <form method="get" class="mt-4 flex max-w-2xl flex-wrap items-end gap-3">
      <label class="block text-sm">Order number
        <input name="number" value={number} required class="mt-1 w-48 rounded-btn border border-gray-300 px-3 py-2" placeholder="FF… or legacy L…" />
      </label>
      <label class="block text-sm">Email used at checkout
        <input name="email" type="email" value={email} required class="mt-1 w-64 rounded-btn border border-gray-300 px-3 py-2" />
      </label>
      <button class="btn-primary">Find Order</button>
    </form>
    {notFound && <p class="mt-4 rounded-btn bg-red-50 p-3 text-sm text-danger">We couldn't find an order with that number and email. Check both and try again, or call (866) 438-3458.</p>}
    {detail && (
      <div class="mt-8">
        <h2 class="text-xl font-bold">Order {detail.order.number}</h2>
        {reorder?.error && <p class="mt-3 rounded-btn bg-red-50 p-3 text-sm text-danger">{reorder.error.message}</p>}
        <div class="mt-4"><OrderDetail detail={detail} /></div>
      </div>
    )}
    <p class="mt-8 text-sm">Have an account? <a href="/account/orders">See all your orders</a>.</p>
  </div>
</Base>
