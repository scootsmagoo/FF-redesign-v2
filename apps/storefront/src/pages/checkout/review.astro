---
import { actions } from 'astro:actions';
import Base from '~/layouts/Base.astro';
import OrderSummary from '~/components/checkout/OrderSummary.astro';
import Steps from '~/components/checkout/Steps.astro';
import { formatMoney } from '@ff/domain/pricing';
import { buildQuote } from '~/lib/checkout';

// Donation choice posts back to this page and re-renders; "Continue" is a plain link.
const donationResult = Astro.getActionResult(actions.checkout.setDonation);
if (donationResult && !donationResult.error) return Astro.redirect('/checkout/review', 303);

const quote = await buildQuote(Astro.session);
if (quote.cart.lines.length === 0) return Astro.redirect('/cart', 302);
if (!quote.state.shipping) return Astro.redirect('/checkout', 302);
if (!quote.selectedRate) return Astro.redirect('/checkout/shipping', 302);

const ship = quote.state.shipping;
const donation = quote.state.donation ?? 'none';
const presets = ['none', 'roundup', '100', '200', '500', '1000', 'custom'];
const label = (v: string) =>
  v === 'none' ? 'No donation' : v === 'roundup' ? 'Round up to the next dollar' : v === 'custom' ? 'Other amount' : formatMoney(Number(v));
const isCustom = !presets.includes(donation);
---

<Base title="Review Your Order" noindex>
  <div class="site-container py-6">
    <h1 class="text-2xl font-bold text-brand-blue">Checkout</h1>
    <div class="mt-3"><Steps current={3} /></div>

    <div class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,1fr)_360px]">
      <div class="space-y-6">
        <section class="grid gap-4 rounded-card border border-border p-4 text-sm sm:grid-cols-2">
          <div>
            <h2 class="font-bold">Shipping to</h2>
            <p>{ship.firstName} {ship.lastName}<br />{ship.line1}{ship.line2 ? `, ${ship.line2}` : ''}<br />{ship.city}, {ship.region} {ship.postalCode}</p>
            <a href="/checkout" class="text-xs">Edit</a>
          </div>
          <div>
            <h2 class="font-bold">Shipping method</h2>
            <p>{quote.selectedRate.label}<br /><span class="text-ink/70">{quote.selectedRate.carrier}</span></p>
            <a href="/checkout/shipping" class="text-xs">Change</a>
          </div>
        </section>

        <section class="rounded-card border border-border p-4">
          <h2 class="font-bold">Give back with your order</h2>
          <p class="mt-1 text-sm">Add a donation to <strong>Wine To Water</strong>, bringing clean water to communities in need.</p>
          <form method="POST" action={actions.checkout.setDonation} class="mt-3 flex flex-wrap items-center gap-2 text-sm">
            <select name="donation" class="rounded-btn border border-gray-300 px-2 py-1.5">
              {presets.map((v) => (
                <option value={v} selected={isCustom ? v === 'custom' : v === donation}>{label(v)}</option>
              ))}
            </select>
            <label class="flex items-center gap-1">$
              <input name="customCents" type="number" min="0" max="10000" step="1" value={isCustom ? Math.round(Number(donation) / 100) : ''} placeholder="0" class="w-20 rounded-btn border border-gray-300 px-2 py-1.5" aria-label="Custom donation in dollars" />
            </label>
            <button class="btn-secondary !min-h-9 !py-1 text-sm">Apply</button>
            {quote.donationCents > 0 && <span class="text-success">Thank you! {formatMoney(quote.donationCents)} added.</span>}
          </form>
          <p class="mt-2 text-xs text-ink/60">The custom amount is entered in whole dollars; it is converted to cents on save.</p>
        </section>

        <div class="flex flex-wrap gap-3">
          <a href="/checkout/shipping" class="btn-secondary">Back</a>
          <a href="/checkout/payment" class="btn-primary text-lg">Continue to Payment</a>
        </div>
      </div>

      <OrderSummary quote={quote} />
    </div>
  </div>
</Base>
