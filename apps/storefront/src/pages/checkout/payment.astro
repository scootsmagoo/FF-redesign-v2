---
import { actions } from 'astro:actions';
import Base from '~/layouts/Base.astro';
import OrderSummary from '~/components/checkout/OrderSummary.astro';
import Steps from '~/components/checkout/Steps.astro';
import { formatMoney } from '@ff/domain/pricing';
import { buildQuote } from '~/lib/checkout';
import { getProviders } from '~/lib/providers';

const result = Astro.getActionResult(actions.checkout.placeOrder);
if (result && !result.error && result.data) {
  return Astro.redirect(`/checkout/confirmation?n=${encodeURIComponent(result.data.number)}&k=${encodeURIComponent(result.data.accessKey)}`, 303);
}

const quote = await buildQuote(Astro.session);
if (quote.cart.lines.length === 0) return Astro.redirect('/cart', 302);
if (!quote.state.shipping) return Astro.redirect('/checkout', 302);
if (!quote.selectedRate) return Astro.redirect('/checkout/shipping', 302);

const providers = getProviders();
const payConfig = await providers.payment.clientConfig();
const isStub = payConfig.mode === 'stub';
const billing = quote.state.billingSameAsShipping === false && quote.state.billing ? quote.state.billing : quote.state.shipping;
---

<Base title="Payment" noindex>
  <div class="site-container py-6">
    <h1 class="text-2xl font-bold text-brand-blue">Checkout</h1>
    <div class="mt-3"><Steps current={4} /></div>

    <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_360px]">
      <div class="space-y-6">
        <section class="rounded-card border border-border p-4 text-sm">
          <h2 class="font-bold">Billing address</h2>
          <p>{billing.firstName} {billing.lastName}<br />{billing.line1}{billing.line2 ? `, ${billing.line2}` : ''}<br />{billing.city}, {billing.region} {billing.postalCode}</p>
          <a href="/checkout" class="text-xs">Edit</a>
        </section>

        <form method="POST" action={actions.checkout.placeOrder} class="rounded-card border border-border p-4" id="payForm">
          <h2 class="text-lg font-bold">Payment</h2>
          {result?.error && <p class="mt-2 rounded-btn bg-red-50 p-3 text-danger">{result.error.message}</p>}

          {isStub ? (
            <div class="mt-3 space-y-3 text-sm">
              <p class="rounded-btn bg-brand-blue-tint p-3">
                <strong>Test mode.</strong> No real gateway is connected. Any card details are accepted; enter <code>decline</code> in the card number field to simulate a decline.
              </p>
              <label class="block">Name on card
                <input name="cardName" autocomplete="cc-name" class="mt-1 w-full rounded-btn border border-gray-300 px-3 py-2" />
              </label>
              <label class="block">Card number
                <input id="cardNumber" inputmode="numeric" autocomplete="cc-number" placeholder="4111 1111 1111 1111" class="mt-1 w-full rounded-btn border border-gray-300 px-3 py-2" />
              </label>
              <div class="grid grid-cols-2 gap-3">
                <label class="block">Expiry
                  <input autocomplete="cc-exp" placeholder="MM/YY" class="mt-1 w-full rounded-btn border border-gray-300 px-3 py-2" />
                </label>
                <label class="block">CVV
                  <input autocomplete="cc-csc" inputmode="numeric" placeholder="123" class="mt-1 w-full rounded-btn border border-gray-300 px-3 py-2" />
                </label>
              </div>
              <!-- In production the tokenizer (CyberSource Microform) fills this; card data never posts to our server. -->
              <input type="hidden" name="paymentToken" id="paymentToken" value="stub_ok" />
              <input type="hidden" name="method" value="card" />
            </div>
          ) : (
            <div class="mt-3 text-sm">
              <p>Payment provider <strong>{providers.payment.name}</strong> is configured; its hosted fields mount here.</p>
              <div id="microform"></div>
              <input type="hidden" name="paymentToken" id="paymentToken" />
              <input type="hidden" name="method" value="card" />
            </div>
          )}

          <p class="mt-4 text-xs text-ink/70">By placing your order you agree to the Terms of Use. FREE 365-Day Returns on eligible items.</p>
          <button class="btn-primary mt-4 w-full text-lg">Place Order · {formatMoney(quote.totals.totalCents)}</button>
        </form>

        <a href="/checkout/review" class="btn-secondary">Back</a>
      </div>

      <OrderSummary quote={quote} />
    </div>
  </div>

  <script>
    // Stub tokenizer: mirrors what a real hosted-field SDK would do (produce a token, never post the PAN).
    const num = document.getElementById('cardNumber') as HTMLInputElement | null;
    const tok = document.getElementById('paymentToken') as HTMLInputElement | null;
    document.getElementById('payForm')?.addEventListener('submit', () => {
      if (num && tok) tok.value = /decline/i.test(num.value) ? 'decline_test' : `stub_${(num.value || '0000').replace(/\D/g, '').slice(-4)}`;
      if (num) num.value = '';
    });
  </script>
</Base>
