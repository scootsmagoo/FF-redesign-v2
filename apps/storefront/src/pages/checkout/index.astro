---
import { actions } from 'astro:actions';
import Base from '~/layouts/Base.astro';
import AddressFields from '~/components/checkout/AddressFields.astro';
import OrderSummary from '~/components/checkout/OrderSummary.astro';
import Steps from '~/components/checkout/Steps.astro';
import { buildQuote } from '~/lib/checkout';
import { getCustomer, listAddresses } from '~/lib/account';

const result = Astro.getActionResult(actions.checkout.saveAddresses);
if (result && !result.error) return Astro.redirect('/checkout/shipping', 303);

const quote = await buildQuote(Astro.session);
if (quote.cart.lines.length === 0) return Astro.redirect('/cart', 302);

let message: string | undefined;
let fields: Record<string, string> = {};
if (result?.error) {
  try {
    const parsed = JSON.parse(result.error.message) as { message: string; fields: Record<string, string> };
    message = parsed.message;
    fields = parsed.fields;
  } catch {
    message = result.error.message;
  }
}

// Fields re-fill from saved state; a failed submission re-renders with the error map.
const s = { ...quote.state };
// Signed-in customers get their email and default address pre-filled.
const me = Astro.locals.user;
if (me && !s.shipping) {
  const [customer, saved] = await Promise.all([me.customerId ? getCustomer(me.customerId) : null, me.customerId ? listAddresses(me.customerId) : []]);
  s.email ??= me.email;
  const d = saved.find((x) => x.isDefaultShipping) ?? saved[0];
  if (d) {
    s.shipping = { firstName: d.firstName ?? customer?.firstName ?? '', lastName: d.lastName ?? customer?.lastName ?? '', company: d.company ?? undefined, line1: d.line1, line2: d.line2 ?? undefined, city: d.city, region: d.region, postalCode: d.postalCode, country: d.country, phone: d.phone ?? customer?.phone ?? undefined };
  } else if (customer) {
    s.shipping = { firstName: customer.firstName ?? '', lastName: customer.lastName ?? '', line1: '', city: '', region: '', postalCode: '', country: 'US', phone: customer.phone ?? undefined };
  }
}
const shipVal = s.shipping ? { ...s.shipping } : {};
const billVal = s.billing ? { ...s.billing } : {};
const billingSame = s.billingSameAsShipping !== false;
---

<Base title="Checkout" noindex>
  <div class="site-container py-6">
    <h1 class="text-2xl font-bold text-brand-blue">Checkout</h1>
    <div class="mt-3"><Steps current={1} /></div>

    <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_360px]">
      <form method="POST" action={actions.checkout.saveAddresses} class="space-y-8" novalidate>
        {message && <p class="rounded-btn bg-red-50 p-3 text-danger">{message}</p>}

        {!me && (
          <p class="rounded-btn bg-surface-alt p-3 text-sm">Have an account? <a href="/account/login?next=/checkout">Sign in</a> to check out faster. No account is needed to continue.</p>
        )}
        <section>
          <h2 class="text-lg font-bold">Contact</h2>
          <label class="mt-2 block text-sm">Email address
            <input name="email" type="email" value={s.email ?? ''} autocomplete="email" required class:list={['mt-1 w-full rounded-btn border px-3 py-2', fields.email ? 'border-danger' : 'border-gray-300']} />
            {fields.email && <span class="text-xs text-danger">{fields.email}</span>}
          </label>
          <label class="mt-2 flex items-center gap-2 text-sm">
            <input type="checkbox" name="newsletter" value="true" checked={s.newsletter ?? true} /> Email me deals and filter-change reminders
          </label>
          <label class="mt-1 flex items-center gap-2 text-sm">
            <input type="checkbox" name="smsOptIn" value="true" checked={s.smsOptIn ?? false} /> Text me order updates
          </label>
        </section>

        <section>
          <h2 class="text-lg font-bold">Shipping Address</h2>
          <div class="mt-2"><AddressFields prefix="shipping" value={shipVal} errors={fields} /></div>
        </section>

        <section>
          <label class="flex items-center gap-2 text-sm font-semibold">
            <input type="checkbox" name="billingSame" value="true" checked={billingSame} id="billingSame" /> Billing address is the same as shipping
          </label>
          <div id="billingFields" class="mt-3" hidden={billingSame}>
            <h2 class="text-lg font-bold">Billing Address</h2>
            <div class="mt-2"><AddressFields prefix="billing" value={billVal} errors={fields} /></div>
          </div>
        </section>

        <label class="flex items-start gap-2 text-sm">
          <input type="checkbox" required class="mt-1" /> I agree to the <a href="/terms">Terms of Use</a> and <a href="/privacy">Privacy Policy</a>.
        </label>

        <button class="btn-primary text-lg">Continue to Shipping Method</button>
      </form>

      <OrderSummary quote={quote} showShipping={false} />
    </div>
  </div>

  <script>
    const cb = document.getElementById('billingSame') as HTMLInputElement | null;
    const box = document.getElementById('billingFields');
    cb?.addEventListener('change', () => { if (box) box.hidden = cb.checked; });
  </script>
</Base>
