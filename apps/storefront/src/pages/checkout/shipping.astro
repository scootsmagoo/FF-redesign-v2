---
import { actions } from 'astro:actions';
import Base from '~/layouts/Base.astro';
import OrderSummary from '~/components/checkout/OrderSummary.astro';
import Steps from '~/components/checkout/Steps.astro';
import { formatMoney } from '@ff/domain/pricing';
import { buildQuote } from '~/lib/checkout';

const result = Astro.getActionResult(actions.checkout.selectShipping);
if (result && !result.error) return Astro.redirect('/checkout/review', 303);

const quote = await buildQuote(Astro.session);
if (quote.cart.lines.length === 0) return Astro.redirect('/cart', 302);
if (!quote.state.shipping) return Astro.redirect('/checkout', 302);

const ship = quote.state.shipping;
const chosen = quote.state.shippingRateId ?? quote.rates.find((r) => r.available)?.id;
---

<Base title="Shipping Method" noindex>
  <div class="site-container py-6">
    <h1 class="text-2xl font-bold text-brand-blue">Checkout</h1>
    <div class="mt-3"><Steps current={2} /></div>

    <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_360px]">
      <div>
        <section class="rounded-card border border-border p-4 text-sm">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="font-bold">Shipping to</h2>
              <p>{ship.firstName} {ship.lastName}{ship.company ? `, ${ship.company}` : ''}<br />{ship.line1}{ship.line2 ? `, ${ship.line2}` : ''}<br />{ship.city}, {ship.region} {ship.postalCode} {ship.country}</p>
              <p class="text-ink/70">{quote.state.email}</p>
            </div>
            <a href="/checkout" class="text-sm">Edit</a>
          </div>
        </section>

        <form method="POST" action={actions.checkout.selectShipping} class="mt-6">
          <h2 class="text-lg font-bold">Shipping Method</h2>
          {result?.error && <p class="mt-2 text-danger">{result.error.message}</p>}
          <ul class="mt-3 space-y-2">
            {quote.rates.map((r) => (
              <li>
                <label class:list={['flex cursor-pointer items-center gap-3 rounded-card border p-3', r.available ? 'border-border' : 'border-border opacity-50']} title={r.available ? undefined : 'Not available for this address (PO Box / non-contiguous)'}>
                  <input type="radio" name="rateId" value={r.id} checked={r.id === chosen} disabled={!r.available} required />
                  <span class="flex-1">
                    <span class="font-semibold">{r.label}</span>
                    <span class="block text-xs text-ink/70">{r.carrier} · {r.minDays}-{r.maxDays} business days</span>
                  </span>
                  <span class:list={['font-semibold', r.priceCents === 0 && 'text-success']}>{r.priceCents === 0 ? 'FREE' : formatMoney(r.priceCents)}</span>
                </label>
              </li>
            ))}
          </ul>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/checkout" class="btn-secondary">Back</a>
            <button class="btn-primary text-lg">Continue to Review</button>
          </div>
        </form>
      </div>

      <OrderSummary quote={quote} />
    </div>
  </div>
</Base>
